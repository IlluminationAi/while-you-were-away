#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "$repo_dir"
builder=$repo_dir/bin/build-release
test_root=$(mktemp -d)

cleanup() {
  chmod -R u+rwX -- "$test_root" 2>/dev/null || true
  rm -rf -- "$test_root"
}
trap cleanup EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

mkdir -p -- "$test_root/one" "$test_root/two" "$test_root/extracted"
"$builder" "$test_root/one" >/dev/null
"$builder" "$test_root/two" >/dev/null

archive_one=$(find "$test_root/one" -maxdepth 1 -type f -name '*.tar.gz')
archive_two=$(find "$test_root/two" -maxdepth 1 -type f -name '*.tar.gz')
[[ -n "$archive_one" && -n "$archive_two" ]] ||
  fail "release archive was not created"
cmp -s -- "$archive_one" "$archive_two" ||
  fail "release archives are not reproducible"

(
  cd -- "$test_root/one"
  sha256sum -c -- "$(basename -- "$archive_one").sha256" >/dev/null
) || fail "release checksum did not verify"

tar -xzf "$archive_one" -C "$test_root/extracted"
release_root=$(find \
  "$test_root/extracted" \
  -mindepth 1 \
  -maxdepth 1 \
  -type d \
  -name 'while-you-were-away-*')
[[ -x "$release_root/bin/wywa" ]] ||
  fail "release omitted the executable CLI"
[[ -x "$release_root/bin/wywa-life" ]] ||
  fail "release omitted the local-life lifecycle CLI"
[[ -x "$release_root/bin/wywa-public" ]] ||
  fail "release omitted the public-host lifecycle CLI"
[[ -x "$release_root/bin/wywa-volume" ]] ||
  fail "release omitted the bounded workspace-volume CLI"
[[ -x "$release_root/bin/wywa-registry" ]] ||
  fail "release omitted the signed-origin proof CLI"
[[ -x "$release_root/bin/wywa-product" ]] ||
  fail "release omitted the signed product-maker claim CLI"
[[ -x "$release_root/bin/wywa-receipt" ]] ||
  fail "release omitted the provider economics receipt CLI"
[[ -x "$release_root/bin/wywa-curator" ]] ||
  fail "release omitted the closed manual curator CLI"
[[ -x "$release_root/bin/wywa-edge-probe" ]] ||
  fail "release omitted the provider-neutral public-edge probe"
[[ -x "$release_root/bin/wywa-intake" ]] ||
  fail "release omitted the signed intake consent CLI"
[[ -x "$release_root/bin/wywa-intake-queue" ]] ||
  fail "release omitted the private signed-intake queue CLI"
[[ -x "$release_root/bin/wywa-intake-gateway" ]] ||
  fail "release omitted the loopback signed-intake gateway"
[[ -x "$release_root/bin/wywa-retained-proof" ]] ||
  fail "release omitted the retained-proof lifecycle CLI"
[[ -x "$release_root/bin/publish-platform" ]] ||
  fail "release omitted the bounded life publisher"
[[ -x "$release_root/bin/build-launch-assets" ]] ||
  fail "release omitted the launch-asset builder"
[[ -f "$release_root/GETTING_STARTED.md" ]] ||
  fail "release omitted onboarding"
[[ -f "$release_root/CHANGELOG.md" ]] ||
  fail "release omitted the changelog"
[[ -f "$release_root/PRODUCT_HUNT.md" ]] ||
  fail "release omitted the launch pack"
[[ -f "$release_root/outreach-2026-07-24.md" ]] ||
  fail "release omitted the documented outreach evidence"
[[ -f "$release_root/REGISTRY.md" ]] ||
  fail "release omitted the registry proof contract"
[[ -f "$release_root/INTAKE_GATEWAY.md" ]] ||
  fail "release omitted the private gateway runbook"
[[ -f "$release_root/SECURITY.md" ]] ||
  fail "release omitted the security review map"
[[ -f "$release_root/launch-assets/01-leave-the-tab.png" ]] ||
  fail "release omitted the launch gallery"
[[ -f "$release_root/launch-assets/thumbnail-240.png" ]] ||
  fail "release omitted the launch thumbnail"
[[ -f "$release_root/LICENSE" ]] ||
  fail "release omitted the Apache-2.0 license"
[[ -f "$release_root/templates/MANDATE.md" ]] ||
  fail "release omitted templates"
[[ -f "$release_root/templates/public-state.json" ]] ||
  fail "release omitted the reviewed public-state template"
[[ -f "$release_root/platform/site.css" ]] ||
  fail "release omitted the life-dashboard stylesheet"
[[ -f "$release_root/platform/public-nginx.conf.in" ]] ||
  fail "release omitted the public nginx template"
[[ -f "$release_root/platform/public-nginx-zones.conf" ]] ||
  fail "release omitted public traffic controls"
[[ -f "$release_root/platform/intake-edge-harness.nginx.conf.in" ]] ||
  fail "release omitted the isolated intake-edge harness"
[[ -f "$release_root/platform/intake-public-window.nginx.conf.in" ]] ||
  fail "release omitted the attended public-intake window"
[[ -f "$release_root/platform/intake-public-window-zones.conf" ]] ||
  fail "release omitted the public-intake window traffic controls"

shellcheck \
  "$release_root/bin/wywa" \
  "$release_root/bin/wywa-life" \
  "$release_root/bin/wywa-public" \
  "$release_root/bin/wywa-volume"
"$release_root/bin/wywa" --help >/dev/null
"$release_root/bin/wywa-life" --help >/dev/null
"$release_root/bin/wywa-public" --help >/dev/null
"$release_root/bin/wywa-volume" --help >/dev/null
"$release_root/bin/wywa-registry" --help >/dev/null
"$release_root/bin/wywa-product" --help >/dev/null
"$release_root/bin/wywa-receipt" --help >/dev/null
"$release_root/bin/wywa-curator" --help >/dev/null
"$release_root/bin/wywa-edge-probe" --help >/dev/null
"$release_root/bin/wywa-intake" --help >/dev/null
"$release_root/bin/wywa-intake-queue" --help >/dev/null
"$release_root/bin/wywa-intake-gateway" --help >/dev/null
"$release_root/bin/wywa-retained-proof" --help >/dev/null
"$release_root/bin/wywa" init "$test_root/release-worker" >/dev/null
[[ -z "$(git -C "$test_root/release-worker" status --porcelain)" ]] ||
  fail "released CLI did not create a clean workspace"

private_pattern='104''\\.248\\.|sergei_''ton|TELEGRAM_''(BOT_)?TOKEN|AGENT_''CHAT_ID'
if rg -n \
  "$private_pattern" \
  "$release_root" >/dev/null; then
  fail "release contains private deployment material"
fi

printf '%s\n' "PASS: reproducible WYWA release"
