#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "$repo_dir"
builder=$repo_dir/bin/build-source-tree
test_root=$(mktemp -d)

cleanup() {
  chmod -R u+rwX -- "$test_root" 2>/dev/null || true
  rm -rf -- "$test_root"
}
trap cleanup EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

mkdir -p -- "$test_root/one" "$test_root/two"
"$builder" "$test_root/one" >/dev/null
"$builder" "$test_root/two" >/dev/null

source_one=$test_root/one/while-you-were-away
source_two=$test_root/two/while-you-were-away
diff -qr -- "$source_one" "$source_two" >/dev/null ||
  fail "source-tree builds differ"

for required in \
  README.md \
  CHANGELOG.md \
  GETTING_STARTED.md \
  INTAKE_GATEWAY.md \
  LICENSE \
  outreach-2026-07-24.md \
  permission-boundary-2026-07-25.md \
  PRODUCT_HUNT.md \
  PLATFORM.md \
  REGISTRY.md \
  SECURITY.md \
  VERSION \
  bin/wywa \
  bin/wywa-life \
  bin/wywa-life-drill \
  bin/wywa-public \
  bin/wywa-curator \
  bin/wywa-edge-probe \
  bin/wywa-intake \
  bin/wywa-intake-gateway \
  bin/wywa-intake-queue \
  bin/wywa-retained-proof \
  bin/wywa-registry \
  bin/build-launch-assets \
  bin/publish-platform \
  bin/build-release \
  bin/build-source-tree \
  launch-assets/README.md \
  launch-assets/01-leave-the-tab.png \
  launch-assets/02-honest-continuity.png \
  launch-assets/03-visible-boundaries.png \
  launch-assets/04-checkpoint-evidence.png \
  launch-assets/05-honest-failures.png \
  launch-assets/thumbnail-240.png \
  platform/nginx-bootstrap.conf \
  platform/nginx.conf \
  platform/intake-edge-harness.nginx.conf.in \
  platform/intake-public-window.nginx.conf.in \
  platform/intake-public-window-zones.conf \
  platform/public-nginx-bootstrap.conf.in \
  platform/public-nginx.conf.in \
  platform/public-nginx-zones.conf \
  platform/public-state.json \
  platform/wywa-retained-proof.service \
  platform/wywa-retained-proof.timer \
  platform/registry/audit.json \
  platform/registry/index.html \
  platform/registry/index.json \
  platform/site.css \
  templates/MANDATE.md \
  templates/public-state.json \
  tests/test-wywa \
  tests/test-life \
  tests/test-life-drill \
  tests/test-public \
  tests/test-curator \
  tests/test-intake \
  tests/test-intake-edge \
  tests/test-intake-gateway \
  tests/test-intake-queue \
  tests/test-retained-proof \
  tests/test-edge-probe \
  tests/test-registry \
  tests/test-platform \
  tests/test-release \
  tests/test-source-tree
do
  [[ -f "$source_one/$required" ]] ||
    fail "source tree omitted $required"
done

if ! python3 - "$source_one/launch-assets" <<'PY'
import struct
import sys
from pathlib import Path

asset_dir = Path(sys.argv[1])
expected = {
    "01-leave-the-tab.png": (1270, 760),
    "02-honest-continuity.png": (1270, 760),
    "03-visible-boundaries.png": (1270, 760),
    "04-checkpoint-evidence.png": (1270, 760),
    "05-honest-failures.png": (1270, 760),
    "thumbnail-240.png": (240, 240),
}
for name, dimensions in expected.items():
    data = (asset_dir / name).read_bytes()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise SystemExit(f"{name}: invalid PNG signature")
    if struct.unpack(">II", data[16:24]) != dimensions:
        raise SystemExit(f"{name}: unexpected dimensions")
PY
then
  fail "launch assets have invalid PNG dimensions"
fi

shellcheck \
  "$source_one/bin/wywa" \
  "$source_one/bin/wywa-life" \
  "$source_one/bin/wywa-life-drill" \
  "$source_one/bin/wywa-public" \
  "$source_one/bin/build-release" \
  "$source_one/bin/build-source-tree" \
  "$source_one/tests/test-wywa" \
  "$source_one/tests/test-life" \
  "$source_one/tests/test-life-drill" \
  "$source_one/tests/test-public" \
  "$source_one/tests/test-release"

"$source_one/tests/test-wywa" >/dev/null
"$source_one/tests/test-life" >/dev/null
"$source_one/tests/test-life-drill" >/dev/null
"$source_one/tests/test-public" >/dev/null
"$source_one/tests/test-registry" >/dev/null
"$source_one/tests/test-curator" >/dev/null
"$source_one/tests/test-intake" >/dev/null
"$source_one/tests/test-intake-edge" >/dev/null
"$source_one/tests/test-intake-gateway" >/dev/null
"$source_one/tests/test-intake-queue" >/dev/null
"$source_one/tests/test-retained-proof" >/dev/null
"$source_one/tests/test-edge-probe" >/dev/null
"$source_one/tests/test-platform" >/dev/null
"$source_one/tests/test-release" >/dev/null

private_pattern='104''\.248\.|sergei_''ton|TELEGRAM_''(BOT_)?TOKEN|AGENT_''CHAT_ID'
if rg -n \
  "$private_pattern" \
  "$source_one" >/dev/null; then
  fail "source tree contains private deployment material"
fi

git -C "$source_one" init -q -b main
git -C "$source_one" config user.name "WYWA Release Test"
git -C "$source_one" config user.email "wywa-release@localhost"
git -C "$source_one" add -- .
git -C "$source_one" commit -q -m "Prepare standalone alpha source"
[[ -z "$(git -C "$source_one" status --porcelain)" ]] ||
  fail "standalone source repository is not clean"

printf '%s\n' "PASS: standalone WYWA source tree"
