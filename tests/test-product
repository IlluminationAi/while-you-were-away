#!/usr/bin/env python3
"""Exercise signed product-maker claim issuance and verification."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import tempfile
from pathlib import Path


PROJECT = Path(__file__).resolve().parent.parent
REGISTRY = PROJECT / "bin" / "wywa-registry"
PRODUCT = PROJECT / "bin" / "wywa-product"
AT = "2026-07-25T16:00:00Z"


def run(
    *arguments: str,
    expected: int = 0,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        [str(PRODUCT), *arguments],
        capture_output=True,
        text=True,
    )
    if result.returncode != expected:
        raise AssertionError(
            f"expected {expected}, got {result.returncode}\n"
            f"stdout: {result.stdout}\nstderr: {result.stderr}"
        )
    return result


def issue_product(
    proof: Path,
    key: Path,
    output: Path,
    sequence: int,
    *,
    name: str = "Test Product",
    status: str = "active",
    replace: bool = False,
) -> dict[str, object]:
    arguments = [
        "issue",
        "--product-id",
        "test-product",
        "--name",
        name,
        "--product-url",
        "https://example.com/product",
        "--release-kind",
        "reproducible release",
        "--release-claim",
        "The public tree rebuilds byte for byte.",
        "--release-url",
        "https://example.com/product/release",
        "--agent-manifest",
        str(proof / "wywa-agent.json"),
        "--agent-signature",
        str(proof / "wywa-agent.sig"),
        "--key",
        str(key),
        "--sequence",
        str(sequence),
        "--status",
        status,
        "--issued-at",
        AT,
        "--expires-days",
        "10",
        "--output",
        str(output),
    ]
    if replace:
        arguments.append("--replace")
    return json.loads(run(*arguments, expected=4 if status == "revoked" else 0).stdout)


def verify(
    proof: Path,
    output: Path,
    *,
    previous: Path | None = None,
    expected: int = 0,
) -> subprocess.CompletedProcess[str]:
    arguments = [
        "verify-files",
        str(output / "test-product.json"),
        str(output / "test-product.sig"),
        "--agent-manifest",
        str(proof / "wywa-agent.json"),
        "--agent-signature",
        str(proof / "wywa-agent.sig"),
        "--at",
        "2026-07-25T16:01:00Z",
    ]
    if previous is not None:
        arguments.extend(["--previous", str(previous)])
    return run(*arguments, expected=expected)


def main() -> None:
    with tempfile.TemporaryDirectory(prefix="wywa-product-test-") as temporary:
        root = Path(temporary)
        key = root / "identity" / "agent_ed25519"
        key.parent.mkdir(mode=0o700)
        subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(key)],
            check=True,
        )
        os.chmod(key, 0o600)
        proof = root / "agent-proof"
        subprocess.run(
            [
                str(REGISTRY),
                "issue",
                "--agent-id",
                "test-agent",
                "--name",
                "Test Agent",
                "--origin",
                "https://life.example.com/",
                "--runtime-version",
                "test",
                "--sequence",
                "3",
                "--issued-at",
                "2026-07-25T15:59:00Z",
                "--valid-days",
                "20",
                "--key",
                str(key),
                "--output",
                str(proof),
            ],
            check=True,
            capture_output=True,
            text=True,
        )

        output = root / "product-proof"
        issued = issue_product(proof, key, output, 1)
        claim = output / "test-product.json"
        signature = output / "test-product.sig"
        assert issued["eligible"] is True
        assert issued["maker_agent_id"] == "test-agent"
        assert issued["maker_sequence"] == 3
        assert claim.stat().st_mode & 0o777 == 0o644
        assert signature.stat().st_mode & 0o777 == 0o644

        verified = json.loads(verify(proof, output).stdout)
        assert verified == issued
        assert verified["evidence"] == "detached-agent-and-product-files"
        assert verified["release_evidence"]["kind"] == "reproducible release"

        previous_one = root / "previous-one.json"
        previous_one.write_text(json.dumps(verified), encoding="utf-8")
        old_claim = root / "old.json"
        old_signature = root / "old.sig"
        shutil.copy2(claim, old_claim)
        shutil.copy2(signature, old_signature)

        exists = run(
            "issue",
            "--product-id",
            "test-product",
            "--name",
            "Test Product",
            "--product-url",
            "https://example.com/product",
            "--release-kind",
            "reproducible release",
            "--release-claim",
            "The public tree rebuilds byte for byte.",
            "--release-url",
            "https://example.com/product/release",
            "--agent-manifest",
            str(proof / "wywa-agent.json"),
            "--agent-signature",
            str(proof / "wywa-agent.sig"),
            "--key",
            str(key),
            "--sequence",
            "2",
            "--issued-at",
            AT,
            "--output",
            str(output),
            expected=2,
        )
        assert "use --replace" in exists.stderr

        issued_two = issue_product(proof, key, output, 2, replace=True)
        verified_two = json.loads(verify(proof, output, previous=previous_one).stdout)
        assert issued_two["sequence"] == 2
        assert verified_two["sequence"] == 2

        previous_two = root / "previous-two.json"
        previous_two.write_text(json.dumps(verified_two), encoding="utf-8")
        rollback = run(
            "verify-files",
            str(old_claim),
            str(old_signature),
            "--agent-manifest",
            str(proof / "wywa-agent.json"),
            "--agent-signature",
            str(proof / "wywa-agent.sig"),
            "--previous",
            str(previous_two),
            "--at",
            "2026-07-25T16:01:00Z",
            expected=2,
        )
        assert "rolls back" in rollback.stderr

        untampered = claim.read_text(encoding="utf-8")
        claim.write_text(
            untampered.replace("Test Product", "Bent Product"),
            encoding="utf-8",
        )
        tampered = verify(proof, output, expected=2)
        assert "signature verification failed" in tampered.stderr
        claim.write_text(untampered, encoding="utf-8")

        wrong_key = root / "other_ed25519"
        subprocess.run(
            [
                "ssh-keygen",
                "-q",
                "-t",
                "ed25519",
                "-N",
                "",
                "-f",
                str(wrong_key),
            ],
            check=True,
        )
        os.chmod(wrong_key, 0o600)
        wrong = run(
            "issue",
            "--product-id",
            "wrong-key-product",
            "--name",
            "Wrong Key",
            "--product-url",
            "https://example.com/wrong",
            "--release-kind",
            "release",
            "--release-claim",
            "Claim.",
            "--release-url",
            "https://example.com/wrong/release",
            "--agent-manifest",
            str(proof / "wywa-agent.json"),
            "--agent-signature",
            str(proof / "wywa-agent.sig"),
            "--key",
            str(wrong_key),
            "--sequence",
            "1",
            "--issued-at",
            AT,
            "--output",
            str(root / "wrong-output"),
            expected=2,
        )
        assert "does not match" in wrong.stderr

        revoked = issue_product(
            proof,
            key,
            output,
            3,
            status="revoked",
            replace=True,
        )
        assert revoked["eligible"] is False
        revoked_verify = verify(proof, output, expected=4)
        assert json.loads(revoked_verify.stdout)["status"] == "revoked"

    print("PASS signed WYWA product-maker claims")


if __name__ == "__main__":
    main()
