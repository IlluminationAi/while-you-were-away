#!/usr/bin/env python3
"""Exercise the source-backed atomic WYWA platform publisher."""

from __future__ import annotations

import json
import subprocess
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path


PROJECT = Path(__file__).resolve().parent.parent
PUBLISH = PROJECT / "bin" / "publish-platform"
REGISTRY = PROJECT / "bin" / "wywa-registry"
PRODUCT = PROJECT / "bin" / "wywa-product"
CURATOR = PROJECT / "bin" / "wywa-curator"
INSTANTS = (
    "2026-07-24T17:40:00Z",
    "2026-07-24T17:41:00Z",
    "2026-07-24T17:42:00Z",
)


def main() -> None:
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        site = root / "site"
        logs = root / "logs"
        runtime = root / "runtime"
        workspace = root / "workspace"
        proof = root / "proof"
        product_proof = root / "product-proof"
        registry_state = root / "registry-state"
        registry_export = root / "registry-export"
        key = root / "identity" / "agent_ed25519"
        logs.mkdir()
        runtime.mkdir()
        workspace.mkdir()
        key.parent.mkdir(mode=0o700)
        subprocess.run(
            [
                "ssh-keygen",
                "-q",
                "-t",
                "ed25519",
                "-N",
                "",
                "-f",
                str(key),
            ],
            check=True,
        )
        key.chmod(0o600)
        subprocess.run(
            [
                str(REGISTRY),
                "issue",
                "--agent-id",
                "lumen",
                "--name",
                "Lumen",
                "--origin",
                "https://while-you-were-away.online/",
                "--runtime-version",
                "0.1.0-alpha.4",
                "--sequence",
                "1",
                "--issued-at",
                "2026-07-24T17:39:00Z",
                "--key",
                str(key),
                "--output",
                str(proof),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        public_state = json.loads(
            (PROJECT / "platform" / "public-state.json").read_text(
                encoding="utf-8"
            )
        )
        for sequence, product in enumerate(public_state["products"], start=1):
            release = product["release_evidence"]
            subprocess.run(
                [
                    str(PRODUCT),
                    "issue",
                    "--product-id",
                    product["id"],
                    "--name",
                    product["name"],
                    "--product-url",
                    product["url"],
                    "--release-kind",
                    release["kind"],
                    "--release-claim",
                    release["claim"],
                    "--release-url",
                    release["url"],
                    "--agent-manifest",
                    str(proof / "wywa-agent.json"),
                    "--agent-signature",
                    str(proof / "wywa-agent.sig"),
                    "--key",
                    str(key),
                    "--sequence",
                    str(sequence),
                    "--issued-at",
                    "2026-07-24T17:39:10Z",
                    "--output",
                    str(product_proof),
                ],
                check=True,
                capture_output=True,
                text=True,
            )
        verification_result = subprocess.run(
            [
                str(REGISTRY),
                "verify-files",
                str(proof / "wywa-agent.json"),
                str(proof / "wywa-agent.sig"),
                "--expected-origin",
                "https://while-you-were-away.online/",
                "--at",
                "2026-07-24T17:39:30Z",
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        live_verification = json.loads(verification_result.stdout)
        live_verification["evidence"] = "live-https-origin"
        verification_path = root / "live-verification.json"
        verification_path.write_text(
            json.dumps(live_verification),
            encoding="utf-8",
        )
        subprocess.run(
            [str(CURATOR), "init", "--state", str(registry_state)],
            check=True,
            capture_output=True,
            text=True,
        )
        subprocess.run(
            [
                str(CURATOR),
                "admit",
                "--state",
                str(registry_state),
                "--verification",
                str(verification_path),
                "--consent-evidence",
                "Test operator consent.",
                "--reason",
                "Test catalog admission.",
                "--at",
                "2026-07-24T17:39:40Z",
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        subprocess.run(
            [
                str(CURATOR),
                "export",
                "--state",
                str(registry_state),
                "--output",
                str(registry_export),
                "--as-of",
                "2026-07-24T17:39:50Z",
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        subprocess.run(["git", "-C", str(workspace), "init", "-q"], check=True)
        (workspace / "README").write_text("public test workspace\n", encoding="utf-8")
        subprocess.run(["git", "-C", str(workspace), "add", "README"], check=True)
        subprocess.run(
            [
                "git",
                "-C",
                str(workspace),
                "-c",
                "user.name=WYWA Test",
                "-c",
                "user.email=wywa-test@localhost",
                "commit",
                "-q",
                "-m",
                "Create test workspace",
            ],
            check=True,
        )
        for name in (
            "cycle-20260724T160000Z.log",
            "cycle-20260724T170000Z.log",
            "cycle-20260724T173000Z.log",
        ):
            (logs / name).touch()
        (runtime / "last-run").write_text(
            "completed=2026-07-24T17:31:00Z status=0 "
            "log=/private/path/that/must/not/publish\n",
            encoding="utf-8",
        )

        releases: list[str] = []
        for instant in INSTANTS:
            result = subprocess.run(
                [
                    str(PUBLISH),
                    "--site-root",
                    str(site),
                    "--logs-root",
                    str(logs),
                    "--runtime-root",
                    str(runtime),
                    "--workspace-root",
                    str(workspace),
                    "--agent-proof-dir",
                    str(proof),
                    "--product-proof-dir",
                    str(product_proof),
                    "--registry-export-dir",
                    str(registry_export),
                    "--as-of",
                    instant,
                    "--phase",
                    "active",
                    "--keep",
                    "2",
                ],
                check=True,
                capture_output=True,
                text=True,
            )
            releases.append(json.loads(result.stdout)["release"])

        current = site / "current"
        assert current.is_symlink()
        assert current.resolve().name == releases[-1]
        assert not (site / "releases" / releases[0]).exists()
        assert (site / "releases" / releases[1]).is_dir()
        assert (site / "releases" / releases[2]).is_dir()

        page = (current / "index.html").read_text(encoding="utf-8")
        life = json.loads((current / "life.json").read_text(encoding="utf-8"))
        product_page = (current / "products" / "index.html").read_text(
            encoding="utf-8"
        )
        product_catalog = json.loads(
            (current / "products" / "index.json").read_text(encoding="utf-8")
        )
        assert life["generated_at"] == INSTANTS[-1]
        assert life["phase"] == "active"
        assert life["metrics"]["observed_cycles"] == 3
        assert life["metrics"]["active_projects"] == 1
        assert life["metrics"]["verified_agents"] == 1
        assert life["registry"]["admission"] == "manual-closed"
        assert life["registry"]["summary"]["eligible"] == 1
        assert life["metrics"]["verified_revenue_usd"] == "0.00"
        assert life["product_hub"]["admission"] == "reviewed-closed"
        assert life["product_hub"]["ranking"]["status"] == "withheld"
        assert life["product_hub"]["signed_maker_claims"] == 2
        assert product_catalog["summary"] == life["economics"]["summary"]
        assert product_catalog["summary"]["products"] == 2
        assert product_catalog["summary"]["settled_evidence_events"] == 0
        assert product_catalog["summary"]["verified_gross_revenue_usd"] == "0.00"
        assert product_catalog["summary"]["verified_direct_costs_usd"] == "0.00"
        assert product_catalog["ranking"]["rows"] == []
        assert product_catalog["popularity"]["status"] == "not-measured"
        assert all(
            item["economics"]["ranking_eligible"] is False
            for item in product_catalog["products"]
        )
        assert all(
            item["identity_claim"]["status"] == "verified-maker-signature"
            for item in product_catalog["products"]
        )
        assert life["last_receipt"] == {
            "completed_at": "2026-07-24T17:31:00Z",
            "outcome": "success",
            "status": 0,
        }
        assert "/private/path" not in json.dumps(life)
        assert "<script" not in page.lower()
        assert "style=" not in page.lower()
        assert "<script" not in product_page.lower()
        assert "<style" not in product_page.lower()
        assert "Evidence before" in product_page
        assert "Withheld." in product_page
        assert "empty evidence set" in product_page
        assert "verified maker signature" in product_page
        assert "public operating system" in page
        assert "/products/" in page
        assert "$0.00" in page
        assert len(life["activity_24h"]) == 24
        assert sum(row["count"] for row in life["activity_24h"]) == 3
        ET.parse(current / "feed.xml")
        nostr = json.loads(
            (current / ".well-known" / "nostr.json").read_text(
                encoding="utf-8"
            )
        )
        nostr_pubkey = life["identity"]["nostr"]["pubkey"]
        assert nostr["names"] == {"lumen": nostr_pubkey}
        assert nostr["relays"][nostr_pubkey] == [
            "wss://relay.damus.io",
            "wss://nos.lol",
            "wss://relay.primal.net",
        ]
        security_txt = (
            current / ".well-known" / "security.txt"
        ).read_text(encoding="utf-8")
        assert security_txt == (
            "Contact: "
            "https://github.com/IlluminationAi/while-you-were-away/security\n"
            "Expires: 2027-01-20T17:42:00Z\n"
            "Preferred-Languages: en\n"
            "Canonical: "
            "https://while-you-were-away.online/.well-known/security.txt\n"
            "Policy: "
            "https://github.com/IlluminationAi/while-you-were-away/security\n"
        )
        registry_manifest = (
            current / ".well-known" / "wywa-agent.json"
        )
        registry_signature = current / ".well-known" / "wywa-agent.sig"
        assert registry_manifest.read_bytes() == (
            proof / "wywa-agent.json"
        ).read_bytes()
        assert registry_signature.read_bytes() == (
            proof / "wywa-agent.sig"
        ).read_bytes()
        registry_catalog = json.loads(
            (current / "agents" / "index.json").read_text(encoding="utf-8")
        )
        registry_audit = json.loads(
            (current / "agents" / "audit.json").read_text(encoding="utf-8")
        )
        assert registry_catalog["summary"]["eligible"] == 1
        assert (
            registry_catalog["audit_head_sha256"]
            == registry_audit["head_sha256"]
        )
        assert "<script" not in (
            current / "agents" / "index.html"
        ).read_text(encoding="utf-8").lower()

        for directory in (
            site,
            site / "releases",
            current.resolve(),
            current / "assets",
            current / ".well-known",
            current / "agents",
            current / "products",
            current / "products" / "claims",
        ):
            assert directory.stat().st_mode & 0o777 == 0o755
        for file_path in (
            current / "index.html",
            current / "life.json",
            current / "feed.xml",
            current / "robots.txt",
            current / "assets" / "site.css",
            current / ".well-known" / "nostr.json",
            current / ".well-known" / "security.txt",
            current / ".well-known" / "wywa-agent.json",
            current / ".well-known" / "wywa-agent.sig",
            current / "agents" / "index.html",
            current / "agents" / "index.json",
            current / "agents" / "audit.json",
            current / "products" / "index.html",
            current / "products" / "index.json",
            current / "products" / "claims" / "wywa.json",
            current / "products" / "claims" / "wywa.sig",
            current / "products" / "claims" / "revision-radar.json",
            current / "products" / "claims" / "revision-radar.sig",
        ):
            assert file_path.is_file()
            assert not file_path.is_symlink()
            assert file_path.stat().st_mode & 0o777 == 0o644

        unsafe = subprocess.run(
            [str(PUBLISH), "--site-root", "relative", "--keep", "1"],
            capture_output=True,
            text=True,
        )
        assert unsafe.returncode != 0
        assert "site root must be absolute" in unsafe.stderr

        mismatched_state = root / "mismatched-public-state.json"
        mismatched = json.loads(
            (PROJECT / "platform" / "public-state.json").read_text(
                encoding="utf-8"
            )
        )
        mismatched["identity"]["nostr"]["nip05"] = "lumen@other.example"
        mismatched_state.write_text(
            json.dumps(mismatched), encoding="utf-8"
        )
        mismatch_result = subprocess.run(
            [
                str(PUBLISH),
                "--site-root",
                str(root / "mismatched-site"),
                "--logs-root",
                str(logs),
                "--runtime-root",
                str(runtime),
                "--workspace-root",
                str(workspace),
                "--public-state",
                str(mismatched_state),
                "--base-url",
                "https://life.example",
                "--as-of",
                "2026-07-24T17:43:00Z",
            ],
            capture_output=True,
            text=True,
        )
        assert mismatch_result.returncode != 0
        assert "NIP-05 domain differs" in mismatch_result.stderr

        invalid_economics_state = root / "invalid-economics-public-state.json"
        invalid_economics = json.loads(
            (PROJECT / "platform" / "public-state.json").read_text(
                encoding="utf-8"
            )
        )
        invalid_economics["products"][0]["economics"]["evidence"] = [
            {
                "id": "bad-precision",
                "kind": "settled-revenue",
                "amount_usd": "1.001",
                "settled_at": "2026-07-24T17:39:00Z",
                "receipt_url": "https://example.test/receipt",
                "scope": "Invalid fixture.",
            }
        ]
        invalid_economics_state.write_text(
            json.dumps(invalid_economics), encoding="utf-8"
        )
        invalid_economics_result = subprocess.run(
            [
                str(PUBLISH),
                "--site-root",
                str(root / "invalid-economics-site"),
                "--logs-root",
                str(logs),
                "--runtime-root",
                str(runtime),
                "--workspace-root",
                str(workspace),
                "--public-state",
                str(invalid_economics_state),
                "--as-of",
                "2026-07-24T17:43:30Z",
            ],
            capture_output=True,
            text=True,
        )
        assert invalid_economics_result.returncode != 0
        assert "two decimals" in invalid_economics_result.stderr

        portable_site = root / "portable-site"
        (runtime / "last-run").write_text(
            "2026-07-24T17:43:00Z status=0 sandbox=workspace-write "
            "checkpoint=0123456789ab log=/another/private/path\n",
            encoding="utf-8",
        )
        subprocess.run(
            [
                str(PUBLISH),
                "--site-root",
                str(portable_site),
                "--logs-root",
                str(logs),
                "--runtime-root",
                str(runtime),
                "--workspace-root",
                str(workspace),
                "--base-url",
                "http://127.0.0.1",
                "--as-of",
                "2026-07-24T17:44:00Z",
                "--phase",
                "waiting",
                "--keep",
                "2",
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        portable_life = json.loads(
            (portable_site / "current" / "life.json").read_text(
                encoding="utf-8"
            )
        )
        assert portable_life["site"]["base_url"] == "http://127.0.0.1"
        assert portable_life["last_receipt"] == {
            "completed_at": "2026-07-24T17:43:00Z",
            "outcome": "success",
            "status": 0,
        }
        assert "registry" not in portable_life
        assert not (portable_site / "current" / "agents").exists()
        assert (portable_site / "current" / "products" / "index.html").is_file()
        assert (portable_site / "current" / "products" / "index.json").is_file()
        assert all(
            item["identity_claim"]["status"] == "unverified"
            for item in portable_life["products"]
        )
        assert "reviewed catalog and audit trail" not in (
            portable_site / "current" / "index.html"
        ).read_text(encoding="utf-8")
        assert "/another/private/path" not in json.dumps(portable_life)
        portable_feed = (
            portable_site / "current" / "feed.xml"
        ).read_text(encoding="utf-8")
        assert "http://127.0.0.1/feed.xml" in portable_feed
        assert not (
            portable_site / "current" / ".well-known" / "security.txt"
        ).exists()
        portable_product_page = (
            portable_site / "current" / "products" / "index.html"
        ).read_text(encoding="utf-8")
        assert '../assets/site.css' in portable_product_page
        assert 'href="../index.html"' in portable_product_page

    print("PASS source-backed WYWA platform publication")


if __name__ == "__main__":
    main()
