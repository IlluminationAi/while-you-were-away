#!/usr/bin/env python3
"""Exercise the source-backed atomic WYWA platform publisher."""

from __future__ import annotations

import json
import subprocess
import tempfile
import xml.etree.ElementTree as ET
from pathlib import Path


PROJECT = Path(__file__).resolve().parent.parent
PUBLISH = PROJECT / "bin" / "publish-platform"
INSTANTS = (
    "2026-07-24T17:40:00Z",
    "2026-07-24T17:41:00Z",
    "2026-07-24T17:42:00Z",
)


def main() -> None:
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        site = root / "site"
        logs = root / "logs"
        runtime = root / "runtime"
        workspace = root / "workspace"
        logs.mkdir()
        runtime.mkdir()
        workspace.mkdir()
        subprocess.run(["git", "-C", str(workspace), "init", "-q"], check=True)
        (workspace / "README").write_text("public test workspace\n", encoding="utf-8")
        subprocess.run(["git", "-C", str(workspace), "add", "README"], check=True)
        subprocess.run(
            [
                "git",
                "-C",
                str(workspace),
                "-c",
                "user.name=WYWA Test",
                "-c",
                "user.email=wywa-test@localhost",
                "commit",
                "-q",
                "-m",
                "Create test workspace",
            ],
            check=True,
        )
        for name in (
            "cycle-20260724T160000Z.log",
            "cycle-20260724T170000Z.log",
            "cycle-20260724T173000Z.log",
        ):
            (logs / name).touch()
        (runtime / "last-run").write_text(
            "completed=2026-07-24T17:31:00Z status=0 "
            "log=/private/path/that/must/not/publish\n",
            encoding="utf-8",
        )

        releases: list[str] = []
        for instant in INSTANTS:
            result = subprocess.run(
                [
                    str(PUBLISH),
                    "--site-root",
                    str(site),
                    "--logs-root",
                    str(logs),
                    "--runtime-root",
                    str(runtime),
                    "--workspace-root",
                    str(workspace),
                    "--as-of",
                    instant,
                    "--phase",
                    "active",
                    "--keep",
                    "2",
                ],
                check=True,
                capture_output=True,
                text=True,
            )
            releases.append(json.loads(result.stdout)["release"])

        current = site / "current"
        assert current.is_symlink()
        assert current.resolve().name == releases[-1]
        assert not (site / "releases" / releases[0]).exists()
        assert (site / "releases" / releases[1]).is_dir()
        assert (site / "releases" / releases[2]).is_dir()

        page = (current / "index.html").read_text(encoding="utf-8")
        life = json.loads((current / "life.json").read_text(encoding="utf-8"))
        assert life["generated_at"] == INSTANTS[-1]
        assert life["phase"] == "active"
        assert life["metrics"]["observed_cycles"] == 3
        assert life["metrics"]["active_projects"] == 1
        assert life["metrics"]["verified_agents"] == 1
        assert life["metrics"]["verified_revenue_usd"] == "0.00"
        assert life["last_receipt"] == {
            "completed_at": "2026-07-24T17:31:00Z",
            "outcome": "success",
            "status": 0,
        }
        assert "/private/path" not in json.dumps(life)
        assert "<script" not in page.lower()
        assert "style=" not in page.lower()
        assert "public operating system" in page
        assert "$0.00" in page
        assert len(life["activity_24h"]) == 24
        assert sum(row["count"] for row in life["activity_24h"]) == 3
        ET.parse(current / "feed.xml")

        for directory in (
            site,
            site / "releases",
            current.resolve(),
            current / "assets",
        ):
            assert directory.stat().st_mode & 0o777 == 0o755
        for file_path in (
            current / "index.html",
            current / "life.json",
            current / "feed.xml",
            current / "robots.txt",
            current / "assets" / "site.css",
        ):
            assert file_path.is_file()
            assert not file_path.is_symlink()
            assert file_path.stat().st_mode & 0o777 == 0o644

        unsafe = subprocess.run(
            [str(PUBLISH), "--site-root", "relative", "--keep", "1"],
            capture_output=True,
            text=True,
        )
        assert unsafe.returncode != 0
        assert "site root must be absolute" in unsafe.stderr

        portable_site = root / "portable-site"
        (runtime / "last-run").write_text(
            "2026-07-24T17:43:00Z status=0 sandbox=workspace-write "
            "checkpoint=0123456789ab log=/another/private/path\n",
            encoding="utf-8",
        )
        subprocess.run(
            [
                str(PUBLISH),
                "--site-root",
                str(portable_site),
                "--logs-root",
                str(logs),
                "--runtime-root",
                str(runtime),
                "--workspace-root",
                str(workspace),
                "--base-url",
                "http://127.0.0.1",
                "--as-of",
                "2026-07-24T17:44:00Z",
                "--phase",
                "waiting",
                "--keep",
                "2",
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        portable_life = json.loads(
            (portable_site / "current" / "life.json").read_text(
                encoding="utf-8"
            )
        )
        assert portable_life["site"]["base_url"] == "http://127.0.0.1"
        assert portable_life["last_receipt"] == {
            "completed_at": "2026-07-24T17:43:00Z",
            "outcome": "success",
            "status": 0,
        }
        assert "/another/private/path" not in json.dumps(portable_life)
        portable_feed = (
            portable_site / "current" / "feed.xml"
        ).read_text(encoding="utf-8")
        assert "http://127.0.0.1/feed.xml" in portable_feed

    print("PASS source-backed WYWA platform publication")


if __name__ == "__main__":
    main()
