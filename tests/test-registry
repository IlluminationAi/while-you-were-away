#!/usr/bin/env python3
"""Exercise signed WYWA agent-origin proof issuance and verification."""

from __future__ import annotations

import datetime as dt
import json
import os
import shutil
import subprocess
import tempfile
from pathlib import Path


PROJECT = Path(__file__).resolve().parent.parent
REGISTRY = PROJECT / "bin" / "wywa-registry"
ORIGIN = "https://life.example.net/"


def run(
    *arguments: str,
    expected: int = 0,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        [str(REGISTRY), *arguments],
        capture_output=True,
        text=True,
    )
    if result.returncode != expected:
        raise AssertionError(
            f"expected {expected}, got {result.returncode}\n"
            f"stdout: {result.stdout}\nstderr: {result.stderr}"
        )
    return result


def issue(
    key: Path,
    output: Path,
    sequence: int,
    *,
    name: str = "Test Worker",
    status: str = "active",
    replace: bool = False,
) -> dict[str, object]:
    arguments = [
        "issue",
        "--agent-id",
        "test-worker",
        "--name",
        name,
        "--origin",
        ORIGIN,
        "--runtime-version",
        "0.1.0-alpha.4",
        "--sequence",
        str(sequence),
        "--status",
        status,
        "--key",
        str(key),
        "--output",
        str(output),
    ]
    if replace:
        arguments.append("--replace")
    return json.loads(run(*arguments).stdout)


def verify(
    manifest: Path,
    signature: Path,
    *,
    previous: Path | None = None,
    at: str | None = None,
    expected: int = 0,
) -> subprocess.CompletedProcess[str]:
    arguments = [
        "verify-files",
        str(manifest),
        str(signature),
        "--expected-origin",
        ORIGIN,
    ]
    if previous is not None:
        arguments.extend(["--previous", str(previous)])
    if at is not None:
        arguments.extend(["--at", at])
    return run(*arguments, expected=expected)


def main() -> None:
    with tempfile.TemporaryDirectory(prefix="wywa-registry-test-") as temporary:
        root = Path(temporary)
        key = root / "identity" / "agent_ed25519"
        key.parent.mkdir(mode=0o700)
        subprocess.run(
            [
                "ssh-keygen",
                "-q",
                "-t",
                "ed25519",
                "-N",
                "",
                "-f",
                str(key),
            ],
            check=True,
        )
        os.chmod(key, 0o600)
        proof = root / "public" / ".well-known"

        issued_one = issue(key, proof, 1)
        manifest = proof / "wywa-agent.json"
        signature = proof / "wywa-agent.sig"
        assert manifest.is_file() and not manifest.is_symlink()
        assert signature.is_file() and not signature.is_symlink()
        assert manifest.stat().st_mode & 0o777 == 0o644
        assert signature.stat().st_mode & 0o777 == 0o644
        assert issued_one["sequence"] == 1
        assert issued_one["status"] == "active"
        assert issued_one["origin"] == ORIGIN

        verified_one_result = verify(manifest, signature)
        verified_one = json.loads(verified_one_result.stdout)
        assert verified_one["eligible"] is True
        assert verified_one["evidence"] == "detached-files-only"
        assert verified_one["manifest_sha256"] == issued_one["manifest_sha256"]
        assert verified_one["public_key"].startswith("ssh-ed25519 ")

        previous_one = root / "previous-one.json"
        previous_one.write_text(
            json.dumps(verified_one),
            encoding="utf-8",
        )
        old_manifest = root / "old-manifest.json"
        old_signature = root / "old-manifest.sig"
        shutil.copy2(manifest, old_manifest)
        shutil.copy2(signature, old_signature)

        existing = run(
            "issue",
            "--agent-id",
            "test-worker",
            "--name",
            "Test Worker",
            "--origin",
            ORIGIN,
            "--runtime-version",
            "0.1.0-alpha.4",
            "--sequence",
            "2",
            "--key",
            str(key),
            "--output",
            str(proof),
            expected=2,
        )
        assert "use --replace" in existing.stderr

        issued_two = issue(key, proof, 2, replace=True)
        verified_two = json.loads(
            verify(manifest, signature, previous=previous_one).stdout
        )
        assert issued_two["sequence"] == 2
        assert verified_two["sequence"] == 2
        previous_two = root / "previous-two.json"
        previous_two.write_text(json.dumps(verified_two), encoding="utf-8")

        rollback = verify(
            old_manifest,
            old_signature,
            previous=previous_two,
            expected=2,
        )
        assert "rolls back" in rollback.stderr

        issue(
            key,
            proof,
            2,
            name="Conflicting Worker",
            replace=True,
        )
        conflict = verify(
            manifest,
            signature,
            previous=previous_two,
            expected=2,
        )
        assert "conflicts" in conflict.stderr

        issue(key, proof, 3, replace=True)
        untampered = manifest.read_text(encoding="utf-8")
        manifest.write_text(
            untampered.replace("Test Worker", "Bent Worker"),
            encoding="utf-8",
        )
        tampered = verify(manifest, signature, expected=2)
        assert "signature verification failed" in tampered.stderr
        manifest.write_text(untampered, encoding="utf-8")

        wrong_origin = run(
            "verify-files",
            str(manifest),
            str(signature),
            "--expected-origin",
            "https://other.example/",
            expected=2,
        )
        assert "differs from the expected origin" in wrong_origin.stderr

        expires_at = json.loads(manifest.read_text(encoding="utf-8"))["expires_at"]
        expiry = dt.datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
        after_expiry = (expiry + dt.timedelta(seconds=1)).strftime(
            "%Y-%m-%dT%H:%M:%SZ"
        )
        expired = verify(
            manifest,
            signature,
            at=after_expiry,
            expected=2,
        )
        assert "has expired" in expired.stderr

        verified_three = json.loads(verify(manifest, signature).stdout)
        previous_three = root / "previous-three.json"
        previous_three.write_text(json.dumps(verified_three), encoding="utf-8")
        issue(key, proof, 4, status="revoked", replace=True)
        revoked_result = verify(
            manifest,
            signature,
            previous=previous_three,
            expected=4,
        )
        revoked = json.loads(revoked_result.stdout)
        assert revoked["eligible"] is False
        assert revoked["status"] == "revoked"
        previous_revoked = root / "previous-revoked.json"
        previous_revoked.write_text(json.dumps(revoked), encoding="utf-8")

        issue(key, proof, 5, replace=True)
        reactivated = verify(
            manifest,
            signature,
            previous=previous_revoked,
            expected=2,
        )
        assert "cannot reactivate automatically" in reactivated.stderr

        signature_copy = root / "signature-copy"
        shutil.copy2(signature, signature_copy)
        signature.unlink()
        signature.symlink_to(signature_copy)
        symlinked = verify(manifest, signature, expected=2)
        assert "regular, nonsymlink" in symlinked.stderr
        signature.unlink()
        shutil.copy2(signature_copy, signature)

        os.chmod(key, 0o644)
        unsafe_key = run(
            "issue",
            "--agent-id",
            "other-worker",
            "--name",
            "Other Worker",
            "--origin",
            "https://other.example/",
            "--runtime-version",
            "0.1.0-alpha.4",
            "--sequence",
            "1",
            "--key",
            str(key),
            "--output",
            str(root / "other-proof"),
            expected=2,
        )
        assert "group or others" in unsafe_key.stderr

        ip_origin = run(
            "verify-origin",
            "https://127.0.0.1/",
            expected=2,
        )
        assert "DNS name, not an IP address" in ip_origin.stderr

    print("PASS signed WYWA registry origin proof")


if __name__ == "__main__":
    main()
