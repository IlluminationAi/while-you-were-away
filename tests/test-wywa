#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "$repo_dir"
wywa=$repo_dir/bin/wywa
test_root=$(mktemp -d)

cleanup() {
  chmod -R u+rwX -- "$test_root" 2>/dev/null || true
  rm -rf -- "$test_root"
}
trap cleanup EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

expect_status() {
  local expected=$1
  shift
  set +e
  "$@" >"$test_root/stdout" 2>"$test_root/stderr"
  local actual=$?
  set -e
  [[ "$actual" -eq "$expected" ]] ||
    fail "expected status $expected, got $actual: $*"
}

mkdir -p -- "$test_root/home/fake" "$test_root/state"
export HOME=$test_root/home
export XDG_STATE_HOME=$test_root/unused-xdg-state
export WYWA_STATE_ROOT=$test_root/state

fake_codex=$test_root/fake-codex
cat >"$fake_codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

fake_root=$HOME/fake
if [[ "${1:-}" == --version ]]; then
  if [[ -f "$fake_root/version" ]]; then
    cat -- "$fake_root/version"
  else
    printf '%s\n' "codex-cli 0.145.0"
  fi
  exit 0
fi
if [[ "${1:-}" == login && "${2:-}" == status ]]; then
  if [[ -f "$fake_root/login-fail" ]]; then
    exit 1
  fi
  exit 0
fi

env | sort >"$fake_root/environment"
printf '%s\n' "$@" >"$fake_root/arguments"
arguments=("$@")
workspace=
for ((index = 0; index < ${#arguments[@]}; index++)); do
  if [[ "${arguments[$index]}" == --cd ]]; then
    workspace=${arguments[$((index + 1))]}
    break
  fi
done

mode=success
[[ ! -f "$fake_root/mode" ]] || mode=$(<"$fake_root/mode")
case "$mode" in
  sleep)
    sleep 5
    ;;
  hold)
    : >"$fake_root/hold-entered"
    sleep 2
    ;;
esac

output_file=
while [[ $# -gt 0 ]]; do
  if [[ "$1" == --output-last-message ]]; then
    output_file=$2
    break
  fi
  shift
done

if [[ "$mode" == success || "$mode" == partial || "$mode" == hold ]]; then
  [[ -n "$output_file" ]] || exit 91
  if [[ -f "$fake_root/message" ]]; then
    cp -- "$fake_root/message" "$output_file"
  else
    printf '%s\n' "cycle complete" >"$output_file"
  fi
fi

if [[ ( "$mode" == success || "$mode" == hold ) &&
      -f "$fake_root/workspace-file" ]]; then
  [[ -n "$workspace" ]] || exit 92
  workspace_relative_path=cycle-artifact.txt
  if [[ -f "$fake_root/workspace-relative-path" ]]; then
    workspace_relative_path=$(<"$fake_root/workspace-relative-path")
  fi
  cp -- "$fake_root/workspace-file" "$workspace/$workspace_relative_path"
fi

if [[ "$mode" == success && -f "$fake_root/workspace-spray" ]]; then
  read -r spray_count spray_size <"$fake_root/workspace-spray"
  [[ "$spray_count" =~ ^[0-9]+$ && "$spray_size" =~ ^[0-9]+$ ]] || exit 93
  mkdir -p -- "$workspace/budget-spray"
  for spray_index in $(seq 1 "$spray_count"); do
    truncate -s "$spray_size" \
      "$workspace/budget-spray/item-$spray_index.bin"
  done
fi

if [[ -f "$fake_root/events" ]]; then
  cat -- "$fake_root/events"
else
  printf '%s\n' \
    '{"type":"thread.started","thread_id":"fake-thread"}' \
    '{"type":"turn.started"}' \
    '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"fake result"}}' \
    '{"type":"turn.completed","usage":{"input_tokens":1,"cached_input_tokens":0,"output_tokens":1}}'
fi
if [[ -f "$fake_root/diagnostics" ]]; then
  cat -- "$fake_root/diagnostics" >&2
fi

if [[ -f "$fake_root/exit-status" ]]; then
  exit "$(<"$fake_root/exit-status")"
fi
exit 0
EOF
chmod 0755 -- "$fake_codex"
export WYWA_CODEX_BIN=$fake_codex

fake_systemctl=$test_root/fake-systemctl
cat >"$fake_systemctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$HOME/fake/systemctl-arguments"
EOF
chmod 0755 -- "$fake_systemctl"

fake_loginctl=$test_root/fake-loginctl
cat >"$fake_loginctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ -f "$HOME/fake/linger-no" ]]; then
  printf '%s\n' no
else
  printf '%s\n' yes
fi
EOF
chmod 0755 -- "$fake_loginctl"

workspace=$test_root/worker
"$wywa" init "$workspace" >"$test_root/init-output"
[[ -f "$workspace/MANDATE.md" ]] || fail "init omitted MANDATE.md"
[[ -f "$workspace/inbox/.gitkeep" ]] || fail "init omitted inbox sentinel"
[[ "$(stat -c %a "$workspace/MANDATE.md")" == 600 ]] ||
  fail "workspace files are not private"
[[ -z "$(git -C "$workspace" status --porcelain)" ]] ||
  fail "initialized workspace is not clean"
[[ "$(git -C "$workspace" rev-list --count HEAD)" == 1 ]] ||
  fail "init did not create exactly one checkpoint"

mkdir -p -- "$test_root/nonempty"
printf '%s\n' "keep" >"$test_root/nonempty/file"
expect_status 2 "$wywa" init "$test_root/nonempty"
[[ "$(<"$test_root/nonempty/file")" == keep ]] ||
  fail "init modified a non-empty target"

mkdir -p -- "$test_root/failing-find-bin"
cat >"$test_root/failing-find-bin/find" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "/synthetic-entry"
exit 1
EOF
chmod 0755 -- "$test_root/failing-find-bin/find"
expect_status 2 env \
  PATH="$test_root/failing-find-bin:$PATH" \
  "$wywa" init "$test_root/nonempty"
grep -q 'unable to inspect target directory safely' "$test_root/stderr" ||
  fail "init did not report an indeterminate directory inspection"
[[ "$(<"$test_root/nonempty/file")" == keep ]] ||
  fail "init modified a target after directory inspection failed"

ln -s -- "$workspace" "$test_root/workspace-link"
expect_status 2 "$wywa" doctor "$test_root/workspace-link"
grep -q 'workspace must not be a symbolic link' "$test_root/stderr" ||
  fail "doctor canonicalized a workspace symlink before rejecting it"

if (( EUID == 0 )); then
  unset WYWA_ALLOW_ROOT || true
  expect_status 2 "$wywa" doctor "$workspace"
fi
export WYWA_ALLOW_ROOT=1

ln -s -- "$test_root" "$test_root/bad-state-link"
expect_status 2 env \
  WYWA_ALLOW_ROOT=1 \
  WYWA_CODEX_BIN="$fake_codex" \
  WYWA_STATE_ROOT="$test_root/bad-state-link" \
  HOME="$HOME" \
  "$wywa" doctor "$workspace"

"$wywa" doctor "$workspace" >"$test_root/doctor-output" 2>"$test_root/doctor-error"
grep -q '^doctor: ok ' "$test_root/doctor-output" ||
  fail "doctor did not report success"

printf '%s\n' "codex-cli 0.137.0" >"$HOME/fake/version"
expect_status 2 "$wywa" doctor "$workspace"
grep -q '0.145.0 is the reviewed unattended capability boundary' \
  "$test_root/stderr" ||
  fail "doctor accepted an older unreviewed Codex tool surface"
printf '%s\n' "codex-cli 0.146.0" >"$HOME/fake/version"
expect_status 2 "$wywa" doctor "$workspace"
grep -q '0.145.0 is the reviewed unattended capability boundary' \
  "$test_root/stderr" ||
  fail "doctor accepted a newer unreviewed Codex tool surface"
rm -f -- "$HOME/fake/version"

touch "$HOME/fake/login-fail"
expect_status 2 "$wywa" doctor "$workspace"
rm -f -- "$HOME/fake/login-fail"

mkdir -- "$workspace/.codex"
expect_status 2 "$wywa" doctor "$workspace"
grep -q 'workspace-local Codex configuration is forbidden' \
  "$test_root/stderr" ||
  fail "doctor accepted workspace-local Codex configuration"
rmdir -- "$workspace/.codex"

"$wywa" run "$workspace" --max-runtime 2m --dry-run \
  >"$test_root/dry-run-output" 2>"$test_root/dry-run-error"
grep -q '^permissions: wywa-workspace-only$' "$test_root/dry-run-output" ||
  fail "dry run omitted the permission-profile boundary"
grep -q '^filesystem: workspace writable; other paths unreadable' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the deny-read filesystem boundary"
grep -Fqx 'local command network: disabled' "$test_root/dry-run-output" ||
  fail "dry run omitted the local command network boundary"
grep -Fqx \
  'hosted web search: live; only non-shell external tool' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the separate hosted web search capability"
grep -Fqx \
  'extensions: apps, plugins, hooks, browsers, and subagents disabled' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the extension boundary"
grep -Fqx \
  'configuration: user config and project rules ignored; workspace-local .codex forbidden' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the configuration boundary"
grep -Fqx 'approvals: never; session persistence: ephemeral' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the approval and persistence boundary"
grep -Fqx \
  'output ceilings: events=16777216 bytes diagnostics=4194304 bytes final-message=65536 bytes' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the evidence output ceilings"
grep -Fqx \
  'checkpoint acceptance: at most 134217728 logical bytes and 4096 workspace paths' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the aggregate checkpoint budget"
grep -Fqx \
  'live workspace storage: unbounded by WYWA; checkpoint gate is post-turn' \
  "$test_root/dry-run-output" ||
  fail "dry run hid the missing live workspace storage bound"
grep -q '^maximum runtime: 2m$' "$test_root/dry-run-output" ||
  fail "dry run omitted the runtime bound"

export SECRET_SENTINEL=must-not-reach-child
printf '%s\n' "first verified result" >"$HOME/fake/message"
printf '%s\n' success >"$HOME/fake/mode"
printf '%s\n' "generated and verified by the cycle" >"$HOME/fake/workspace-file"
"$wywa" run "$workspace" --max-runtime 2m \
  >"$test_root/run-output" 2>"$test_root/run-error"
rm -f -- "$HOME/fake/workspace-file"

grep -q '^--ignore-user-config$' "$HOME/fake/arguments" ||
  fail "run did not isolate unattended configuration"
grep -q '^--ignore-rules$' "$HOME/fake/arguments" ||
  fail "run did not ignore user and project command rules"
grep -q '^--ephemeral$' "$HOME/fake/arguments" ||
  fail "run did not disable Codex session persistence"
grep -q '^--json$' "$HOME/fake/arguments" ||
  fail "run did not request a machine-auditable JSON event stream"
grep -Fqx 'default_permissions="wywa-workspace-only"' \
  "$HOME/fake/arguments" ||
  fail "run did not select the workspace-only permission profile"
grep -Fqx \
  'permissions.wywa-workspace-only.extends=":workspace"' \
  "$HOME/fake/arguments" ||
  fail "run did not retain the built-in workspace protections"
grep -Fqx \
  'permissions.wywa-workspace-only.filesystem={":root"="deny",":minimal"="read",":tmpdir"="deny",":slash_tmp"="deny"}' \
  "$HOME/fake/arguments" ||
  fail "run did not deny reads outside the workspace"
grep -Fqx \
  'permissions.wywa-workspace-only.network.enabled=false' \
  "$HOME/fake/arguments" ||
  fail "run did not explicitly disable local command network access"
grep -Fxq -- '--search' "$HOME/fake/arguments" ||
  fail "run omitted the declared hosted web search capability"
for capability_override in \
  'approval_policy="never"' \
  'features.apps=false' \
  'features.plugins=false' \
  'features.remote_plugin=false' \
  'features.plugin_sharing=false' \
  'features.hooks=false' \
  'features.auth_elicitation=false' \
  'features.tool_call_mcp_elicitation=false' \
  'features.browser_use=false' \
  'features.browser_use_external=false' \
  'features.browser_use_full_cdp_access=false' \
  'features.computer_use=false' \
  'features.image_generation=false' \
  'features.in_app_browser=false' \
  'features.multi_agent=false' \
  'agents.enabled=false' \
  'features.goals=false' \
  'features.guardian_approval=false' \
  'features.skill_mcp_dependency_install=false' \
  'features.skill_search=false' \
  'features.tool_suggest=false' \
  'features.workspace_dependencies=false'
do
  grep -Fqx "$capability_override" "$HOME/fake/arguments" ||
    fail "run omitted capability override: $capability_override"
done
if grep -q '^--sandbox$' "$HOME/fake/arguments"; then
  fail "run mixed the legacy sandbox with the permission profile"
fi
if grep -q 'dangerously-bypass' "$HOME/fake/arguments"; then
  fail "run used a dangerous Codex bypass"
fi
if grep -q 'SECRET_SENTINEL' "$HOME/fake/environment"; then
  fail "run leaked an unrelated environment secret"
fi
[[ "$(<"$workspace/cycle-artifact.txt")" == \
  "generated and verified by the cycle" ]] ||
  fail "successful cycle did not preserve its workspace artifact"
[[ "$(git -C "$workspace" rev-list --count HEAD)" == 2 ]] ||
  fail "host checkpoint did not commit the successful cycle"
[[ -z "$(git -C "$workspace" status --porcelain)" ]] ||
  fail "host checkpoint did not leave a clean tree"
grep -q '^Checkpoint WYWA cycle ' \
  < <(git -C "$workspace" log -1 --format=%s) ||
  fail "host checkpoint used an unexpected commit message"

runtime_dir=$(find "$WYWA_STATE_ROOT" -mindepth 1 -maxdepth 1 -type d -print)
[[ -n "$runtime_dir" && "$runtime_dir" != "$workspace"* ]] ||
  fail "runtime state was not isolated from the workspace"
[[ "$(stat -c %a "$runtime_dir")" == 700 ]] ||
  fail "runtime directory is not private"
grep -q 'status=0 permissions=wywa-workspace-only' "$runtime_dir/last-run" ||
  fail "successful receipt is missing or malformed"
grep -Eq 'checkpoint=[0-9a-f]{12}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the host checkpoint"
receipt_commit=$(git -C "$workspace" rev-parse HEAD)
receipt_tree=$(git -C "$workspace" rev-parse 'HEAD^{tree}')
grep -Fq "receipt=9" "$runtime_dir/last-run" ||
  fail "successful receipt omitted its schema version"
grep -Fq "local_network=disabled web_search=live" "$runtime_dir/last-run" ||
  fail "successful receipt omitted its split network capabilities"
grep -Fq \
  "apps=disabled plugins=disabled hooks=disabled subagents=disabled project_config=absent approval=never persistence=ephemeral" \
  "$runtime_dir/last-run" ||
  fail "successful receipt omitted its extension and configuration boundary"
grep -Fq \
  "events=wywa-v1 event_counts=agent_message:1,reasoning:0,command_execution:0,file_change:0,web_search:0,todo_list:0,plan:0,image_view:0,context_compaction:0" \
  "$runtime_dir/last-run" ||
  fail "successful receipt omitted its audited event counts"
grep -Fq \
  "child_file_bytes_max=16777216 event_bytes_max=16777216 diagnostics_bytes_max=4194304 message_bytes_max=65536" \
  "$runtime_dir/last-run" ||
  fail "successful receipt omitted its enforced output ceilings"
grep -Eq \
  'checkpoint_bytes_max=134217728 checkpoint_paths_max=4096 input_bytes=[0-9]+ input_paths=[0-9]+ tree_bytes=[0-9]+ tree_entries=[0-9]+' \
  "$runtime_dir/last-run" ||
  fail "successful receipt omitted its aggregate checkpoint evidence"
grep -Fq \
  'workspace_storage=unbounded storage_bytes_max=unverified storage_inodes_max=unverified' \
  "$runtime_dir/last-run" ||
  fail "successful receipt invented a live workspace storage bound"
grep -Fq "commit=$receipt_commit" "$runtime_dir/last-run" ||
  fail "successful receipt omitted the exact commit"
grep -Fq "tree=$receipt_tree" "$runtime_dir/last-run" ||
  fail "successful receipt omitted the exact tree"
grep -Eq 'log_sha256=[0-9a-f]{64}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the private log digest"
grep -Eq 'diagnostics_sha256=[0-9a-f]{64}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the private diagnostics digest"
grep -Eq 'message_sha256=[0-9a-f]{64}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the final-message digest"
grep -q '^first verified result$' "$runtime_dir/last-message.txt" ||
  fail "successful final message was not published"
"$wywa" verify-receipt "$workspace" >"$test_root/verify-receipt-output"
grep -Fq "receipt: verified commit=${receipt_commit:0:12}" \
  "$test_root/verify-receipt-output" ||
  fail "verify-receipt did not verify the successful checkpoint"

cp -- "$runtime_dir/last-run" "$test_root/version-9-capabilities.saved"
sed \
  's/local_network=disabled/local_network=enabled/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected local network capability' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed local network capability"
sed \
  's/web_search=live/web_search=disabled/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected hosted web search capability' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed hosted web search capability"
sed \
  's/apps=disabled/apps=enabled/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected app capability' "$test_root/stderr" ||
  fail "verify-receipt accepted enabled apps"
sed \
  's/approval=never/approval=on-request/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected approval posture' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed approval posture"
sed \
  's/events=wywa-v1/events=unreviewed/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected event-audit policy' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed event-audit policy"
sed \
  's/child_file_bytes_max=16777216/child_file_bytes_max=33554432/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected child file ceiling' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed child file ceiling"
sed \
  's/checkpoint_bytes_max=134217728/checkpoint_bytes_max=268435456/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'unexpected checkpoint byte budget' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed checkpoint byte budget"
sed \
  's/tree_bytes=[0-9]*/tree_bytes=0/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'checkpoint tree bytes do not match' "$test_root/stderr" ||
  fail "verify-receipt accepted changed checkpoint tree usage"
sed \
  's/workspace_storage=unbounded/workspace_storage=filesystem/' \
  "$test_root/version-9-capabilities.saved" >"$runtime_dir/last-run"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'malformed filesystem bytes' "$test_root/stderr" ||
  fail "verify-receipt accepted an invented live storage bound"
mv -- "$test_root/version-9-capabilities.saved" "$runtime_dir/last-run"

cp -- "$runtime_dir/last-run" "$test_root/version-9-receipt.saved"
sed \
  -e 's/receipt=9 /receipt=8 /' \
  -e 's/ workspace_storage=[^ ]* storage_bytes_max=[^ ]* storage_inodes_max=[^ ]*//' \
  "$test_root/version-9-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/version-8-receipt-output"
grep -Fq 'workspace_storage=unrecorded storage_bytes_max=unrecorded' \
  "$test_root/version-8-receipt-output" ||
  fail "verify-receipt invented a storage bound for a version-8 receipt"

cp -- "$runtime_dir/last-run" "$test_root/version-8-receipt.saved"
sed \
  -e 's/receipt=8 /receipt=7 /' \
  -e 's/ checkpoint_bytes_max=[^ ]* checkpoint_paths_max=[^ ]* input_bytes=[^ ]* input_paths=[^ ]* tree_bytes=[^ ]* tree_entries=[^ ]*//' \
  "$test_root/version-8-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/version-7-receipt-output"
grep -Fq 'checkpoint_bytes_max=unrecorded checkpoint_paths_max=unrecorded' \
  "$test_root/version-7-receipt-output" ||
  fail "verify-receipt invented a checkpoint budget for a version-7 receipt"

cp -- "$runtime_dir/last-run" "$test_root/version-7-receipt.saved"
sed \
  -e 's/receipt=7 /receipt=6 /' \
  -e 's/ child_file_bytes_max=[^ ]* event_bytes_max=[^ ]* diagnostics_bytes_max=[^ ]* message_bytes_max=[^ ]*//' \
  "$test_root/version-7-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/version-6-receipt-output"
grep -Fq 'child_file_bytes_max=unrecorded event_bytes_max=unrecorded' \
  "$test_root/version-6-receipt-output" ||
  fail "verify-receipt invented output ceilings for a version-6 receipt"

cp -- "$runtime_dir/last-run" "$test_root/version-6-receipt.saved"
sed \
  -e 's/receipt=6 /receipt=5 /' \
  -e 's/ events=wywa-v1 event_counts=[^ ]*//' \
  -e 's/ diagnostics_sha256=[^ ]*//' \
  -e 's/ diagnostics=[^ ]*//' \
  "$test_root/version-6-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/version-5-receipt-output"
grep -Fq 'events=unrecorded event_counts=unrecorded' \
  "$test_root/version-5-receipt-output" ||
  fail "verify-receipt invented an event audit for a version-5 receipt"

cp -- "$runtime_dir/last-run" "$test_root/version-5-receipt.saved"
sed \
  -e 's/receipt=5 /receipt=4 /' \
  -e 's/ apps=disabled plugins=disabled hooks=disabled subagents=disabled project_config=absent approval=never persistence=ephemeral//' \
  "$test_root/version-5-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/version-4-receipt-output"
grep -Fq 'apps=unrecorded plugins=unrecorded hooks=unrecorded subagents=unrecorded' \
  "$test_root/version-4-receipt-output" ||
  fail "verify-receipt invented extension capabilities for a version-4 receipt"

cp -- "$runtime_dir/last-run" "$test_root/version-4-receipt.saved"
sed \
  -e 's/receipt=4 /receipt=3 /' \
  -e 's/ local_network=disabled web_search=live//' \
  "$test_root/version-4-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/version-3-receipt-output"
grep -Fq 'local_network=unrecorded web_search=unrecorded' \
  "$test_root/version-3-receipt-output" ||
  fail "verify-receipt invented capabilities for a version-3 receipt"

cp -- "$runtime_dir/last-run" "$test_root/version-3-receipt.saved"
sed \
  's/receipt=3 status=0 permissions=wywa-workspace-only/receipt=2 status=0 sandbox=workspace-write/' \
  "$test_root/version-3-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/legacy-receipt-output"
