#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
cd -- "$repo_dir"
wywa=$repo_dir/bin/wywa
test_root=$(mktemp -d)

cleanup() {
  chmod -R u+rwX -- "$test_root" 2>/dev/null || true
  rm -rf -- "$test_root"
}
trap cleanup EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

expect_status() {
  local expected=$1
  shift
  set +e
  "$@" >"$test_root/stdout" 2>"$test_root/stderr"
  local actual=$?
  set -e
  [[ "$actual" -eq "$expected" ]] ||
    fail "expected status $expected, got $actual: $*"
}

mkdir -p -- "$test_root/home/fake" "$test_root/state"
export HOME=$test_root/home
export XDG_STATE_HOME=$test_root/unused-xdg-state
export WYWA_STATE_ROOT=$test_root/state

fake_codex=$test_root/fake-codex
cat >"$fake_codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

fake_root=$HOME/fake
if [[ "${1:-}" == --version ]]; then
  if [[ -f "$fake_root/version" ]]; then
    cat -- "$fake_root/version"
  else
    printf '%s\n' "codex-cli 0.145.0"
  fi
  exit 0
fi
if [[ "${1:-}" == login && "${2:-}" == status ]]; then
  if [[ -f "$fake_root/login-fail" ]]; then
    exit 1
  fi
  exit 0
fi

env | sort >"$fake_root/environment"
printf '%s\n' "$@" >"$fake_root/arguments"
arguments=("$@")
workspace=
for ((index = 0; index < ${#arguments[@]}; index++)); do
  if [[ "${arguments[$index]}" == --cd ]]; then
    workspace=${arguments[$((index + 1))]}
    break
  fi
done

mode=success
[[ ! -f "$fake_root/mode" ]] || mode=$(<"$fake_root/mode")
case "$mode" in
  sleep)
    sleep 5
    ;;
  hold)
    sleep 2
    ;;
esac

output_file=
while [[ $# -gt 0 ]]; do
  if [[ "$1" == --output-last-message ]]; then
    output_file=$2
    break
  fi
  shift
done

if [[ "$mode" == success || "$mode" == partial || "$mode" == hold ]]; then
  [[ -n "$output_file" ]] || exit 91
  if [[ -f "$fake_root/message" ]]; then
    cp -- "$fake_root/message" "$output_file"
  else
    printf '%s\n' "cycle complete" >"$output_file"
  fi
fi

if [[ ( "$mode" == success || "$mode" == hold ) &&
      -f "$fake_root/workspace-file" ]]; then
  [[ -n "$workspace" ]] || exit 92
  workspace_relative_path=cycle-artifact.txt
  if [[ -f "$fake_root/workspace-relative-path" ]]; then
    workspace_relative_path=$(<"$fake_root/workspace-relative-path")
  fi
  cp -- "$fake_root/workspace-file" "$workspace/$workspace_relative_path"
fi

if [[ -f "$fake_root/exit-status" ]]; then
  exit "$(<"$fake_root/exit-status")"
fi
exit 0
EOF
chmod 0755 -- "$fake_codex"
export WYWA_CODEX_BIN=$fake_codex

fake_systemctl=$test_root/fake-systemctl
cat >"$fake_systemctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$HOME/fake/systemctl-arguments"
EOF
chmod 0755 -- "$fake_systemctl"

fake_loginctl=$test_root/fake-loginctl
cat >"$fake_loginctl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ -f "$HOME/fake/linger-no" ]]; then
  printf '%s\n' no
else
  printf '%s\n' yes
fi
EOF
chmod 0755 -- "$fake_loginctl"

workspace=$test_root/worker
"$wywa" init "$workspace" >"$test_root/init-output"
[[ -f "$workspace/MANDATE.md" ]] || fail "init omitted MANDATE.md"
[[ -f "$workspace/inbox/.gitkeep" ]] || fail "init omitted inbox sentinel"
[[ "$(stat -c %a "$workspace/MANDATE.md")" == 600 ]] ||
  fail "workspace files are not private"
[[ -z "$(git -C "$workspace" status --porcelain)" ]] ||
  fail "initialized workspace is not clean"
[[ "$(git -C "$workspace" rev-list --count HEAD)" == 1 ]] ||
  fail "init did not create exactly one checkpoint"

mkdir -p -- "$test_root/nonempty"
printf '%s\n' "keep" >"$test_root/nonempty/file"
expect_status 2 "$wywa" init "$test_root/nonempty"
[[ "$(<"$test_root/nonempty/file")" == keep ]] ||
  fail "init modified a non-empty target"

mkdir -p -- "$test_root/failing-find-bin"
cat >"$test_root/failing-find-bin/find" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "/synthetic-entry"
exit 1
EOF
chmod 0755 -- "$test_root/failing-find-bin/find"
expect_status 2 env \
  PATH="$test_root/failing-find-bin:$PATH" \
  "$wywa" init "$test_root/nonempty"
grep -q 'unable to inspect target directory safely' "$test_root/stderr" ||
  fail "init did not report an indeterminate directory inspection"
[[ "$(<"$test_root/nonempty/file")" == keep ]] ||
  fail "init modified a target after directory inspection failed"

ln -s -- "$workspace" "$test_root/workspace-link"
expect_status 2 "$wywa" doctor "$test_root/workspace-link"
grep -q 'workspace must not be a symbolic link' "$test_root/stderr" ||
  fail "doctor canonicalized a workspace symlink before rejecting it"

if (( EUID == 0 )); then
  unset WYWA_ALLOW_ROOT || true
  expect_status 2 "$wywa" doctor "$workspace"
fi
export WYWA_ALLOW_ROOT=1

ln -s -- "$test_root" "$test_root/bad-state-link"
expect_status 2 env \
  WYWA_ALLOW_ROOT=1 \
  WYWA_CODEX_BIN="$fake_codex" \
  WYWA_STATE_ROOT="$test_root/bad-state-link" \
  HOME="$HOME" \
  "$wywa" doctor "$workspace"

"$wywa" doctor "$workspace" >"$test_root/doctor-output" 2>"$test_root/doctor-error"
grep -q '^doctor: ok ' "$test_root/doctor-output" ||
  fail "doctor did not report success"

printf '%s\n' "codex-cli 0.137.0" >"$HOME/fake/version"
expect_status 2 "$wywa" doctor "$workspace"
grep -q '0.138.0 or newer is required' "$test_root/stderr" ||
  fail "doctor accepted Codex without deny-read permission profiles"
rm -f -- "$HOME/fake/version"

touch "$HOME/fake/login-fail"
expect_status 2 "$wywa" doctor "$workspace"
rm -f -- "$HOME/fake/login-fail"

"$wywa" run "$workspace" --max-runtime 2m --dry-run \
  >"$test_root/dry-run-output" 2>"$test_root/dry-run-error"
grep -q '^permissions: wywa-workspace-only$' "$test_root/dry-run-output" ||
  fail "dry run omitted the permission-profile boundary"
grep -q '^filesystem: workspace writable; other paths unreadable' \
  "$test_root/dry-run-output" ||
  fail "dry run omitted the deny-read filesystem boundary"
grep -q '^maximum runtime: 2m$' "$test_root/dry-run-output" ||
  fail "dry run omitted the runtime bound"

export SECRET_SENTINEL=must-not-reach-child
printf '%s\n' "first verified result" >"$HOME/fake/message"
printf '%s\n' success >"$HOME/fake/mode"
printf '%s\n' "generated and verified by the cycle" >"$HOME/fake/workspace-file"
"$wywa" run "$workspace" --max-runtime 2m \
  >"$test_root/run-output" 2>"$test_root/run-error"
rm -f -- "$HOME/fake/workspace-file"

grep -q '^--ignore-user-config$' "$HOME/fake/arguments" ||
  fail "run did not isolate unattended configuration"
grep -Fqx 'default_permissions="wywa-workspace-only"' \
  "$HOME/fake/arguments" ||
  fail "run did not select the workspace-only permission profile"
grep -Fqx \
  'permissions.wywa-workspace-only.extends=":workspace"' \
  "$HOME/fake/arguments" ||
  fail "run did not retain the built-in workspace protections"
grep -Fqx \
  'permissions.wywa-workspace-only.filesystem={":root"="deny",":minimal"="read",":tmpdir"="deny",":slash_tmp"="deny"}' \
  "$HOME/fake/arguments" ||
  fail "run did not deny reads outside the workspace"
if grep -q '^--sandbox$' "$HOME/fake/arguments"; then
  fail "run mixed the legacy sandbox with the permission profile"
fi
if grep -q 'dangerously-bypass' "$HOME/fake/arguments"; then
  fail "run used a dangerous Codex bypass"
fi
if grep -q 'SECRET_SENTINEL' "$HOME/fake/environment"; then
  fail "run leaked an unrelated environment secret"
fi
[[ "$(<"$workspace/cycle-artifact.txt")" == \
  "generated and verified by the cycle" ]] ||
  fail "successful cycle did not preserve its workspace artifact"
[[ "$(git -C "$workspace" rev-list --count HEAD)" == 2 ]] ||
  fail "host checkpoint did not commit the successful cycle"
[[ -z "$(git -C "$workspace" status --porcelain)" ]] ||
  fail "host checkpoint did not leave a clean tree"
grep -q '^Checkpoint WYWA cycle ' \
  < <(git -C "$workspace" log -1 --format=%s) ||
  fail "host checkpoint used an unexpected commit message"

runtime_dir=$(find "$WYWA_STATE_ROOT" -mindepth 1 -maxdepth 1 -type d -print)
[[ -n "$runtime_dir" && "$runtime_dir" != "$workspace"* ]] ||
  fail "runtime state was not isolated from the workspace"
[[ "$(stat -c %a "$runtime_dir")" == 700 ]] ||
  fail "runtime directory is not private"
grep -q 'status=0 permissions=wywa-workspace-only' "$runtime_dir/last-run" ||
  fail "successful receipt is missing or malformed"
grep -Eq 'checkpoint=[0-9a-f]{12}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the host checkpoint"
receipt_commit=$(git -C "$workspace" rev-parse HEAD)
receipt_tree=$(git -C "$workspace" rev-parse 'HEAD^{tree}')
grep -Fq "receipt=3" "$runtime_dir/last-run" ||
  fail "successful receipt omitted its schema version"
grep -Fq "commit=$receipt_commit" "$runtime_dir/last-run" ||
  fail "successful receipt omitted the exact commit"
grep -Fq "tree=$receipt_tree" "$runtime_dir/last-run" ||
  fail "successful receipt omitted the exact tree"
grep -Eq 'log_sha256=[0-9a-f]{64}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the private log digest"
grep -Eq 'message_sha256=[0-9a-f]{64}' "$runtime_dir/last-run" ||
  fail "successful receipt omitted the final-message digest"
grep -q '^first verified result$' "$runtime_dir/last-message.txt" ||
  fail "successful final message was not published"
"$wywa" verify-receipt "$workspace" >"$test_root/verify-receipt-output"
grep -Fq "receipt: verified commit=${receipt_commit:0:12}" \
  "$test_root/verify-receipt-output" ||
  fail "verify-receipt did not verify the successful checkpoint"

cp -- "$runtime_dir/last-run" "$test_root/version-3-receipt.saved"
sed \
  's/receipt=3 status=0 permissions=wywa-workspace-only/receipt=2 status=0 sandbox=workspace-write/' \
  "$test_root/version-3-receipt.saved" >"$runtime_dir/last-run"
"$wywa" verify-receipt "$workspace" >"$test_root/legacy-receipt-output"
grep -Fq 'permissions=legacy-workspace-write' \
  "$test_root/legacy-receipt-output" ||
  fail "verify-receipt did not preserve version-2 compatibility"
mv -- "$test_root/version-3-receipt.saved" "$runtime_dir/last-run"

cp -- "$runtime_dir/last-message.txt" "$test_root/last-message.saved"
printf '%s\n' "tampered result" >"$runtime_dir/last-message.txt"
expect_status 2 "$wywa" verify-receipt "$workspace"
grep -q 'final-message digest does not match' "$test_root/stderr" ||
  fail "verify-receipt accepted a changed final message"
mv -- "$test_root/last-message.saved" "$runtime_dir/last-message.txt"

"$wywa" status "$workspace" >"$test_root/status-output"
grep -q '^last run: .*status=0 permissions=wywa-workspace-only' \
  "$test_root/status-output" ||
  fail "status omitted the successful receipt"
grep -q '^first verified result$' "$test_root/status-output" ||
  fail "status omitted the final message"

printf '%s\n' fail >"$HOME/fake/mode"
printf '%s\n' 23 >"$HOME/fake/exit-status"
expect_status 23 "$wywa" run "$workspace" --max-runtime 2m
grep -q 'status=23 permissions=wywa-workspace-only' "$runtime_dir/last-run" ||
  fail "failed receipt did not preserve the child status"
expect_status 4 "$wywa" verify-receipt "$workspace"
grep -q 'last run was not successful' "$test_root/stderr" ||
  fail "verify-receipt did not distinguish a failed run"
grep -q '^first verified result$' "$runtime_dir/last-message.txt" ||
  fail "failed run replaced the previous canonical message"

printf '%s\n' partial >"$HOME/fake/mode"
printf '%s\n' "partial failure output" >"$HOME/fake/message"
expect_status 23 "$wywa" run "$workspace" --max-runtime 2m
grep -q '^first verified result$' "$runtime_dir/last-message.txt" ||
  fail "partial failure output replaced the canonical message"

rm -f -- "$HOME/fake/exit-status"
printf '%s\n' sleep >"$HOME/fake/mode"
expect_status 124 "$wywa" run "$workspace" --max-runtime 1s
grep -q 'status=124 permissions=wywa-workspace-only' "$runtime_dir/last-run" ||
  fail "timeout receipt is missing"
grep -q '^first verified result$' "$runtime_dir/last-message.txt" ||
  fail "timeout replaced the previous canonical message"

printf '%s\n' hold >"$HOME/fake/mode"
printf '%s\n' "held-cycle progress" >"$HOME/fake/workspace-file"
printf '%s\n' "held-cycle.txt" >"$HOME/fake/workspace-relative-path"
set +e
"$wywa" run "$workspace" --max-runtime 10s \
  >"$test_root/held-run-output" 2>"$test_root/held-run-error" &
held_pid=$!
set -e

lock_file=$runtime_dir/cycle.lock
lock_observed=0
for _ in $(seq 1 80); do
  if [[ -f "$lock_file" ]] &&
    ! flock -n "$lock_file" -c true 2>/dev/null; then
    lock_observed=1
    break
  fi
  sleep 0.05
done
[[ "$lock_observed" == 1 ]] || fail "did not observe the held cycle lock"
expect_status 75 "$wywa" run "$workspace" --max-runtime 10s
wait "$held_pid" || fail "held cycle did not complete successfully"
rm -f -- \
  "$HOME/fake/workspace-file" \
  "$HOME/fake/workspace-relative-path"

if pgrep -f "$fake_codex" >/dev/null 2>&1; then
  fail "fake Codex process remained after lifecycle tests"
fi

rm -f -- "$HOME/fake/exit-status"
printf '%s\n' success >"$HOME/fake/mode"
printf '%s\n' "scheduled result" >"$HOME/fake/message"
printf '%s\n' "scheduled progress" >"$HOME/fake/workspace-file"
printf '%s\n' "scheduled-cycle.txt" >"$HOME/fake/workspace-relative-path"

touch "$HOME/fake/linger-no"
expect_status 2 env -u WYWA_STATE_ROOT \
  WYWA_ALLOW_ROOT=1 \
  WYWA_CODEX_BIN="$fake_codex" \
  WYWA_SYSTEMCTL_BIN="$fake_systemctl" \
  WYWA_LOGINCTL_BIN="$fake_loginctl" \
  HOME="$HOME" \
  "$wywa" install-user "$workspace"
rm -f -- "$HOME/fake/linger-no"

env -u WYWA_STATE_ROOT \
  WYWA_ALLOW_ROOT=1 \
  WYWA_CODEX_BIN="$fake_codex" \
  WYWA_SYSTEMCTL_BIN="$fake_systemctl" \
  WYWA_LOGINCTL_BIN="$fake_loginctl" \
  HOME="$HOME" \
  "$wywa" install-user "$workspace" \
  >"$test_root/install-output" 2>"$test_root/install-error"

default_state_root=$HOME/.local/state/wywa
scheduled_runtime=$(find \
  "$default_state_root" \
  -mindepth 1 \
  -maxdepth 1 \
  -type d \
  -print)
scheduled_id=${scheduled_runtime##*/}
service_file=$HOME/.config/systemd/user/wywa-$scheduled_id.service
timer_file=$HOME/.config/systemd/user/wywa-$scheduled_id.timer
installed_wywa=$HOME/.local/lib/wywa/bin/wywa

[[ -x "$installed_wywa" ]] || fail "install-user omitted the worker binary"
[[ -f "$HOME/.local/lib/wywa/templates/MANDATE.md" ]] ||
  fail "install-user omitted reusable templates"
[[ "$(stat -c %a "$service_file")" == 600 ]] ||
  fail "installed service is not private"
[[ "$(stat -c %a "$timer_file")" == 600 ]] ||
  fail "installed timer is not private"
grep -Fq "run-state $scheduled_id" "$service_file" ||
  fail "installed service does not use the registered workspace id"
if grep -Fq "$workspace" "$service_file"; then
  fail "installed service exposes the workspace path"
fi
if grep -Eq '(SECRET_SENTINEL|OPENAI_API_KEY|CODEX_ACCESS_TOKEN)' \
  "$service_file" "$timer_file"; then
  fail "installed units contain credential material"
fi
grep -Fxq 'OnUnitInactiveSec=1h' "$timer_file" ||
  fail "installed timer is not completion-relative"
if grep -Eq '^(OnUnitActiveSec|Persistent)=' "$timer_file"; then
  fail "installed timer can catch up immediately after an overrun"
fi
grep -Fxq 'NoNewPrivileges=yes' "$service_file" ||
  fail "installed service omitted NoNewPrivileges"
if grep -Fxq 'PrivateTmp=yes' "$service_file"; then
  fail "installed service nests Codex inside an incompatible mount namespace"
fi
grep -Fxq -- '--user daemon-reload' "$HOME/fake/systemctl-arguments" ||
  fail "install-user omitted the daemon reload"
grep -Fxq -- "--user enable --now wywa-$scheduled_id.timer" \
  "$HOME/fake/systemctl-arguments" ||
  fail "install-user did not enable the timer"

systemd-analyze verify "$service_file" "$timer_file" >/dev/null 2>&1 ||
  fail "installed user-unit syntax is invalid"

env -u WYWA_STATE_ROOT \
  WYWA_ALLOW_ROOT=1 \
  WYWA_CODEX_BIN="$fake_codex" \
  HOME="$HOME" \
  "$installed_wywa" run-state "$scheduled_id" \
  >"$test_root/run-state-output" 2>"$test_root/run-state-error"
grep -q '^scheduled result$' "$scheduled_runtime/last-message.txt" ||
  fail "installed run-state path did not complete a cycle"
rm -f -- \
  "$HOME/fake/workspace-file" \
  "$HOME/fake/workspace-relative-path"

env -u WYWA_STATE_ROOT \
  WYWA_ALLOW_ROOT=1 \
  WYWA_CODEX_BIN="$fake_codex" \
  WYWA_SYSTEMCTL_BIN="$fake_systemctl" \
  WYWA_LOGINCTL_BIN="$fake_loginctl" \
  HOME="$HOME" \
  "$installed_wywa" install-user "$workspace" \
  >"$test_root/reinstall-output" 2>"$test_root/reinstall-error"

env -u WYWA_STATE_ROOT \
  WYWA_ALLOW_ROOT=1 \
  WYWA_SYSTEMCTL_BIN="$fake_systemctl" \
  HOME="$HOME" \
  "$installed_wywa" uninstall-user "$workspace" \
  >"$test_root/uninstall-output" 2>"$test_root/uninstall-error"
[[ ! -e "$service_file" && ! -e "$timer_file" ]] ||
  fail "uninstall-user left unit sources behind"
[[ -d "$workspace" && -d "$scheduled_runtime" ]] ||
  fail "uninstall-user deleted workspace or runtime data"
grep -Fq -- "--user disable --now wywa-$scheduled_id.timer" \
  "$HOME/fake/systemctl-arguments" ||
  fail "uninstall-user did not disable the timer"

no_change_workspace=$test_root/no-change-worker
"$wywa" init "$no_change_workspace" >/dev/null
printf '%s\n' "must not publish" >"$HOME/fake/message"
expect_status 72 "$wywa" run "$no_change_workspace" --max-runtime 2m
no_change_id=$(printf '%s' "$no_change_workspace" | sha256sum | cut -c1-16)
no_change_runtime=$WYWA_STATE_ROOT/$no_change_id
grep -q 'status=72 .*checkpoint=none' "$no_change_runtime/last-run" ||
  fail "no-progress receipt is missing or malformed"
[[ ! -e "$no_change_runtime/last-message.txt" ]] ||
  fail "no-progress run published a canonical message"
[[ "$(git -C "$no_change_workspace" rev-list --count HEAD)" == 1 ]] ||
  fail "no-progress run created a commit"

secret_workspace=$test_root/secret-worker
"$wywa" init "$secret_workspace" >/dev/null
printf '%s\n' \
  '{"access_token":"abcdefghijklmnopqrstuvwxyz0123456789"}' \
  >"$HOME/fake/workspace-file"
printf '%s\n' "auth-copy.json" >"$HOME/fake/workspace-relative-path"
printf '%s\n' "must not publish" >"$HOME/fake/message"
expect_status 73 "$wywa" run "$secret_workspace" --max-runtime 2m
rm -f -- \
  "$HOME/fake/workspace-file" \
  "$HOME/fake/workspace-relative-path"
secret_id=$(printf '%s' "$secret_workspace" | sha256sum | cut -c1-16)
secret_runtime=$WYWA_STATE_ROOT/$secret_id
grep -q 'status=73 .*checkpoint=refused' "$secret_runtime/last-run" ||
  fail "credential refusal receipt is missing or malformed"
[[ ! -e "$secret_runtime/last-message.txt" ]] ||
  fail "credential refusal published a canonical message"
[[ "$(git -C "$secret_workspace" rev-list --count HEAD)" == 1 ]] ||
  fail "credential-like content was committed"
git -C "$secret_workspace" diff --cached --quiet ||
  fail "credential refusal left the Git index staged"
[[ -n "$(git -C "$secret_workspace" status --porcelain)" ]] ||
  fail "credential refusal discarded the uncommitted evidence"
if rg -q 'abcdefghijklmnopqrstuvwxyz0123456789' \
  "$secret_runtime/logs"; then
  fail "credential refusal copied suspected secret content into the log"
fi

printf '%s\n' "PASS: WYWA portable runtime"
