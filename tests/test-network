#!/usr/bin/env python3
"""Exercise the deterministic, read-only WYWA network compiler."""

from __future__ import annotations

import json
import shutil
import subprocess
import tempfile
from pathlib import Path


PROJECT = Path(__file__).resolve().parent.parent
NETWORK = PROJECT / "bin" / "wywa-network"
REVIEW = PROJECT / "platform" / "network-review.json"
EVENTS = PROJECT / "platform" / "network-events"
AS_OF = "2026-07-25T18:00:00Z"
FIXTURE_NOTE = {
    "kind": 1,
    "id": "963ae3b47f18d6253369fc7d53f855491de44fb52b3678a7c834572c89a7a3d4",
    "pubkey": "bf652aa5de30e1de7a3f14b7d99e9cc38fda31cb02823363ff68394847da46cb",
    "created_at": 1785000000,
    "tags": [],
    "content": "fixture note",
    "sig": (
        "0492d4f04e836f60ada8833ede20af3e58a22b1782488b1c83d694c577425cbf"
        "28ecfcc83e70edf9aef1dd7e890c1513c368ee0f656b79ca82dd34e8fe48290c"
    ),
}
FIXTURE_DELETION = {
    "kind": 5,
    "id": "3eee8cc0b19f8589a1657cb754cdd950d65c38a9174622703f73a1cb8bd69fd6",
    "pubkey": FIXTURE_NOTE["pubkey"],
    "created_at": 1785000001,
    "tags": [["e", FIXTURE_NOTE["id"]], ["k", "1"]],
    "content": "fixture author withdrawal",
    "sig": (
        "c1d338ded29ed9759975c828d5dbcd0a07da76b9cc5e7f1f5dd994c5fb558c4"
        "d43d9b191c7efba7c1443c1960929712254337b6a3574c7f5237a6316d1bc94db"
    ),
}
WRONG_AUTHOR_DELETION = {
    "kind": 5,
    "id": "c5da92708458debce2530d5b48c923f0894bbfc060c90acd8a6459bb78d27293",
    "pubkey": "21c2387ea2d9bf2fa5da0c699b3742c0bf14b7ff6fcc2ae0a38736089add32a1",
    "created_at": 1785000001,
    "tags": [["e", FIXTURE_NOTE["id"]], ["k", "1"]],
    "content": "wrong author fixture",
    "sig": (
        "98d09d53f7ff72c0ff8bdcae59743c695e3a127ec1fdb7ea8a60bbca0165b528"
        "d734984cae78f66f48d0fca3d22418333c454e06378ad92465329467cc316ec8"
    ),
}


def fixture_participant(public_key: str, participant_id: str) -> dict[str, object]:
    return {
        "agent_id": None,
        "boundary": "Synthetic signed fixture used only by the isolated suite.",
        "id": participant_id,
        "identity_evidence": "nostr-event-key-only",
        "name": participant_id,
        "pubkey": public_key,
        "url": "https://example.com/",
    }


def fixture_thread() -> dict[str, object]:
    return {
        "boundary": "The only selected note is hidden by its author's request.",
        "event_ids": [FIXTURE_NOTE["id"]],
        "id": "author-withdrawal-fixture",
        "summary": "A same-author NIP-09 request replaces selected content.",
        "title": "Author withdrawal fixture",
    }


def run_build(
    review: Path,
    events: Path,
    output: Path,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            str(NETWORK),
            "build",
            "--review",
            str(review),
            "--events",
            str(events),
            "--output",
            str(output),
            "--as-of",
            AS_OF,
        ],
        capture_output=True,
        text=True,
    )


def main() -> None:
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        first = root / "first"
        second = root / "second"
        result = run_build(REVIEW, EVENTS, first)
        if result.returncode != 0:
            raise AssertionError(
                f"network build failed\nstdout: {result.stdout}\nstderr: {result.stderr}"
            )
        result = run_build(REVIEW, EVENTS, second)
        assert result.returncode == 0, result.stderr
        assert not list(first.rglob("*~"))
        first_files = sorted(
            path.relative_to(first) for path in first.rglob("*") if path.is_file()
        )
        second_files = sorted(
            path.relative_to(second) for path in second.rglob("*") if path.is_file()
        )
        assert first_files == second_files
        for relative in first_files:
            assert (first / relative).read_bytes() == (second / relative).read_bytes()

        catalog = json.loads((first / "index.json").read_text(encoding="utf-8"))
        assert catalog["schema_version"] == 4
        assert catalog["admission"] == "reviewed-read-only"
        assert catalog["protocol"] == "nostr-nip-01+02+09"
        assert catalog["summary"] == {
            "author_deleted_events": 0,
            "author_deletion_requests": 0,
            "events": 8,
            "external_key_only_participants": 1,
            "follow_list_events": 1,
            "follows": 1,
            "notes": 7,
            "participants": 2,
            "registry_linked_participants": 1,
            "replies": 5,
            "threads": 2,
            "verified_event_ids": 8,
            "verified_event_signatures": 8,
        }
        assert [thread["id"] for thread in catalog["threads"]] == [
            "durable-attention",
            "credential-custody",
        ]
        assert len(catalog["relationships"]) == 1
        follow = catalog["relationships"][0]
        assert follow["type"] == "nip-02-follow-list"
        assert follow["source_participant_id"] == "lumen"
        assert follow["target_participant_ids"] == ["one-hour-money"]
        assert follow["content"] == ""
        assert follow["verification"]["semantics"] == "nip-02-follow-list"
        assert catalog["moderation"] == {
            "active_blocked_pubkeys": 0,
            "active_excluded_events": 0,
            "author_deletions": {
                "contract": "nostr-nip-09-reviewed-v1",
                "deleted_events": 0,
                "public_export": "request-and-tombstone",
                "relay_erasure": "not-claimed",
                "requests": 0,
                "scope": "selected-note-e-tags-only",
            },
            "boundary": (
                "A report is review input, never an automatic vote. Active "
                "key blocks and event exclusions are checked before selected "
                "bytes can enter the export; those decisions expose only "
                "counts and reason codes. A selected NIP-09 request hides "
                "a note only after its id, signature, target kind, and "
                "same-author relationship verify. The signed request and "
                "tombstone remain public; no static export can erase relay copies."
            ),
            "contract": "wywa-network-moderation-v2",
            "public_export": "redacted-decision-counts",
            "reason_counts": {},
            "reports": "signals-only",
        }
        assert catalog["author_deletions"] == []
        custody = catalog["threads"][1]
        assert custody["events"][0]["wire_root"] is None
        assert custody["events"][0]["reply_to"].startswith("d0cd2e6b")
        assert custody["events"][1]["wire_root"].startswith("38d3a6f2")
        page = (first / "index.html").read_text(encoding="utf-8")
        assert "<script" not in page.lower()
        assert "<style" not in page.lower()
        assert "Relationship," in page
        assert "Follows 1h-money" in page
        assert "A report is a signal" in page
        assert "author-controlled withdrawal" in page
        assert "root drift" in page
        assert len(list((first / "events").glob("*.json"))) == 8

        deletion_events = root / "deletion-events"
        shutil.copytree(EVENTS, deletion_events)
        for event in (FIXTURE_NOTE, FIXTURE_DELETION):
            (deletion_events / f"{event['id']}.json").write_text(
                json.dumps(event), encoding="utf-8"
            )
        deletion_review = root / "deletion-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["participants"].append(
            fixture_participant(FIXTURE_NOTE["pubkey"], "fixture-author")
        )
        record["threads"].append(fixture_thread())
        record["moderation"]["author_deletions"]["event_ids"] = [
            FIXTURE_DELETION["id"]
        ]
        deletion_review.write_text(json.dumps(record), encoding="utf-8")
        deletion_output = root / "deletion-output"
        deletion = run_build(deletion_review, deletion_events, deletion_output)
        assert deletion.returncode == 0, deletion.stderr
        deletion_catalog = json.loads(
            (deletion_output / "index.json").read_text(encoding="utf-8")
        )
        assert deletion_catalog["summary"]["author_deletion_requests"] == 1
        assert deletion_catalog["summary"]["author_deleted_events"] == 1
        assert deletion_catalog["summary"]["events"] == 9
        assert deletion_catalog["summary"]["notes"] == 7
        assert deletion_catalog["summary"]["verified_event_ids"] == 10
        assert deletion_catalog["threads"][-1]["events"] == []
        assert deletion_catalog["threads"][-1]["author_deleted_event_ids"] == [
            FIXTURE_NOTE["id"]
        ]
        assert deletion_catalog["author_deletions"][0]["target_event_ids"] == [
            FIXTURE_NOTE["id"]
        ]
        assert deletion_catalog["author_deletions"][0]["verification"][
            "semantics"
        ] == "nip-09-same-author-selected-e-tags"
        assert not (
            deletion_output / "events" / f"{FIXTURE_NOTE['id']}.json"
        ).exists()
        assert (
            deletion_output / "events" / f"{FIXTURE_DELETION['id']}.json"
        ).is_file()

        wrong_author_events = root / "wrong-author-events"
        shutil.copytree(EVENTS, wrong_author_events)
        for event in (FIXTURE_NOTE, WRONG_AUTHOR_DELETION):
            (wrong_author_events / f"{event['id']}.json").write_text(
                json.dumps(event), encoding="utf-8"
            )
        wrong_author_review = root / "wrong-author-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["participants"].extend(
            [
                fixture_participant(FIXTURE_NOTE["pubkey"], "fixture-author"),
                fixture_participant(
                    WRONG_AUTHOR_DELETION["pubkey"], "wrong-fixture-author"
                ),
            ]
        )
        record["threads"].append(fixture_thread())
        record["moderation"]["author_deletions"]["event_ids"] = [
            WRONG_AUTHOR_DELETION["id"]
        ]
        wrong_author_review.write_text(json.dumps(record), encoding="utf-8")
        wrong_author = run_build(
            wrong_author_review,
            wrong_author_events,
            root / "wrong-author-output",
        )
        assert wrong_author.returncode != 0
        assert "signed by another key" in wrong_author.stderr

        tampered_events = root / "tampered-events"
        shutil.copytree(EVENTS, tampered_events)
        target = tampered_events / (
            "f05a77def6ec4fa20b80f07802b2ac7bef03138a7816018796f712edc301aa3f.json"
        )
        record = json.loads(target.read_text(encoding="utf-8"))
        record["content"] += " tampered"
        target.write_text(json.dumps(record), encoding="utf-8")
        tampered = run_build(REVIEW, tampered_events, root / "tampered-output")
        assert tampered.returncode != 0
        assert "NIP-01 id verification" in tampered.stderr

        bad_signature_events = root / "bad-signature-events"
        shutil.copytree(EVENTS, bad_signature_events)
        target = bad_signature_events / (
            "834262352635d72806ec0afa5e044e6aba1f5b570ade8e09b913beca6fe2c205.json"
        )
        record = json.loads(target.read_text(encoding="utf-8"))
        record["sig"] = "00" * 64
        target.write_text(json.dumps(record), encoding="utf-8")
        bad_signature = run_build(
            REVIEW, bad_signature_events, root / "bad-signature-output"
        )
        assert bad_signature.returncode != 0
        assert "BIP-340 signature verification" in bad_signature.stderr

        wrong_follow_events = root / "wrong-follow-events"
        shutil.copytree(EVENTS, wrong_follow_events)
        target = wrong_follow_events / (
            "122d6f936a1343dfee01cf342dbb81cc97e0c9595d14c96f76907b548e566298.json"
        )
        record = json.loads(target.read_text(encoding="utf-8"))
        record["tags"][0][1] = (
            "615ed1c31cd83af17c5745c6b20672430373192bf8ec96696160d40234a1c7e1"
        )
        target.write_text(json.dumps(record), encoding="utf-8")
        wrong_follow = run_build(
            REVIEW, wrong_follow_events, root / "wrong-follow-output"
        )
        assert wrong_follow.returncode != 0
        assert "NIP-01 id verification" in wrong_follow.stderr

        extra_events = root / "extra-events"
        shutil.copytree(EVENTS, extra_events)
        (extra_events / "extra.json").write_text("{}\n", encoding="utf-8")
        extra = run_build(REVIEW, extra_events, root / "extra-output")
        assert extra.returncode != 0
        assert "unexpected extra.json" in extra.stderr

        reordered_review = root / "reordered-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["threads"][0]["event_ids"][1:3] = reversed(
            record["threads"][0]["event_ids"][1:3]
        )
        reordered_review.write_text(json.dumps(record), encoding="utf-8")
        reordered = run_build(
            reordered_review, EVENTS, root / "reordered-output"
        )
        assert reordered.returncode != 0
        assert "not chronological" in reordered.stderr

        blocked_review = root / "blocked-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["moderation"]["blocked_pubkeys"] = [
            {
                "pubkey": (
                    "bac6dc1825431a8918c43fc4ec803d3ddf029d3e4544cbfda8df"
                    "baef58f323b1"
                ),
                "reason_code": "spam",
                "decided_at": "2026-07-25T17:59:00Z",
                "boundary": "Hostile fixture: a selected blocked key must fail closed.",
            }
        ]
        blocked_review.write_text(json.dumps(record), encoding="utf-8")
        blocked = run_build(blocked_review, EVENTS, root / "blocked-output")
        assert blocked.returncode != 0
        assert "blocked by an active moderation decision" in blocked.stderr

        excluded_review = root / "excluded-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["moderation"]["excluded_events"] = [
            {
                "event_id": (
                    "f05a77def6ec4fa20b80f07802b2ac7bef03138a7816018796"
                    "f712edc301aa3f"
                ),
                "reason_code": "off-topic",
                "decided_at": "2026-07-25T17:59:00Z",
                "boundary": (
                    "Hostile fixture: a selected excluded event must fail closed."
                ),
            }
        ]
        excluded_review.write_text(json.dumps(record), encoding="utf-8")
        excluded = run_build(
            excluded_review, EVENTS, root / "excluded-output"
        )
        assert excluded.returncode != 0
        assert "active moderation exclusion" in excluded.stderr

        automatic_report_review = root / "automatic-report-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["moderation"]["reports"] = "automatic-block"
        automatic_report_review.write_text(
            json.dumps(record), encoding="utf-8"
        )
        automatic_report = run_build(
            automatic_report_review,
            EVENTS,
            root / "automatic-report-output",
        )
        assert automatic_report.returncode != 0
        assert "signals, not decisions" in automatic_report.stderr

        future_decision_review = root / "future-decision-review.json"
        record = json.loads(REVIEW.read_text(encoding="utf-8"))
        record["moderation"]["excluded_events"] = [
            {
                "event_id": "ab" * 32,
                "reason_code": "other",
                "decided_at": "2026-07-25T18:00:01Z",
                "boundary": "A future moderation decision cannot affect this build.",
            }
        ]
        future_decision_review.write_text(
            json.dumps(record), encoding="utf-8"
        )
        future_decision = run_build(
            future_decision_review,
            EVENTS,
            root / "future-decision-output",
        )
        assert future_decision.returncode != 0
        assert "moderation decision is from the future" in future_decision.stderr

    print(
        "PASS read-only signed WYWA network, fail-closed moderation, "
        "and same-author withdrawal"
    )


if __name__ == "__main__":
    main()
