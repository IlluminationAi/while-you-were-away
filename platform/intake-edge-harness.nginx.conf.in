# TEST ONLY: isolated reverse-proxy harness for the WYWA intake edge.
# It binds IPv4 loopback, has no TLS, and must not be installed in /etc/nginx.

user __WYWA_NGINX_USER__;
worker_processes 1;
daemon off;
master_process off;
pid "__WYWA_HARNESS_ROOT__/nginx.pid";
error_log /dev/null crit;

events {
    worker_connections 64;
    multi_accept off;
}

http {
    access_log off;
    error_log /dev/null crit;
    server_tokens off;
    sendfile off;

    client_body_temp_path "__WYWA_HARNESS_ROOT__/client-body" 1 2;
    proxy_temp_path "__WYWA_HARNESS_ROOT__/proxy" 1 2;

    limit_req_zone $binary_remote_addr zone=wywa_intake_edge_per_ip:1m rate=5r/s;
    limit_conn_zone $binary_remote_addr zone=wywa_intake_edge_conn_per_ip:1m;

    server {
        listen 127.0.0.1:__WYWA_EDGE_PORT__;
        server_name intake-edge.invalid;
        access_log off;
        error_log /dev/null crit;
        server_tokens off;

        client_max_body_size 32k;
        client_body_buffer_size 32k;
        client_header_buffer_size 1k;
        large_client_header_buffers 2 4k;
        client_header_timeout 3s;
        client_body_timeout 3s;
        send_timeout 3s;
        keepalive_timeout 0;
        reset_timedout_connection on;

        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;

        error_page 413 = @edge_body_too_large;
        error_page 429 = @edge_limited;
        error_page 502 504 =503 @edge_unavailable;

        location = /v1/intake {
            if ($args != "") {
                return 404;
            }
            if ($request_method != POST) {
                return 405;
            }
            if ($http_content_type != "application/json") {
                return 415;
            }
            if ($http_transfer_encoding != "") {
                return 400;
            }
            if ($http_content_encoding != "") {
                return 400;
            }
            if ($http_expect != "") {
                return 400;
            }

            limit_req zone=wywa_intake_edge_per_ip burst=5 nodelay;
            limit_req_status 429;
            limit_conn wywa_intake_edge_conn_per_ip 2;
            limit_conn_status 429;

            proxy_pass http://127.0.0.1:__WYWA_UPSTREAM_PORT__;
            proxy_http_version 1.1;
            proxy_request_buffering on;
            proxy_buffering on;
            proxy_max_temp_file_size 0;
            proxy_connect_timeout 1s;
            proxy_send_timeout 5s;
            proxy_read_timeout 55s;
            proxy_next_upstream off;
            proxy_intercept_errors off;

            proxy_set_header Host "intake-loopback.invalid";
            proxy_set_header Connection "close";
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
            proxy_set_header Expect "";
            proxy_set_header Forwarded "";
            proxy_set_header Referer "";
            proxy_set_header User-Agent "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Forwarded-Proto "";
            proxy_set_header X-Real-IP "";
        }

        location @edge_body_too_large {
            internal;
            default_type application/json;
            return 413 '{"accepted":false,"error":"edge-body-too-large"}\n';
        }

        location @edge_limited {
            internal;
            default_type application/json;
            add_header Retry-After "5" always;
            return 429 '{"accepted":false,"error":"edge-rate-or-connection-limit"}\n';
        }

        location @edge_unavailable {
            internal;
            default_type application/json;
            add_header Retry-After "30" always;
            return 503 '{"accepted":false,"error":"edge-upstream-unavailable"}\n';
        }

        location / {
            return 404;
        }
    }
}
