def canonical_json(record: dict[str, Any]) -> bytes:
    return (
        json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
    ).encode("utf-8")


def write_output(
    output: Path,
    catalog: dict[str, Any],
    events: dict[str, dict[str, Any]],
) -> None:
    if not output.is_absolute():
        raise NetworkError("network output directory must be absolute")
    parent = output.parent
    parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    if parent.is_symlink():
        raise NetworkError("network output parent must not be a symlink")
    staging = Path(tempfile.mkdtemp(prefix=".network-", dir=parent))
    try:
        staging.chmod(0o755)
        events_directory = staging / "events"
        events_directory.mkdir(mode=0o755)
        files = {
            staging / "index.json": canonical_json(catalog),
            staging / "index.html": render_page(catalog).encode("utf-8"),
        }
        for event_id, event in events.items():
            files[events_directory / f"{event_id}.json"] = canonical_json(event)
        for path, data in files.items():
            path.write_bytes(data)
            path.chmod(0o644)
        old = output.with_name(f".{output.name}.old-{os.getpid()}")
        if old.exists() or old.is_symlink():
            raise NetworkError("network output rollback path already exists")
        if output.exists():
            if output.is_symlink() or not output.is_dir():
                raise NetworkError("network output must be a nonsymlink directory")
            output.rename(old)
        staging.rename(output)
        if old.exists():
            shutil.rmtree(old)
    except Exception:
        if staging.exists():
            shutil.rmtree(staging)
        raise


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=PROGRAM,
        description=(
            "Verify selected NIP-01 event ids, BIP-340 signatures, NIP-02 "
            "follow semantics, NIP-25 reactions, and same-author NIP-09 "
            "deletion requests, then "
            "compile a deterministic read-only export."
        ),
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    build = subparsers.add_parser("build")
    build.add_argument("--review", type=Path, required=True)
    build.add_argument("--events", type=Path, required=True)
    build.add_argument("--output", type=Path, required=True)
    build.add_argument("--as-of")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        as_of = utc_now() if args.as_of is None else parse_moment(
            args.as_of, "as-of time"
        )
        review = load_review(args.review.expanduser().absolute())
        catalog, events = compile_catalog(
            review,
            args.events.expanduser().absolute(),
            as_of=as_of,
        )
        write_output(args.output.expanduser().absolute(), catalog, events)
        print(
            json.dumps(
                {
                    "events": catalog["summary"]["events"],
                    "output": str(args.output.expanduser().absolute()),
                    "participants": catalog["summary"]["participants"],
                    "relationships": catalog["summary"]["follows"],
                    "threads": catalog["summary"]["threads"],
                },
                sort_keys=True,
            )
        )
        return 0
    except NetworkError as error:
        print(f"{PROGRAM}: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
