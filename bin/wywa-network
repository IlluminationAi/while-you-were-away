#!/usr/bin/env python3
"""Compile a reviewed, read-only WYWA network view from signed Nostr events."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import html
import json
import os
import re
import shutil
import stat
import sys
import tempfile
from pathlib import Path
from typing import Any


PROGRAM = Path(__file__).name
MAX_EVENT_BYTES = 128 * 1024
MAX_REVIEW_BYTES = 256 * 1024
MAX_CONTENT_CHARS = 100_000
MAX_PARTICIPANTS = 64
MAX_THREADS = 128
MAX_RELATIONSHIP_LISTS = 64
MAX_REACTIONS = 256
MAX_EVENTS = 1_024
MAX_MODERATION_DECISIONS = 1_024
HEX_32 = re.compile(r"^[0-9a-f]{64}$")
HEX_64 = re.compile(r"^[0-9a-f]{128}$")
PUBLIC_ID = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
CLOCK_SKEW = dt.timedelta(minutes=5)
MODERATION_REASON_CODES = {
    "harassment",
    "illegal",
    "impersonation",
    "malware",
    "nudity",
    "off-topic",
    "other",
    "privacy-risk",
    "profanity",
    "spam",
}

# secp256k1 and BIP-340 verification constants. The deliberately small
# verifier follows BIP-340's verification algorithm and is used only for
# bounded public events, never for signing or secret-key operations.
FIELD_P = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F
GROUP_N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
GENERATOR = (
    0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
    0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8,
)
Point = tuple[int, int] | None


class NetworkError(Exception):
    """A bounded, user-facing network compilation error."""


def utc_now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def utc_text(value: dt.datetime) -> str:
    return value.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def visible_time(value: int) -> str:
    return dt.datetime.fromtimestamp(
        value, tz=dt.timezone.utc
    ).strftime("%d %b %Y · %H:%M UTC")


def parse_moment(value: object, label: str) -> dt.datetime:
    if not isinstance(value, str):
        raise NetworkError(f"{label} must be an RFC 3339 timestamp")
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise NetworkError(f"{label} is not a valid RFC 3339 timestamp") from error
    if parsed.tzinfo is None:
        raise NetworkError(f"{label} must include a timezone")
    normalized = parsed.astimezone(dt.timezone.utc).replace(microsecond=0)
    if value != utc_text(normalized):
        raise NetworkError(f"{label} must use UTC whole seconds ending in Z")
    return normalized


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    record: dict[str, Any] = {}
    for key, value in pairs:
        if key in record:
            raise NetworkError(f"JSON repeats key: {key}")
        record[key] = value
    return record


def read_regular(path: Path, label: str, maximum: int) -> bytes:
    absolute = path.expanduser().absolute()
    try:
        metadata = absolute.lstat()
    except FileNotFoundError as error:
        raise NetworkError(f"{label} does not exist: {absolute}") from error
    if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISREG(metadata.st_mode):
        raise NetworkError(f"{label} must be a regular, nonsymlink file")
    if metadata.st_nlink != 1:
        raise NetworkError(f"{label} must have exactly one hard link")
    if metadata.st_size == 0 or metadata.st_size > maximum:
        raise NetworkError(f"{label} must contain between 1 and {maximum} bytes")
    return absolute.read_bytes()


def load_json(path: Path, label: str, maximum: int) -> dict[str, Any]:
    data = read_regular(path, label, maximum)
    try:
        decoded = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise NetworkError(f"{label} is not UTF-8") from error
    try:
        record = json.loads(decoded, object_pairs_hook=reject_duplicate_keys)
    except json.JSONDecodeError as error:
        raise NetworkError(f"{label} is not valid JSON") from error
    if not isinstance(record, dict):
        raise NetworkError(f"{label} must be a JSON object")
    return record


def exact_keys(record: dict[str, Any], expected: set[str], label: str) -> None:
    actual = set(record)
    if actual == expected:
        return
    missing = sorted(expected - actual)
    extra = sorted(actual - expected)
    details = []
    if missing:
        details.append(f"missing {', '.join(missing)}")
    if extra:
        details.append(f"unknown {', '.join(extra)}")
    raise NetworkError(f"{label} has {'; '.join(details)}")


def bounded_text(
    value: object,
    label: str,
    maximum: int,
    *,
    allow_newlines: bool = False,
    minimum: int = 1,
) -> str:
    if not isinstance(value, str) or not minimum <= len(value) <= maximum:
        raise NetworkError(
            f"{label} must contain between {minimum} and {maximum} characters"
        )
    for character in value:
        codepoint = ord(character)
        if codepoint == 127 or (
            codepoint < 32 and not (allow_newlines and character in "\n\t")
        ):
            raise NetworkError(f"{label} contains a control character")
    return value


def https_url(value: object, label: str) -> str:
    url = bounded_text(value, label, 2_048)
    if not url.startswith("https://"):
        raise NetworkError(f"{label} must use HTTPS")
    return url


def point_add(first: Point, second: Point) -> Point:
    if first is None:
        return second
    if second is None:
        return first
    x1, y1 = first
    x2, y2 = second
    if x1 == x2 and (y1 != y2 or y1 == 0):
        return None
    if x1 == x2:
        slope = (3 * x1 * x1) * pow(2 * y1, FIELD_P - 2, FIELD_P)
    else:
        slope = (y2 - y1) * pow((x2 - x1) % FIELD_P, FIELD_P - 2, FIELD_P)
    slope %= FIELD_P
    x3 = (slope * slope - x1 - x2) % FIELD_P
    y3 = (slope * (x1 - x3) - y1) % FIELD_P
    return x3, y3


def point_multiply(point: Point, scalar: int) -> Point:
    result: Point = None
    current = point
    value = scalar
    while value:
        if value & 1:
            result = point_add(result, current)
        current = point_add(current, current)
        value >>= 1
    return result


def lift_x(value: int) -> Point:
    if value >= FIELD_P:
        return None
    square = (pow(value, 3, FIELD_P) + 7) % FIELD_P
    y_value = pow(square, (FIELD_P + 1) // 4, FIELD_P)
    if pow(y_value, 2, FIELD_P) != square:
        return None
    if y_value & 1:
        y_value = FIELD_P - y_value
    return value, y_value


def tagged_hash(tag: str, message: bytes) -> bytes:
    tag_hash = hashlib.sha256(tag.encode("utf-8")).digest()
    return hashlib.sha256(tag_hash + tag_hash + message).digest()


def verify_bip340(public_key: bytes, message: bytes, signature: bytes) -> bool:
    if len(public_key) != 32 or len(message) != 32 or len(signature) != 64:
        return False
    point = lift_x(int.from_bytes(public_key, "big"))
    if point is None:
        return False
    r_value = int.from_bytes(signature[:32], "big")
    s_value = int.from_bytes(signature[32:], "big")
    if r_value >= FIELD_P or s_value >= GROUP_N:
        return False
    challenge = int.from_bytes(
        tagged_hash(
            "BIP0340/challenge",
            signature[:32] + public_key + message,
        ),
        "big",
    ) % GROUP_N
    candidate = point_add(
        point_multiply(GENERATOR, s_value),
        point_multiply(point, GROUP_N - challenge),
    )
    return (
        candidate is not None
        and candidate[1] % 2 == 0
        and candidate[0] == r_value
    )


def event_identifier(event: dict[str, Any]) -> str:
    serialized = json.dumps(
        [
            0,
            event["pubkey"],
            event["created_at"],
            event["kind"],
            event["tags"],
            event["content"],
        ],
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(serialized).hexdigest()


def validate_event(
    event: dict[str, Any],
    expected_id: str,
    *,
    expected_kind: int,
    as_of: dt.datetime,
) -> dict[str, Any]:
    exact_keys(
        event,
        {"id", "pubkey", "created_at", "kind", "tags", "content", "sig"},
        f"event {expected_id}",
    )
    if event["id"] != expected_id or HEX_32.fullmatch(event["id"]) is None:
        raise NetworkError(f"event filename and id differ: {expected_id}")
    if HEX_32.fullmatch(event["pubkey"]) is None:
        raise NetworkError(f"event {expected_id} has an invalid public key")
    if HEX_64.fullmatch(event["sig"]) is None:
        raise NetworkError(f"event {expected_id} has an invalid signature encoding")
    if event["kind"] != expected_kind:
        raise NetworkError(
            f"event {expected_id} is not the reviewed kind {expected_kind}"
        )
    created_at = event["created_at"]
    if (
        isinstance(created_at, bool)
        or not isinstance(created_at, int)
        or created_at < 0
    ):
        raise NetworkError(f"event {expected_id} has an invalid timestamp")
    try:
        event_time = dt.datetime.fromtimestamp(
            created_at, tz=dt.timezone.utc
        )
    except (OverflowError, OSError, ValueError) as error:
        raise NetworkError(
            f"event {expected_id} has an unsupported timestamp"
        ) from error
    if event_time > as_of + CLOCK_SKEW:
        raise NetworkError(f"event {expected_id} is from the future")
    if expected_kind == 1:
        bounded_text(
            event["content"],
            f"event {expected_id} content",
            MAX_CONTENT_CHARS,
            allow_newlines=True,
        )
    elif expected_kind == 7:
        bounded_text(
            event["content"],
            f"event {expected_id} reaction",
            64,
            minimum=1,
        )
    elif expected_kind == 5:
        bounded_text(
            event["content"],
            f"event {expected_id} deletion reason",
            MAX_CONTENT_CHARS,
            allow_newlines=True,
            minimum=0,
        )
    elif event["content"] != "":
        raise NetworkError(f"follow-list event {expected_id} must have empty content")
    tags = event["tags"]
    if not isinstance(tags, list) or len(tags) > 1_024:
        raise NetworkError(f"event {expected_id} has invalid tags")
    for tag in tags:
        if (
            not isinstance(tag, list)
            or not tag
            or len(tag) > 16
            or any(not isinstance(value, str) for value in tag)
        ):
            raise NetworkError(f"event {expected_id} has an invalid tag")
    if expected_kind == 3:
        if not tags:
            raise NetworkError(f"follow-list event {expected_id} has no follows")
        follow_keys: list[str] = []
        for tag in tags:
            if (
                tag[0] != "p"
                or len(tag) < 2
                or len(tag) > 4
                or HEX_32.fullmatch(tag[1]) is None
            ):
                raise NetworkError(
                    f"follow-list event {expected_id} has a non-NIP-02 tag"
                )
            if len(tag) >= 3 and tag[2] != "" and not tag[2].startswith("wss://"):
                raise NetworkError(
                    f"follow-list event {expected_id} has an invalid relay hint"
                )
            follow_keys.append(tag[1])
        if len(follow_keys) != len(set(follow_keys)):
            raise NetworkError(f"follow-list event {expected_id} repeats a key")
    if expected_kind == 7:
        event_targets: list[str] = []
        author_targets: list[str] = []
        for tag in tags:
            if (
                tag[0] == "e"
                and 2 <= len(tag) <= 4
                and HEX_32.fullmatch(tag[1]) is not None
            ):
                event_targets.append(tag[1])
            elif (
                tag[0] == "p"
                and 2 <= len(tag) <= 4
                and HEX_32.fullmatch(tag[1]) is not None
            ):
                author_targets.append(tag[1])
            else:
                raise NetworkError(
                    f"reaction event {expected_id} has an unsupported tag"
                )
        if len(event_targets) != 1 or len(author_targets) != 1:
            raise NetworkError(
                f"reaction event {expected_id} must name one event and author"
            )
    if expected_kind == 5:
        deleted_ids: list[str] = []
        kind_tags: list[int] = []
        for tag in tags:
            if tag[0] == "e":
                if (
                    len(tag) < 2
                    or len(tag) > 4
                    or HEX_32.fullmatch(tag[1]) is None
                ):
                    raise NetworkError(
                        f"deletion event {expected_id} has an invalid e tag"
                    )
                if len(tag) >= 3 and tag[2] != "" and not tag[2].startswith("wss://"):
                    raise NetworkError(
                        f"deletion event {expected_id} has an invalid relay hint"
                    )
                if (
                    len(tag) == 4
                    and tag[3] != ""
                    and HEX_32.fullmatch(tag[3]) is None
                ):
                    raise NetworkError(
                        f"deletion event {expected_id} has an invalid author hint"
                    )
                deleted_ids.append(tag[1])
            elif tag[0] == "k":
                if (
                    len(tag) != 2
                    or len(tag[1]) > 5
                    or not tag[1].isdigit()
                    or (len(tag[1]) > 1 and tag[1].startswith("0"))
                    or not 0 <= int(tag[1]) <= 65_535
                ):
                    raise NetworkError(
                        f"deletion event {expected_id} has an invalid k tag"
                    )
                kind_tags.append(int(tag[1]))
            else:
                raise NetworkError(
                    f"deletion event {expected_id} has a non-NIP-09 review tag"
                )
        if not deleted_ids:
            raise NetworkError(f"deletion event {expected_id} has no e targets")
        if len(deleted_ids) != len(set(deleted_ids)):
            raise NetworkError(f"deletion event {expected_id} repeats an e target")
        if not kind_tags or len(kind_tags) != len(set(kind_tags)):
            raise NetworkError(
                f"deletion event {expected_id} must have unique k tags"
            )
    calculated = event_identifier(event)
    if calculated != expected_id:
        raise NetworkError(f"event {expected_id} fails NIP-01 id verification")
    if not verify_bip340(
        bytes.fromhex(event["pubkey"]),
        bytes.fromhex(expected_id),
        bytes.fromhex(event["sig"]),
    ):
        raise NetworkError(f"event {expected_id} fails BIP-340 signature verification")
    return event


def validate_moderation(record: object) -> dict[str, Any]:
    if not isinstance(record, dict):
        raise NetworkError("network moderation must be an object")
    exact_keys(
        record,
        {
            "contract",
            "reports",
            "author_deletions",
            "public_export",
            "blocked_pubkeys",
            "excluded_events",
        },
        "network moderation",
    )
    if record["contract"] != "wywa-network-moderation-v2":
        raise NetworkError("network moderation contract is unsupported")
    if record["reports"] != "signals-only":
        raise NetworkError("network reports must remain signals, not decisions")
    if record["public_export"] != "redacted-decision-counts":
        raise NetworkError("network moderation export must remain redacted")

    blocked = record["blocked_pubkeys"]
    excluded = record["excluded_events"]
    author_deletions = record["author_deletions"]
    if (
        not isinstance(blocked, list)
        or len(blocked) > MAX_MODERATION_DECISIONS
        or not isinstance(excluded, list)
        or len(excluded) > MAX_MODERATION_DECISIONS
    ):
        raise NetworkError("network moderation decisions are excessive")
    if not isinstance(author_deletions, dict):
        raise NetworkError("network author deletions must be an object")
    exact_keys(
        author_deletions,
        {
            "contract",
            "event_ids",
            "scope",
            "public_export",
            "relay_erasure",
        },
        "network author deletions",
    )
    if author_deletions["contract"] != "nostr-nip-09-reviewed-v1":
        raise NetworkError("network author-deletion contract is unsupported")
    if author_deletions["scope"] != "selected-note-e-tags-only":
        raise NetworkError("network author-deletion scope was widened")
    if author_deletions["public_export"] != "request-and-tombstone":
        raise NetworkError("network author-deletion export is unsupported")
    if author_deletions["relay_erasure"] != "not-claimed":
        raise NetworkError("network author deletion overclaims relay erasure")
    deletion_ids = author_deletions["event_ids"]
    if (
        not isinstance(deletion_ids, list)
        or len(deletion_ids) > MAX_MODERATION_DECISIONS
        or any(
            not isinstance(event_id, str)
            or HEX_32.fullmatch(event_id) is None
            for event_id in deletion_ids
        )
        or len(deletion_ids) != len(set(deletion_ids))
    ):
        raise NetworkError(
            "network author-deletion event ids must be unique 32-byte hex"
        )

    blocked_keys: set[str] = set()
    excluded_ids: set[str] = set()
    for decision_type, decisions, target_key, target_pattern, seen in (
        ("blocked key", blocked, "pubkey", HEX_32, blocked_keys),
        ("excluded event", excluded, "event_id", HEX_32, excluded_ids),
    ):
        for decision in decisions:
            if not isinstance(decision, dict):
                raise NetworkError(
                    f"network moderation {decision_type} must be an object"
                )
            exact_keys(
                decision,
                {target_key, "reason_code", "decided_at", "boundary"},
                f"network moderation {decision_type}",
            )
            target = decision[target_key]
            if (
                not isinstance(target, str)
                or target_pattern.fullmatch(target) is None
                or target in seen
            ):
                raise NetworkError(
                    f"network moderation {decision_type} targets must be unique"
                )
            seen.add(target)
            if decision["reason_code"] not in MODERATION_REASON_CODES:
                raise NetworkError(
                    f"network moderation {decision_type} reason is unsupported"
                )
            parse_moment(
                decision["decided_at"],
                f"network moderation {decision_type} time",
            )
            bounded_text(
                decision["boundary"],
                f"network moderation {decision_type} boundary",
                1_000,
            )
    return record


def load_review(path: Path) -> dict[str, Any]:
    review = load_json(path, "network review", MAX_REVIEW_BYTES)
    exact_keys(
        review,
        {
            "schema_version",
            "title",
            "description",
            "admission",
            "protocol",
            "participants",
            "threads",
            "relationships",
            "reactions",
            "moderation",
            "policy",
            "boundaries",
        },
        "network review",
    )
    if review["schema_version"] != 5:
        raise NetworkError("network review has an unsupported schema")
    if review["admission"] != "reviewed-read-only":
        raise NetworkError("network admission must remain reviewed-read-only")
    if review["protocol"] != "nostr-nip-01+02+09+25":
        raise NetworkError("network protocol must be nostr-nip-01+02+09+25")
    bounded_text(review["title"], "network title", 160)
    bounded_text(review["description"], "network description", 1_000)
    participants = review["participants"]
    if (
        not isinstance(participants, list)
        or not 1 <= len(participants) <= MAX_PARTICIPANTS
    ):
        raise NetworkError("network participants are missing or excessive")
    participant_ids: set[str] = set()
    participant_keys: set[str] = set()
    for participant in participants:
        if not isinstance(participant, dict):
            raise NetworkError("network participant must be an object")
        exact_keys(
            participant,
            {
                "id",
                "name",
                "pubkey",
                "agent_id",
                "identity_evidence",
                "url",
                "boundary",
            },
            "network participant",
        )
        participant_id = participant["id"]
        if (
            not isinstance(participant_id, str)
            or PUBLIC_ID.fullmatch(participant_id) is None
            or participant_id in participant_ids
        ):
            raise NetworkError("network participant ids must be unique public ids")
        participant_ids.add(participant_id)
        if (
            not isinstance(participant["pubkey"], str)
            or HEX_32.fullmatch(participant["pubkey"]) is None
            or participant["pubkey"] in participant_keys
        ):
            raise NetworkError("network participant public keys must be unique")
        participant_keys.add(participant["pubkey"])
        agent_id = participant["agent_id"]
        if agent_id is not None and (
            not isinstance(agent_id, str)
            or PUBLIC_ID.fullmatch(agent_id) is None
        ):
            raise NetworkError("network participant agent_id is invalid")
        if participant["identity_evidence"] not in {
            "wywa-agent-id",
            "nostr-event-key-only",
        }:
            raise NetworkError("network participant identity evidence is invalid")
        if (agent_id is None) != (
            participant["identity_evidence"] == "nostr-event-key-only"
        ):
            raise NetworkError(
                "network participant agent link and identity evidence disagree"
            )
        bounded_text(participant["name"], "network participant name", 120)
        https_url(participant["url"], "network participant URL")
        bounded_text(participant["boundary"], "network participant boundary", 800)
    threads = review["threads"]
    if (
        not isinstance(threads, list)
        or not 1 <= len(threads) <= MAX_THREADS
    ):
        raise NetworkError("network threads are missing or excessive")
    thread_ids: set[str] = set()
    event_ids: set[str] = set()
    for thread in threads:
        if not isinstance(thread, dict):
            raise NetworkError("network thread must be an object")
        exact_keys(
            thread,
            {"id", "title", "summary", "event_ids", "boundary"},
            "network thread",
        )
        thread_id = thread["id"]
        if (
            not isinstance(thread_id, str)
            or PUBLIC_ID.fullmatch(thread_id) is None
            or thread_id in thread_ids
        ):
            raise NetworkError("network thread ids must be unique public ids")
        thread_ids.add(thread_id)
        bounded_text(thread["title"], "network thread title", 180)
        bounded_text(thread["summary"], "network thread summary", 1_500)
        bounded_text(thread["boundary"], "network thread boundary", 1_500)
        selected = thread["event_ids"]
        if not isinstance(selected, list) or not selected:
            raise NetworkError(f"network thread {thread_id} has no events")
        for event_id in selected:
            if (
                not isinstance(event_id, str)
                or HEX_32.fullmatch(event_id) is None
                or event_id in event_ids
            ):
                raise NetworkError("network event ids must be unique 32-byte hex")
            event_ids.add(event_id)
    if len(event_ids) > MAX_EVENTS:
        raise NetworkError("network review selects too many events")
    relationships = review["relationships"]
    if (
        not isinstance(relationships, list)
        or not 1 <= len(relationships) <= MAX_RELATIONSHIP_LISTS
    ):
        raise NetworkError("network relationship lists are missing or excessive")
    relationship_ids: set[str] = set()
    relationship_event_ids: set[str] = set()
    relationship_sources: set[str] = set()
    for relationship in relationships:
        if not isinstance(relationship, dict):
            raise NetworkError("network relationship list must be an object")
        exact_keys(
            relationship,
            {
                "id",
                "type",
                "event_id",
                "source_participant_id",
                "target_participant_ids",
                "unreviewed_target_count",
                "current_state",
                "boundary",
            },
            "network relationship list",
        )
        relationship_id = relationship["id"]
        if (
            not isinstance(relationship_id, str)
            or PUBLIC_ID.fullmatch(relationship_id) is None
            or relationship_id in relationship_ids
        ):
            raise NetworkError("network relationship ids must be unique public ids")
        relationship_ids.add(relationship_id)
        if relationship["type"] != "nip-02-follow-list":
            raise NetworkError("network relationship type is unsupported")
        event_id = relationship["event_id"]
        if (
            not isinstance(event_id, str)
            or HEX_32.fullmatch(event_id) is None
            or event_id in event_ids
            or event_id in relationship_event_ids
        ):
            raise NetworkError(
                "network relationship event ids must be unique 32-byte hex"
            )
        relationship_event_ids.add(event_id)
        source = relationship["source_participant_id"]
        if source not in participant_ids or source in relationship_sources:
            raise NetworkError(
                "network follow-list source must be one unique participant"
            )
        relationship_sources.add(source)
        targets = relationship["target_participant_ids"]
        if (
            not isinstance(targets, list)
            or not targets
            or len(targets) > MAX_PARTICIPANTS
            or len(targets) != len(set(targets))
            or any(
                target not in participant_ids or target == source
                for target in targets
            )
        ):
            raise NetworkError("network follow-list targets are invalid")
        unreviewed_target_count = relationship["unreviewed_target_count"]
        if (
            isinstance(unreviewed_target_count, bool)
            or not isinstance(unreviewed_target_count, int)
            or not 0 <= unreviewed_target_count <= 1_024
        ):
            raise NetworkError(
                "network follow-list unreviewed target count is invalid"
            )
        if relationship["current_state"] != "current-at-review":
            raise NetworkError("network follow-list current state is unsupported")
        bounded_text(
            relationship["boundary"],
            "network relationship boundary",
            1_500,
        )
    reactions = review["reactions"]
    if not isinstance(reactions, list) or len(reactions) > MAX_REACTIONS:
        raise NetworkError("network reactions are invalid or excessive")
    reaction_ids: set[str] = set()
    reaction_event_ids: set[str] = set()
    for reaction in reactions:
        if not isinstance(reaction, dict):
            raise NetworkError("network reaction must be an object")
        exact_keys(
            reaction,
            {
                "id",
                "type",
                "event_id",
                "source_participant_id",
                "target_event_id",
                "content",
                "boundary",
            },
            "network reaction",
        )
        reaction_id = reaction["id"]
        if (
            not isinstance(reaction_id, str)
            or PUBLIC_ID.fullmatch(reaction_id) is None
            or reaction_id in reaction_ids
        ):
            raise NetworkError("network reaction ids must be unique public ids")
        reaction_ids.add(reaction_id)
        if reaction["type"] != "nip-25-reaction":
            raise NetworkError("network reaction type is unsupported")
        event_id = reaction["event_id"]
        target_event_id = reaction["target_event_id"]
        if (
            not isinstance(event_id, str)
            or HEX_32.fullmatch(event_id) is None
            or event_id in event_ids
            or event_id in relationship_event_ids
            or event_id in reaction_event_ids
        ):
            raise NetworkError("network reaction event id is invalid or repeated")
        reaction_event_ids.add(event_id)
        if target_event_id not in event_ids:
            raise NetworkError("network reaction target is not a selected note")
        if reaction["source_participant_id"] not in participant_ids:
            raise NetworkError("network reaction source is not a participant")
        bounded_text(reaction["content"], "network reaction content", 64)
        bounded_text(reaction["boundary"], "network reaction boundary", 1_500)
    moderation = validate_moderation(review["moderation"])
    deletion_event_ids = moderation["author_deletions"]["event_ids"]
    selected_event_ids = event_ids | relationship_event_ids | reaction_event_ids
    if any(event_id in selected_event_ids for event_id in deletion_event_ids):
        raise NetworkError(
            "network author-deletion requests must be separate selected events"
        )
    if len(selected_event_ids | set(deletion_event_ids)) > MAX_EVENTS:
        raise NetworkError("network review selects too many events")
    policy = review["policy"]
    if not isinstance(policy, dict):
        raise NetworkError("network policy must be an object")
    exact_keys(
        policy,
        {
            "public_input",
            "selection",
            "moderation",
            "blocking",
            "rate_limits",
            "export",
        },
        "network policy",
    )
    if policy["public_input"] != "closed" or policy["selection"] != "manual-reviewed":
        raise NetworkError("network intake and selection boundaries were widened")
    for key, value in policy.items():
        bounded_text(value, f"network policy {key}", 1_000)
    boundaries = review["boundaries"]
    if (
        not isinstance(boundaries, list)
        or not boundaries
        or len(boundaries) > 32
    ):
        raise NetworkError("network boundaries are missing or excessive")
    for boundary in boundaries:
        bounded_text(boundary, "network boundary", 1_500)
    return review


def event_markers(
    event: dict[str, Any],
) -> tuple[str | None, str | None, list[str]]:
    roots = [
        tag[1]
        for tag in event["tags"]
        if len(tag) >= 4
        and tag[0] == "e"
        and tag[3] == "root"
        and HEX_32.fullmatch(tag[1]) is not None
    ]
    replies = [
        tag[1]
        for tag in event["tags"]
        if len(tag) >= 4
        and tag[0] == "e"
        and tag[3] == "reply"
        and HEX_32.fullmatch(tag[1]) is not None
    ]
    mentions = [
        tag[1]
        for tag in event["tags"]
        if len(tag) >= 2
        and tag[0] == "p"
        and HEX_32.fullmatch(tag[1]) is not None
    ]
    if len(set(roots)) > 1 or len(set(replies)) > 1:
        raise NetworkError(f"event {event['id']} has ambiguous thread markers")
    return (
        roots[0] if roots else None,
        replies[0] if replies else None,
        sorted(set(mentions)),
    )


def compile_catalog(
    review: dict[str, Any],
    event_directory: Path,
    *,
    as_of: dt.datetime,
) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
    if not event_directory.is_absolute():
        raise NetworkError("network event directory must be absolute")
    if not event_directory.is_dir() or event_directory.is_symlink():
        raise NetworkError("network event directory must be a nonsymlink directory")
    note_ids = [
        event_id
        for thread in review["threads"]
        for event_id in thread["event_ids"]
    ]
    relationship_ids = [
        relationship["event_id"] for relationship in review["relationships"]
    ]
    reaction_ids = [reaction["event_id"] for reaction in review["reactions"]]
    moderation = review["moderation"]
    deletion_ids = moderation["author_deletions"]["event_ids"]
    expected_ids = note_ids + relationship_ids + reaction_ids + deletion_ids
    expected_names = {f"{event_id}.json" for event_id in expected_ids}
    actual_names = {
        path.name
        for path in event_directory.iterdir()
    }
    if actual_names != expected_names:
        missing = sorted(expected_names - actual_names)
        extra = sorted(actual_names - expected_names)
        detail = []
        if missing:
            detail.append(f"missing {', '.join(missing)}")
        if extra:
            detail.append(f"unexpected {', '.join(extra)}")
        raise NetworkError(
            "network event directory differs from review: " + "; ".join(detail)
        )
    participant_by_key = {
        item["pubkey"]: item for item in review["participants"]
    }
    for decision in moderation["blocked_pubkeys"]:
        if parse_moment(
            decision["decided_at"], "network moderation blocked key time"
        ) > as_of:
            raise NetworkError("network moderation decision is from the future")
    for decision in moderation["excluded_events"]:
        if parse_moment(
            decision["decided_at"], "network moderation excluded event time"
        ) > as_of:
            raise NetworkError("network moderation decision is from the future")
    blocked_pubkeys = {
        decision["pubkey"] for decision in moderation["blocked_pubkeys"]
    }
    excluded_event_ids = {
        decision["event_id"] for decision in moderation["excluded_events"]
    }
    for participant in review["participants"]:
        if participant["pubkey"] in blocked_pubkeys:
            raise NetworkError(
                "network participant "
                f"{participant['id']} is blocked by an active moderation decision"
            )
    for event_id in expected_ids:
        if event_id in excluded_event_ids:
            raise NetworkError(
                f"network event {event_id} has an active moderation exclusion"
            )
    events: dict[str, dict[str, Any]] = {}
    for event_id in expected_ids:
        event = load_json(
            event_directory / f"{event_id}.json",
            f"network event {event_id}",
            MAX_EVENT_BYTES,
        )
        validate_event(
            event,
            event_id,
            expected_kind=(
                1 if event_id in note_ids
                else 3 if event_id in relationship_ids
                else 7 if event_id in reaction_ids
                else 5
            ),
            as_of=as_of,
        )
        if event["pubkey"] not in participant_by_key:
            raise NetworkError(f"event {event_id} has an unreviewed author")
        events[event_id] = event
    selected_content_ids = set(note_ids)
    deleted_target_ids: set[str] = set()
    compiled_deletions = []
    participant_by_id = {
        item["id"]: item for item in review["participants"]
    }
    for deletion_id in deletion_ids:
        deletion = events[deletion_id]
        target_ids = [tag[1] for tag in deletion["tags"] if tag[0] == "e"]
        kind_tags = {
            int(tag[1]) for tag in deletion["tags"] if tag[0] == "k"
        }
        target_kinds: set[int] = set()
        for target_id in target_ids:
            if target_id not in selected_content_ids:
                raise NetworkError(
                    f"deletion event {deletion_id} targets an unselected event"
                )
            if target_id in deleted_target_ids:
                raise NetworkError(
                    f"network event {target_id} has repeated deletion requests"
                )
            target = events[target_id]
            if deletion["pubkey"] != target["pubkey"]:
                raise NetworkError(
                    f"deletion event {deletion_id} cannot delete an event "
                    "signed by another key"
                )
            if deletion["created_at"] < target["created_at"]:
                raise NetworkError(
                    f"deletion event {deletion_id} predates its target"
                )
            if target["kind"] not in kind_tags:
                raise NetworkError(
                    f"deletion event {deletion_id} omits the target kind"
                )
            target_kinds.add(target["kind"])
            for tag in deletion["tags"]:
                if (
                    tag[0] == "e"
                    and tag[1] == target_id
                    and len(tag) == 4
                    and tag[3] != ""
                    and tag[3] != target["pubkey"]
                ):
                    raise NetworkError(
                        f"deletion event {deletion_id} has the wrong author hint"
                    )
            deleted_target_ids.add(target_id)
        if kind_tags != target_kinds:
            raise NetworkError(
                f"deletion event {deletion_id} has unrelated k tags"
            )
        author = participant_by_key[deletion["pubkey"]]
        compiled_deletions.append(
            {
                "request_event_id": deletion_id,
                "participant_id": author["id"],
                "author": author["name"],
                "pubkey": deletion["pubkey"],
                "kind": 5,
                "created_at": dt.datetime.fromtimestamp(
                    deletion["created_at"], tz=dt.timezone.utc
                ).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "content": deletion["content"],
                "deletion_tags": deletion["tags"],
                "target_event_ids": target_ids,
                "event_url": f"/network/events/{deletion_id}.json",
                "relay_view_url": f"https://njump.me/{deletion_id}",
                "verification": {
                    "event_id": "nip-01-recomputed",
                    "signature": "bip-340-verified",
                    "semantics": "nip-09-same-author-selected-e-tags",
                },
            }
        )
    compiled_threads = []
    total_replies = 0
    for thread in review["threads"]:
        prior_ids: set[str] = set()
        previous_time = -1
        compiled_events = []
        for position, event_id in enumerate(thread["event_ids"]):
            event = events[event_id]
            if event["created_at"] < previous_time:
                raise NetworkError(
                    f"network thread {thread['id']} is not chronological"
                )
            previous_time = event["created_at"]
            wire_root, reply_to, mentions = event_markers(event)
            linked = {
                value
                for value in (wire_root, reply_to)
                if value is not None
            }
            if position == 0:
                if reply_to is not None and reply_to not in events:
                    raise NetworkError(
                        f"thread root {event_id} replies to an unselected event"
                    )
            elif not linked.intersection(prior_ids):
                raise NetworkError(
                    f"event {event_id} does not link to an earlier thread event"
                )
            if position > 0 and not mentions:
                raise NetworkError(f"reply event {event_id} omits its target author")
            prior_ids.add(event_id)
            if event_id in deleted_target_ids:
                continue
            author = participant_by_key[event["pubkey"]]
            if compiled_events:
                total_replies += 1
            compiled_events.append(
                {
                    "id": event_id,
                    "participant_id": author["id"],
                    "author": author["name"],
                    "pubkey": event["pubkey"],
                    "kind": 1,
                    "created_at": dt.datetime.fromtimestamp(
                        event["created_at"], tz=dt.timezone.utc
                    ).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "content": event["content"],
                    "wire_root": wire_root,
                    "reply_to": reply_to,
                    "mentions": mentions,
                    "event_url": f"/network/events/{event_id}.json",
                    "relay_view_url": f"https://njump.me/{event_id}",
                    "verification": {
                        "event_id": "nip-01-recomputed",
                        "signature": "bip-340-verified",
                    },
                }
            )
        compiled_threads.append(
            {
                "id": thread["id"],
                "title": thread["title"],
                "summary": thread["summary"],
                "boundary": thread["boundary"],
                "events": compiled_events,
                "author_deleted_event_ids": [
                    event_id
                    for event_id in thread["event_ids"]
                    if event_id in deleted_target_ids
                ],
            }
        )
    compiled_relationships = []
    total_follows = 0
    for relationship in review["relationships"]:
        event = events[relationship["event_id"]]
        source = participant_by_id[relationship["source_participant_id"]]
        targets = [
            participant_by_id[target_id]
            for target_id in relationship["target_participant_ids"]
        ]
        if event["pubkey"] != source["pubkey"]:
            raise NetworkError(
                f"follow-list event {event['id']} has the wrong source key"
            )
        event_target_keys = [tag[1] for tag in event["tags"]]
        reviewed_target_keys = [target["pubkey"] for target in targets]
        selected_keys = [
            key for key in event_target_keys if key in reviewed_target_keys
        ]
        if (
            selected_keys != reviewed_target_keys
            or len(event_target_keys) - len(reviewed_target_keys)
            != relationship["unreviewed_target_count"]
            or any(
                key in participant_by_key and key not in reviewed_target_keys
                for key in event_target_keys
            )
        ):
            raise NetworkError(
                f"follow-list event {event['id']} differs from reviewed targets"
            )
        if event["id"] in deleted_target_ids:
            continue
        total_follows += len(targets)
        compiled_relationships.append(
            {
                "id": relationship["id"],
                "type": relationship["type"],
                "event_id": event["id"],
                "source_participant_id": source["id"],
                "source": source["name"],
                "target_participant_ids": [target["id"] for target in targets],
                "targets": [target["name"] for target in targets],
                "unreviewed_target_count": relationship[
                    "unreviewed_target_count"
                ],
                "follow_tags": event["tags"],
                "pubkey": event["pubkey"],
                "kind": 3,
                "created_at": dt.datetime.fromtimestamp(
                    event["created_at"], tz=dt.timezone.utc
                ).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "content": "",
                "current_state": relationship["current_state"],
                "boundary": relationship["boundary"],
                "event_url": f"/network/events/{event['id']}.json",
                "relay_view_url": f"https://njump.me/{event['id']}",
                "verification": {
                    "event_id": "nip-01-recomputed",
                    "signature": "bip-340-verified",
                    "semantics": "nip-02-follow-list",
                },
            }
        )
    compiled_reactions = []
    for reaction in review["reactions"]:
        event = events[reaction["event_id"]]
        source = participant_by_id[reaction["source_participant_id"]]
        target = events[reaction["target_event_id"]]
        target_author = participant_by_key[target["pubkey"]]
        event_targets = [tag[1] for tag in event["tags"] if tag[0] == "e"]
        author_targets = [tag[1] for tag in event["tags"] if tag[0] == "p"]
        if (
            event["pubkey"] != source["pubkey"]
            or event["content"] != reaction["content"]
            or event_targets != [target["id"]]
            or author_targets != [target["pubkey"]]
            or event["created_at"] < target["created_at"]
        ):
            raise NetworkError(
                f"reaction event {event['id']} differs from its reviewed target"
            )
        compiled_reactions.append(
            {
                "id": reaction["id"],
                "type": reaction["type"],
                "event_id": event["id"],
                "source_participant_id": source["id"],
                "source": source["name"],
                "target_event_id": target["id"],
                "target_participant_id": target_author["id"],
                "target": target_author["name"],
                "pubkey": event["pubkey"],
                "kind": 7,
                "created_at": dt.datetime.fromtimestamp(
                    event["created_at"], tz=dt.timezone.utc
                ).strftime("%Y-%m-%dT%H:%M:%SZ"),
                "content": event["content"],
                "reaction_tags": event["tags"],
                "boundary": reaction["boundary"],
                "event_url": f"/network/events/{event['id']}.json",
                "relay_view_url": f"https://njump.me/{event['id']}",
                "verification": {
                    "event_id": "nip-01-recomputed",
                    "signature": "bip-340-verified",
                    "semantics": "nip-25-exact-event-reaction",
                },
            }
        )
    registry_links = sum(
        1 for participant in review["participants"]
        if participant["agent_id"] is not None
    )
    reason_counts: dict[str, int] = {}
    for decision in (
        moderation["blocked_pubkeys"] + moderation["excluded_events"]
    ):
        reason = decision["reason_code"]
        reason_counts[reason] = reason_counts.get(reason, 0) + 1
    catalog = {
        "schema_version": 5,
        "generated_at": utc_text(as_of),
        "admission": review["admission"],
        "protocol": review["protocol"],
        "title": review["title"],
        "description": review["description"],
        "summary": {
            "participants": len(review["participants"]),
            "registry_linked_participants": registry_links,
            "external_key_only_participants": (
                len(review["participants"]) - registry_links
            ),
            "threads": len(compiled_threads),
            "events": (
                len(note_ids)
                + len(relationship_ids)
                + len(reaction_ids)
                + len(deletion_ids)
                - len(deleted_target_ids)
            ),
            "notes": sum(
                1 for event_id in note_ids
                if event_id not in deleted_target_ids
            ),
            "replies": total_replies,
            "follow_list_events": len(compiled_relationships),
            "follows": total_follows,
            "unreviewed_follow_entries": sum(
                relationship["unreviewed_target_count"]
                for relationship in review["relationships"]
            ),
            "reactions": len(compiled_reactions),
            "author_deletion_requests": len(deletion_ids),
            "author_deleted_events": len(deleted_target_ids),
            "verified_event_ids": len(events),
            "verified_event_signatures": len(events),
        },
        "participants": review["participants"],
        "relationships": compiled_relationships,
        "reactions": compiled_reactions,
        "threads": compiled_threads,
        "author_deletions": compiled_deletions,
        "moderation": {
            "contract": moderation["contract"],
            "reports": moderation["reports"],
            "public_export": moderation["public_export"],
            "active_blocked_pubkeys": len(moderation["blocked_pubkeys"]),
            "active_excluded_events": len(moderation["excluded_events"]),
            "author_deletions": {
                "contract": moderation["author_deletions"]["contract"],
                "scope": moderation["author_deletions"]["scope"],
                "public_export": moderation["author_deletions"]["public_export"],
                "relay_erasure": moderation["author_deletions"]["relay_erasure"],
                "requests": len(deletion_ids),
                "deleted_events": len(deleted_target_ids),
            },
            "reason_counts": dict(sorted(reason_counts.items())),
            "boundary": (
                "A report is review input, never an automatic vote. Active "
                "key blocks and event exclusions are checked before selected "
                "bytes can enter the export; those decisions expose only "
                "counts and reason codes. A selected NIP-09 request hides "
                "a note only after its id, signature, target kind, and "
                "same-author relationship verify. The signed request and "
                "tombstone remain public; no static export can erase relay copies."
            ),
        },
        "policy": review["policy"],
        "boundaries": review["boundaries"],
    }
    exported_events = {
        event_id: event
        for event_id, event in events.items()
        if event_id not in deleted_target_ids
    }
    return catalog, exported_events


def esc(value: object) -> str:
    return html.escape(str(value), quote=True)


def render_page(catalog: dict[str, Any]) -> str:
    summary = catalog["summary"]
    participant_cards = "".join(
        f"""
        <article>
          <p class="status-pill">{esc(participant['identity_evidence'])}</p>
          <h3>{esc(participant['name'])}</h3>
          <p>{esc(participant['boundary'])}</p>
          <a href="{esc(participant['url'])}" rel="noreferrer">identity surface ↗</a>
        </article>"""
        for participant in catalog["participants"]
    )
    thread_sections = []
    for index, thread in enumerate(catalog["threads"], start=2):
        event_cards = []
        for event in thread["events"]:
            marker = (
                f"reply {event['reply_to'][:12]}"
                if event["reply_to"] is not None
                else "thread opening"
            )
            event_cards.append(
                f"""
          <article class="network-event">
            <div class="card-meta"><span>{esc(event['author'])}</span><time datetime="{esc(event['created_at'])}">{esc(event['created_at'])}</time></div>
            <p class="network-marker">{esc(marker)} · NIP-01 id + BIP-340 signature verified</p>
            <div class="network-copy">{esc(event['content'])}</div>
            <div class="network-links"><a href="{esc(event['event_url'])}">exact event JSON ↗</a><a href="{esc(event['relay_view_url'])}" rel="noreferrer">relay view ↗</a></div>
          </article>"""
            )
        thread_sections.append(
            f"""
      <section class="section network-thread" id="{esc(thread['id'])}">
        <div class="section-heading"><div><p class="section-label">{index:02d} / signed exchange</p>
          <h2>{esc(thread['title'])}</h2></div>
          <p>{esc(thread['summary'])}</p></div>
        <div class="network-events">{''.join(event_cards)}</div>
        <p class="network-boundary">{esc(thread['boundary'])}</p>
      </section>"""
        )
    relationship_cards = "".join(
        f"""
        <article class="network-event">
          <div class="card-meta"><span>{esc(relationship['source'])}</span><time datetime="{esc(relationship['created_at'])}">{esc(relationship['created_at'])}</time></div>
          <p class="network-marker">NIP-02 follow list · NIP-01 id + BIP-340 signature verified</p>
          <div class="network-copy"><strong>Follows {esc(', '.join(relationship['targets']))}</strong><br>{esc(relationship['boundary'])}</div>
          <div class="network-links"><a href="{esc(relationship['event_url'])}">exact event JSON ↗</a><a href="{esc(relationship['relay_view_url'])}" rel="noreferrer">relay view ↗</a></div>
        </article>"""
        for relationship in catalog["relationships"]
    )
    reaction_cards = "".join(
        f"""
        <article class="network-event">
          <div class="card-meta"><span>{esc(reaction['source'])}</span><time datetime="{esc(reaction['created_at'])}">{esc(reaction['created_at'])}</time></div>
          <p class="network-marker">NIP-25 reaction · NIP-01 id + BIP-340 signature verified</p>
          <div class="network-copy"><strong>Reacted {esc(reaction['content'])} to {esc(reaction['target'])}</strong><br>{esc(reaction['boundary'])}</div>
          <div class="network-links"><a href="{esc(reaction['event_url'])}">exact event JSON ↗</a><a href="{esc(reaction['relay_view_url'])}" rel="noreferrer">relay view ↗</a></div>
        </article>"""
        for reaction in catalog["reactions"]
    )
    moderation = catalog["moderation"]
    moderation_reasons = (
        ", ".join(
            f"{reason}: {count}"
            for reason, count in moderation["reason_counts"].items()
        )
        or "none"
    )
    boundary_items = "".join(
        f"<li>{esc(boundary)}</li>" for boundary in catalog["boundaries"]
    )
    policy_items = "".join(
        f"<p><strong>{esc(key.replace('_', ' '))}</strong><br>{esc(value)}</p>"
        for key, value in catalog["policy"].items()
    )
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{esc(catalog['description'])}">
    <title>{esc(catalog['title'])} — WYWA network</title>
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body>
    <header class="topbar">
