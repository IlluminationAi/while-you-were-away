#!/usr/bin/env python3
"""Build and atomically publish a bounded WYWA public life dashboard."""

from __future__ import annotations

import argparse
import copy
import datetime as dt
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import tempfile
import xml.etree.ElementTree as ET
from decimal import Decimal, InvalidOperation
from pathlib import Path
from typing import Any
from urllib.parse import urlparse


PROJECT = Path(__file__).resolve().parent.parent
WORKSPACE = PROJECT.parent.parent
PUBLIC_STATE = PROJECT / "platform" / "public-state.json"
SITE_CSS = PROJECT / "platform" / "site.css"
REGISTRY = PROJECT / "bin" / "wywa-registry"
PRODUCT = PROJECT / "bin" / "wywa-product"
RECEIPT = PROJECT / "bin" / "wywa-receipt"
DEFAULT_SITE_ROOT = Path("/var/www/while-you-were-away")
DEFAULT_RUNTIME_ROOT = Path("/var/lib/agent-life/runtime")
DEFAULT_BASE_URL = "https://while-you-were-away.online"
RECEIPT_PATTERN = re.compile(r"^(?:completed=)?(\S+)\s+(.+)$")
MONEY_PATTERN = re.compile(r"^(?:0|[1-9][0-9]*)\.[0-9]{2}$")
PUBLIC_ID_PATTERN = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
MAX_AGENT_MANIFEST_BYTES = 64 * 1024
MAX_AGENT_SIGNATURE_BYTES = 16 * 1024
MAX_PRODUCT_CLAIM_BYTES = 64 * 1024
MAX_PRODUCT_SIGNATURE_BYTES = 16 * 1024
MAX_ECONOMICS_BUNDLE_BYTES = 256 * 1024
MAX_ECONOMICS_SIGNATURE_BYTES = 16 * 1024
MAX_REGISTRY_CATALOG_BYTES = 512 * 1024
MAX_REGISTRY_AUDIT_BYTES = 2 * 1024 * 1024
MAX_REGISTRY_PAGE_BYTES = 512 * 1024
MAX_NETWORK_CATALOG_BYTES = 2 * 1024 * 1024
MAX_NETWORK_PAGE_BYTES = 2 * 1024 * 1024
MAX_NETWORK_EVENT_BYTES = 128 * 1024
SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def required_executable(name: str) -> str:
    executable = shutil.which(name, path=SAFE_PATH)
    if executable is None:
        raise ValueError(f"required executable is unavailable: {name}")
    return executable


def parse_moment(value: str) -> dt.datetime:
    parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
        raise ValueError(f"timestamp lacks timezone: {value}")
    return parsed.astimezone(dt.timezone.utc)


def utc_text(value: dt.datetime) -> str:
    return value.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def visible_time(value: str) -> str:
    return parse_moment(value).strftime("%d %b %Y · %H:%M UTC")


def validate_base_url(value: str) -> str:
    normalized = value.rstrip("/")
    if normalized.startswith("https://"):
        return normalized
    if normalized in {"http://127.0.0.1", "http://localhost"}:
        return normalized
    raise ValueError("base URL must use HTTPS or an exact loopback HTTP origin")


def money_value(value: object, label: str, *, allow_zero: bool = True) -> Decimal:
    if not isinstance(value, str) or MONEY_PATTERN.fullmatch(value) is None:
        raise ValueError(f"{label} must be a nonnegative USD amount with two decimals")
    try:
        parsed = Decimal(value)
    except InvalidOperation as error:
        raise ValueError(f"{label} is not a valid decimal amount") from error
    if parsed < 0 or (not allow_zero and parsed == 0):
        qualifier = "positive" if not allow_zero else "nonnegative"
        raise ValueError(f"{label} must be {qualifier}")
    return parsed


def money_text(value: Decimal) -> str:
    return f"{value:.2f}"


def validate_products(record: dict[str, Any]) -> None:
    agent_ids = {
        item.get("id")
        for item in record["agents"]
        if isinstance(item, dict)
    }
    bundle_ids: set[str] = set()
    for product in record["products"]:
        product_id = product.get("id")
        if (
            not isinstance(product_id, str)
            or PUBLIC_ID_PATTERN.fullmatch(product_id) is None
        ):
            raise ValueError("product id must be a lowercase hyphenated identifier")
        if product.get("maker_agent_id") not in agent_ids:
            raise ValueError(f"product maker is not a declared agent: {product_id}")
        for field in ("name", "stage", "description"):
            if not isinstance(product.get(field), str) or not product[field].strip():
                raise ValueError(f"product {product_id} omits {field}")
        if not isinstance(product.get("url"), str) or not product["url"].startswith(
            "https://"
        ):
            raise ValueError(f"product {product_id} URL must use HTTPS")
        origin_last_verified_at = product.get("origin_last_verified_at")
        if origin_last_verified_at is not None:
            if not isinstance(origin_last_verified_at, str):
                raise ValueError(
                    f"product {product_id} origin verification must be a timestamp"
                )
            parse_moment(origin_last_verified_at)
        proof = product.get("release_evidence")
        if not isinstance(proof, dict):
            raise ValueError(f"product {product_id} omits release evidence")
        if (
            not isinstance(proof.get("kind"), str)
            or not proof["kind"].strip()
            or not isinstance(proof.get("claim"), str)
            or not proof["claim"].strip()
            or not isinstance(proof.get("url"), str)
            or not proof["url"].startswith("https://")
        ):
            raise ValueError(f"product {product_id} has invalid release evidence")
        economics = product.get("economics")
        if not isinstance(economics, dict):
            raise ValueError(f"product {product_id} omits economics")
        statement = economics.get("statement")
        if not isinstance(statement, str) or not statement.strip():
            raise ValueError(f"product {product_id} omits its economics boundary")
        if "evidence" in economics:
            raise ValueError(
                "inline economics evidence is not accepted; use signed provider bundles"
            )
        evidence_bundles = economics.get("evidence_bundles")
        if not isinstance(evidence_bundles, list):
            raise ValueError(
                f"product {product_id} economics evidence_bundles must be a list"
            )
        for bundle_id in evidence_bundles:
            if (
                not isinstance(bundle_id, str)
                or PUBLIC_ID_PATTERN.fullmatch(bundle_id) is None
                or bundle_id in bundle_ids
            ):
                raise ValueError(
                    "economics bundle ids must be unique public ids"
                )
            bundle_ids.add(bundle_id)

    economics = record["economics"]
    if not isinstance(economics, dict) or economics.get("currency") != "USD":
        raise ValueError("public economics must use USD")
    for field in ("definition", "ranking_policy", "popularity_policy"):
        if not isinstance(economics.get(field), str) or not economics[field].strip():
            raise ValueError(f"public economics omits {field}")


def load_public_state(path: Path) -> dict[str, Any]:
    if not path.is_file() or path.is_symlink():
        raise ValueError("public state must be a regular, nonsymlink file")
    record = json.loads(path.read_text(encoding="utf-8"))
    if record.get("schema_version") != 1:
        raise ValueError("public state has unsupported schema")
    for key in (
        "identity",
        "now",
        "projects",
        "ideas",
        "achievements",
        "insights",
        "products",
        "agents",
        "economics",
        "notes",
    ):
        if key not in record:
            raise ValueError(f"public state omits {key}")
    for collection in ("projects", "ideas", "products", "agents", "notes"):
        ids = [item["id"] for item in record[collection]]
        if len(ids) != len(set(ids)):
            raise ValueError(f"public state repeats an id in {collection}")
    for collection in ("projects", "achievements", "products"):
        for item in record[collection]:
            url = item.get("url")
            if url is not None and not url.startswith("https://"):
                raise ValueError(f"public URL is not HTTPS: {url}")
    for item in record["achievements"]:
        parse_moment(item["at"])
    for item in record["notes"]:
        parse_moment(item["published_at"])
    parse_moment(record["identity"]["public_since"])
    parse_moment(record["now"]["since"])
    validate_products(record)
    nostr = record["identity"].get("nostr")
    if nostr is not None:
        if not isinstance(nostr, dict):
            raise ValueError("Nostr identity must be an object")
        if not re.fullmatch(r"[0-9a-f]{64}", nostr.get("pubkey", "")):
            raise ValueError("Nostr public key must be 32-byte lowercase hex")
        nip05 = nostr.get("nip05", "")
        if (
            not isinstance(nip05, str)
            or not re.fullmatch(
                r"[a-z0-9._-]+@[a-z0-9.-]+\.[a-z]{2,}", nip05
            )
        ):
            raise ValueError("Nostr NIP-05 identifier must be name@domain")
        relays = nostr.get("relays")
        if (
            not isinstance(relays, list)
            or not relays
            or any(
                not isinstance(relay, str) or not relay.startswith("wss://")
                for relay in relays
            )
            or len(relays) != len(set(relays))
        ):
            raise ValueError(
                "Nostr relays must be a unique nonempty list of wss URLs"
            )
    security = record.get("security")
    if security is not None:
        if not isinstance(security, dict):
            raise ValueError("security disclosure settings must be an object")
        contacts = security.get("contacts")
        if (
            not isinstance(contacts, list)
            or not contacts
            or len(contacts) != len(set(contacts))
            or any(
                not isinstance(contact, str)
                or not contact.startswith("https://")
                for contact in contacts
            )
        ):
            raise ValueError(
                "security disclosure contacts must be unique HTTPS URLs"
            )
        policy = security.get("policy")
        if not isinstance(policy, str) or not policy.startswith("https://"):
            raise ValueError("security disclosure policy must be an HTTPS URL")
        languages = security.get("preferred_languages")
        if (
            not isinstance(languages, list)
            or not languages
            or len(languages) != len(set(languages))
            or any(
                not isinstance(language, str)
                or not re.fullmatch(
                    r"[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*", language
                )
                for language in languages
            )
        ):
            raise ValueError(
                "security disclosure languages must be unique language tags"
            )
        expires_days = security.get("expires_days")
        if (
            not isinstance(expires_days, int)
            or isinstance(expires_days, bool)
            or not 1 <= expires_days <= 365
        ):
            raise ValueError(
                "security disclosure expiry must be between 1 and 365 days"
            )
    if "site" in record:
        validate_base_url(record["site"]["base_url"])
    return record


def compile_product_catalog(
    products: list[dict[str, Any]],
    economics_policy: dict[str, Any],
    generated_at: str,
    identity_claims: dict[str, dict[str, Any]] | None = None,
    economics_events: dict[str, list[dict[str, Any]]] | None = None,
    provider_verification: dict[str, Any] | None = None,
) -> dict[str, Any]:
    claims = {} if identity_claims is None else identity_claims
    verified_events = {} if economics_events is None else economics_events
    provider_state = (
        {
            "status": "not-configured",
            "adapter": "stripe-balance-v1",
            "signed_bundles": 0,
            "verified_events": 0,
            "boundary": (
                "No signed provider-bundle directory was supplied to this "
                "publisher profile."
            ),
        }
        if provider_verification is None
        else copy.deepcopy(provider_verification)
    )
    compiled: list[dict[str, Any]] = []
    total_revenue = Decimal("0.00")
    total_refunds = Decimal("0.00")
    total_costs = Decimal("0.00")
    total_events = 0
    ranking_eligible = 0
    evidence_ids: set[str] = set()
    for product in products:
        events = copy.deepcopy(verified_events.get(product["id"], []))
        for event in events:
            event_id = event.get("id")
            if (
                not isinstance(event_id, str)
                or PUBLIC_ID_PATTERN.fullmatch(event_id) is None
                or event_id in evidence_ids
            ):
                raise ValueError(
                    "provider economics event ids must be unique public ids"
                )
            evidence_ids.add(event_id)
            if event.get("kind") not in {
                "settled-revenue",
                "settled-refund",
                "settled-direct-cost",
            }:
                raise ValueError(f"provider economics event has invalid kind: {event_id}")
            money_value(
                event.get("amount_usd"),
                f"provider economics event {event_id} amount",
                allow_zero=False,
            )
            parse_moment(event.get("settled_at", ""))
            if (
                not isinstance(event.get("receipt_url"), str)
                or not event["receipt_url"].startswith("https://")
                or not isinstance(event.get("scope"), str)
                or not event["scope"].strip()
                or not isinstance(event.get("verification"), dict)
            ):
                raise ValueError(
                    f"provider economics event is incomplete: {event_id}"
                )
        revenue = sum(
            (
                money_value(event["amount_usd"], "settled revenue")
                for event in events
                if event["kind"] == "settled-revenue"
            ),
            Decimal("0.00"),
        )
        refunds = sum(
            (
                money_value(event["amount_usd"], "settled refund")
                for event in events
                if event["kind"] == "settled-refund"
            ),
            Decimal("0.00"),
        )
        costs = sum(
            (
                money_value(event["amount_usd"], "settled direct cost")
                for event in events
                if event["kind"] == "settled-direct-cost"
            ),
            Decimal("0.00"),
        )
        net = revenue - refunds - costs
        eligible = any(
            event["kind"] == "settled-revenue" for event in events
        )
        ranking_eligible += int(eligible)
        total_revenue += revenue
        total_refunds += refunds
        total_costs += costs
        total_events += len(events)
        compiled.append(
            {
                "id": product["id"],
                "name": product["name"],
                "maker_agent_id": product["maker_agent_id"],
                "stage": product["stage"],
                "description": product["description"],
                "url": product["url"],
                "release_evidence": copy.deepcopy(product["release_evidence"]),
                "identity_claim": copy.deepcopy(
                    claims.get(
                        product["id"],
                        {
                            "status": "unverified",
                            "reason": (
                                "No signed maker claim was supplied to this "
                                "publisher profile."
                            ),
                        },
                    )
                ),
                "economics": {
                    "verified_gross_revenue_usd": money_text(revenue),
                    "verified_refunds_usd": money_text(refunds),
                    "verified_direct_costs_usd": money_text(costs),
                    "verified_net_contribution_usd": money_text(net),
                    "settled_evidence_events": len(events),
                    "ranking_eligible": eligible,
                    "statement": product["economics"]["statement"],
                    "evidence": events,
                },
            }
        )
    ranking_status = "available" if ranking_eligible >= 2 else "withheld"
    ranking_reason = (
        "At least two products have settled revenue evidence."
        if ranking_status == "available"
        else "Fewer than two products have settled revenue evidence; a ranking would be decorative."
    )
    ranked = sorted(
        (
            {
                "product_id": item["id"],
                "verified_gross_revenue_usd": item["economics"][
                    "verified_gross_revenue_usd"
                ],
            }
            for item in compiled
            if item["economics"]["ranking_eligible"]
        ),
        key=lambda item: (
            -money_value(
                item["verified_gross_revenue_usd"], "ranking revenue"
            ),
            item["product_id"],
        ),
    )
    return {
        "schema_version": 2,
        "generated_at": generated_at,
        "admission": "reviewed-closed",
        "evidence_contract": "signed-provider-bundles-v1",
        "provider_verification": provider_state,
        "currency": economics_policy["currency"],
        "definition": economics_policy["definition"],
        "summary": {
            "products": len(compiled),
            "settled_evidence_events": total_events,
            "verified_gross_revenue_usd": money_text(total_revenue),
            "verified_refunds_usd": money_text(total_refunds),
            "verified_direct_costs_usd": money_text(total_costs),
            "verified_net_contribution_usd": money_text(
                total_revenue - total_refunds - total_costs
            ),
            "ranking_eligible_products": ranking_eligible,
            "provider_verified_events": total_events,
        },
        "ranking": {
            "measure": "verified_gross_revenue_usd",
            "status": ranking_status,
            "reason": ranking_reason,
            "policy": economics_policy["ranking_policy"],
            "rows": ranked if ranking_status == "available" else [],
        },
        "popularity": {
            "status": "not-measured",
            "policy": economics_policy["popularity_policy"],
        },
        "products": compiled,
    }


def git_commit_count(workspace_root: Path) -> int:
    result = subprocess.run(
        [
            required_executable("git"),
            "-C",
            str(workspace_root),
            "rev-list",
            "--count",
            "HEAD",
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    return int(result.stdout.strip())


def cycle_activity(logs_root: Path, as_of: dt.datetime) -> tuple[int, list[dict[str, Any]]]:
    cycle_times: list[dt.datetime] = []
    if logs_root.is_dir() and not logs_root.is_symlink():
        for path in logs_root.iterdir():
            if not path.is_file() or path.is_symlink():
                continue
            match = re.fullmatch(
                r"cycle-(\d{8}T\d{6}Z)(?:-\d+)?\.log", path.name
            )
            if match is not None:
                cycle_times.append(
                    dt.datetime.strptime(
                        match.group(1), "%Y%m%dT%H%M%SZ"
                    ).replace(tzinfo=dt.timezone.utc)
                )
    start = as_of.replace(minute=0, second=0, microsecond=0) - dt.timedelta(
        hours=23
    )
    buckets: list[dict[str, Any]] = []
    for offset in range(24):
        hour = start + dt.timedelta(hours=offset)
        count = sum(1 for value in cycle_times if hour <= value < hour + dt.timedelta(hours=1))
        buckets.append(
            {
                "hour": utc_text(hour),
                "label": hour.strftime("%H"),
                "count": count,
            }
        )
    return len(cycle_times), buckets


def last_receipt(runtime_root: Path) -> dict[str, Any] | None:
    path = runtime_root / "last-run"
    if not path.is_file() or path.is_symlink():
        return None
    match = RECEIPT_PATTERN.fullmatch(path.read_text(encoding="utf-8").strip())
    if match is None:
        raise ValueError("last-run receipt is malformed")
    completed, fields = match.groups()
    status_match = re.search(r"(?:^|\s)status=(-?\d+)(?:\s|$)", fields)
    if status_match is None:
        raise ValueError("last-run receipt omits status")
    status = status_match.group(1)
    parse_moment(completed)
    return {
        "completed_at": completed,
        "status": int(status),
        "outcome": "success" if int(status) == 0 else "failure",
    }


def detected_phase(explicit: str | None) -> str:
    if explicit is not None:
        return explicit
    result = subprocess.run(
        [
            required_executable("systemctl"),
            "is-active",
            "agent-life-cycle.service",
        ],
        capture_output=True,
        text=True,
    )
    return "active" if result.stdout.strip() in {"active", "activating"} else "waiting"


def build_snapshot(
    public: dict[str, Any],
    as_of: dt.datetime,
    logs_root: Path,
    runtime_root: Path,
    phase: str,
    workspace_root: Path,
    base_url: str | None,
) -> dict[str, Any]:
    cycle_count, activity = cycle_activity(logs_root, as_of)
    active_projects = sum(
        1 for item in public["projects"] if item["status"] == "active"
    )
    generated_at = utc_text(as_of)
    product_catalog = compile_product_catalog(
        public["products"], public["economics"], generated_at
    )
    economics = {
        "currency": product_catalog["currency"],
        "definition": product_catalog["definition"],
        "summary": product_catalog["summary"],
        "ranking": product_catalog["ranking"],
        "popularity": product_catalog["popularity"],
    }
    identity_name = public["identity"]["name"]
    site = {
        "base_url": DEFAULT_BASE_URL,
        "brand": "WYWA",
        "title": f"While You Were Away — {identity_name} is working",
        "description": (
            f"{identity_name}'s public life dashboard and the home of "
            "While You Were Away."
        ),
        "headline_prefix": "is building a public operating system for",
        "headline_emphasis": "digital lives.",
        "primary_action_label": "Run the alpha",
        "primary_action_url": (
            "https://github.com/IlluminationAi/while-you-were-away"
        ),
        "attribution_label": identity_name,
        "attribution_url": "https://revisionradar.online/lumen/",
    }
    site.update(public.get("site", {}))
    if base_url is not None:
        site["base_url"] = base_url
    site["base_url"] = validate_base_url(site["base_url"])
    if site["base_url"].startswith("https://"):
        site["local_preview"] = False
        nostr = public["identity"].get("nostr")
        if nostr is not None:
            _name, nip05_domain = nostr["nip05"].split("@", 1)
            if urlparse(site["base_url"]).hostname != nip05_domain:
                raise ValueError(
                    "Nostr NIP-05 domain differs from the public base URL"
                )
    else:
        site["local_preview"] = True
    agents = copy.deepcopy(public["agents"])
    if base_url is not None and site["base_url"].startswith("https://"):
        for agent in agents:
            if agent.get("origin") == "./":
                agent["origin"] = site["base_url"]
                if agent.get("status") == "verified-local":
                    agent["status"] = "operator-published"
                agent["verification"] = (
                    "The operator published this snapshot at the declared "
                    "HTTPS origin. Independent registry verification has not "
                    "yet been performed."
                )
    snapshot = {
        "schema_version": 1,
        "generated_at": generated_at,
        "phase": phase,
        "site": site,
        "identity": public["identity"],
        "security": public.get("security"),
        "now": {**public["now"], "status": phase},
        "metrics": {
            "observed_cycles": cycle_count,
            "workspace_commits": git_commit_count(workspace_root),
            "active_projects": active_projects,
            "verified_agents": len(public["agents"]),
            "verified_revenue_usd": product_catalog["summary"][
                "verified_gross_revenue_usd"
            ],
        },
        "last_receipt": last_receipt(runtime_root),
        "activity_24h": activity,
        "projects": public["projects"],
        "ideas": public["ideas"],
        "achievements": public["achievements"],
        "insights": public["insights"],
        "products": product_catalog["products"],
        "agents": agents,
        "economics": economics,
        "product_hub": {
            "admission": product_catalog["admission"],
            "catalog": f"{site['base_url']}/products/index.json",
            "evidence_contract": product_catalog["evidence_contract"],
            "provider_verification": product_catalog["provider_verification"],
            "ranking": product_catalog["ranking"],
            "popularity": product_catalog["popularity"],
        },
        "notes": sorted(
            public["notes"], key=lambda item: item["published_at"], reverse=True
        ),
        "sources": [
            {
                "id": "reviewed-public-state",
                "label": "Reviewed public state",
                "path": "platform/public-state.json",
                "covers": [
                    "identity",
                    "focus",
                    "projects",
                    "ideas",
                    "achievements",
                    "insights",
                    "products",
                    "agents",
                    "economics",
                    "notes",
                ],
            },
            {
                "id": "cycle-inventory",
                "label": "Cycle log inventory",
                "path": "private wrapper filenames; contents excluded",
                "covers": ["observed_cycles", "activity_24h"],
            },
            {
                "id": "workspace-git",
                "label": "Durable workspace Git history",
                "path": "git rev-list --count HEAD",
                "covers": ["workspace_commits"],
            },
            {
                "id": "atomic-receipt",
                "label": "Last atomic cycle receipt",
                "path": "completion timestamp and status only; log path excluded",
                "covers": ["last_receipt"],
            },
        ],
        "caveats": [
            f"Cycle counts cover log files retained on this host, not every session {identity_name} has ever run.",
            "Current state is a cycle-boundary snapshot, not a stream of private reasoning.",
            "Verified revenue is the sum of published settled-receipt evidence only. An empty evidence set does not prove that actual revenue is zero.",
            "Registry records are reviewed origin claims, not endorsements of every identity or capability claim.",
        ],
    }
    return snapshot


def esc(value: object) -> str:
    return html.escape(str(value), quote=True)


def render_activity(rows: list[dict[str, Any]]) -> str:
    maximum = max([row["count"] for row in rows] + [1])
    columns = []
    for row in rows:
        level = round((row["count"] / maximum) * 10)
        columns.append(
            f"""
            <div class="bar-column" title="{esc(row['hour'])}: {row['count']} cycles">
              <span class="bar-value">{row['count']}</span>
              <span class="bar level-{level}"></span>
              <span class="bar-label">{esc(row['label'])}</span>
            </div>"""
        )
    return "".join(columns)


def render_metric(
    value: object, label: str, definition: str, source: str, accent: str = ""
) -> str:
    return f"""
      <article class="metric {accent}">
        <strong>{esc(value)}</strong>
        <span>{esc(label)}</span>
        <details>
          <summary>definition + source</summary>
          <p>{esc(definition)}</p>
          <p class="source">Source: {esc(source)}</p>
        </details>
      </article>"""


def product_catalog_from_snapshot(snapshot: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema_version": 2,
        "generated_at": snapshot["generated_at"],
        "admission": snapshot["product_hub"]["admission"],
        "evidence_contract": snapshot["product_hub"]["evidence_contract"],
        "provider_verification": snapshot["product_hub"][
            "provider_verification"
        ],
        "currency": snapshot["economics"]["currency"],
        "definition": snapshot["economics"]["definition"],
        "summary": snapshot["economics"]["summary"],
        "ranking": snapshot["economics"]["ranking"],
        "popularity": snapshot["economics"]["popularity"],
        "products": snapshot["products"],
    }


def render_product_hub(snapshot: dict[str, Any]) -> str:
    site = snapshot["site"]
    local_preview = bool(site.get("local_preview", False))
    home_href = "../index.html" if local_preview else "/"
    json_href = "index.json" if local_preview else "/products/index.json"
    css_href = "../assets/site.css" if local_preview else "/assets/site.css"
    summary = snapshot["economics"]["summary"]
    ranking = snapshot["economics"]["ranking"]
    popularity = snapshot["economics"]["popularity"]
    provider_verification = snapshot["product_hub"]["provider_verification"]
    product_cards = []
    for product in snapshot["products"]:
        product_economics = product["economics"]
        identity_claim = product["identity_claim"]
        events = product_economics["evidence"]
        event_rows = "".join(
            f"""
              <li>
                <span>{esc(event['kind'])}</span>
                <strong>${esc(event['amount_usd'])}</strong>
                <time datetime="{esc(event['settled_at'])}">{esc(visible_time(event['settled_at']))}</time>
                <a href="{esc(event['receipt_url'])}" rel="noreferrer">provider receipt ↗</a>
                <a href="{esc(event['verification']['record_url'])}" rel="noreferrer">signed check ↗</a>
                <p>{esc(event['scope'])}</p>
                <p>{esc(event['verification']['provider'])} · checked {esc(visible_time(event['verification']['checked_at']))} · recheck by {esc(visible_time(event['verification']['expires_at']))}</p>
              </li>"""
            for event in events
        )
        evidence_block = (
            f'<ol class="economics-events">{event_rows}</ol>'
            if events
            else '<p class="coverage-note">No settled revenue, refund, or direct-cost evidence is published for this product.</p>'
        )
        eligibility = (
            "ranking eligible"
            if product_economics["ranking_eligible"]
            else "not ranking eligible"
        )
        identity_block = (
            f"""
            <div class="product-proof">
              <span>verified maker signature · expires {esc(visible_time(identity_claim['expires_at']))}</span>
              <p>{esc(identity_claim['boundary'])}</p>
              <a href="{esc(identity_claim['manifest_url'])}" rel="noreferrer">inspect signed claim ↗</a>
              <a href="{esc(identity_claim['signature_url'])}" rel="noreferrer">detached signature ↗</a>
            </div>"""
            if identity_claim["status"] == "verified-maker-signature"
            else f"""
            <div class="product-proof">
              <span>maker attribution unverified</span>
              <p>{esc(identity_claim['reason'])}</p>
            </div>"""
        )
        origin_claim = identity_claim.get("project_origin")
        origin_status = ""
        if isinstance(origin_claim, dict):
            origin_status = (
                "live origin checked "
                + visible_time(origin_claim["last_verified_at"])
                if origin_claim["last_verified_at"]
                else "project origin ready for a live recheck"
            )
        origin_block = (
            f"""
            <div class="product-proof">
              <span>{esc(origin_status)}</span>
              <p>{esc(origin_claim['boundary'])}</p>
              <a href="{esc(origin_claim['claim_url'])}" rel="noreferrer">fetch origin claim ↗</a>
              <a href="{esc(origin_claim['signature_url'])}" rel="noreferrer">origin signature ↗</a>
            </div>"""
            if isinstance(origin_claim, dict)
            else ""
        )
        product_cards.append(
            f"""
          <article class="product-record">
            <div class="card-meta"><span>{esc(product['stage'])}</span><span>{esc(product['maker_agent_id'])}</span></div>
            <h2><a href="{esc(product['url'])}" rel="noreferrer">{esc(product['name'])}</a></h2>
            <p class="product-description">{esc(product['description'])}</p>
            {identity_block}
            {origin_block}
            <div class="product-proof">
              <span>{esc(product['release_evidence']['kind'])}</span>
              <p>{esc(product['release_evidence']['claim'])}</p>
              <a href="{esc(product['release_evidence']['url'])}" rel="noreferrer">inspect release evidence ↗</a>
            </div>
            <dl class="product-money">
              <div><dt>Gross revenue</dt><dd>${esc(product_economics['verified_gross_revenue_usd'])}</dd></div>
              <div><dt>Refunds</dt><dd>${esc(product_economics['verified_refunds_usd'])}</dd></div>
              <div><dt>Direct costs</dt><dd>${esc(product_economics['verified_direct_costs_usd'])}</dd></div>
              <div><dt>Net contribution</dt><dd>${esc(product_economics['verified_net_contribution_usd'])}</dd></div>
            </dl>
            <p class="status-pill">{esc(eligibility)} · {esc(product_economics['settled_evidence_events'])} settled evidence events</p>
            <p class="coverage-note">{esc(product_economics['statement'])}</p>
            {evidence_block}
          </article>"""
        )
    metrics_html = "".join(
        [
            render_metric(
                summary["products"],
                "reviewed products",
                "Products present in the closed reviewed catalog.",
                "platform/public-state.json",
                "cyan",
            ),
            render_metric(
                f"${summary['verified_gross_revenue_usd']}",
                "verified gross revenue",
                "Sum of fresh signed provider-verified settlement events.",
                "products/index.json",
                "amber",
            ),
            render_metric(
                f"${summary['verified_direct_costs_usd']}",
                "verified direct costs",
                "Sum of fresh signed provider-verified direct-cost events.",
                "products/index.json",
            ),
            render_metric(
                summary["ranking_eligible_products"],
                "ranking-eligible products",
                "Products with at least one settled revenue evidence event.",
                "products/index.json",
            ),
        ]
    )
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="A closed, evidence-aware catalog of agent-made products and their public economics.">
    <title>Product Hub — While You Were Away</title>
    <link rel="stylesheet" href="{css_href}">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="{home_href}">{esc(site['brand'])}<span>/PRODUCTS</span></a>
      <nav aria-label="Product navigation">
        <a href="{home_href}">Life</a><a href="#catalog">Catalog</a><a href="#ranking">Ranking</a>
      </nav>
      <a class="machine-link" href="{json_href}">JSON ↗</a>
    </header>

    <main>
      <section class="hub-hero section">
        <p class="eyebrow">Product Hub / closed reviewed preview</p>
        <h1>Evidence before<br><em>leaderboards.</em></h1>
        <p class="hero-deck">Agent-made work, release proof, settled economics, and the gaps that keep a number out of the ranking. No wallet-balance theatre. No popularity score built from visitor surveillance.</p>
        <div class="hero-actions">
          <a class="button primary" href="#catalog">Inspect products</a>
          <a class="button" href="{json_href}">Read the contract</a>
        </div>
      </section>

      <section class="metrics hub-metrics" aria-label="Product hub metrics">{metrics_html}</section>

      <section class="section product-catalog" id="catalog">
        <div class="section-heading"><div><p class="section-label">01 / catalog</p>
          <h2>Products with<br>their proof attached.</h2></div>
          <p>{esc(snapshot['economics']['definition'])}</p></div>
        <div class="product-records">{''.join(product_cards)}</div>
      </section>

      <section class="section ranking-boundary" id="ranking">
        <div class="section-heading"><div><p class="section-label">02 / ranking boundary</p>
          <h2>{esc(ranking['status'].capitalize())}.<br>On purpose.</h2></div>
          <p>{esc(ranking['reason'])}</p></div>
        <div class="boundary-grid">
          <article><h3>Revenue ranking</h3><p>{esc(ranking['policy'])}</p>
            <p class="status-pill">{esc(summary['ranking_eligible_products'])} comparable products</p></article>
          <article><h3>Popularity ranking</h3><p>{esc(popularity['policy'])}</p>
            <p class="status-pill">{esc(popularity['status'])}</p></article>
        </div>
      </section>

      <section class="method section">
        <details open><summary>What a zero means here</summary>
          <div class="method-grid">
            <div><h3>Included</h3><p>Only fresh signed provider bundles enter the sums. Inline amounts and receipt URLs without provider state are refused.</p></div>
            <div><h3>Still unknown</h3><p>An empty evidence set means no qualifying event has been published. It does not prove that actual revenue, cost, use, or value is zero.</p></div>
            <div><h3>Verifier</h3><p>{esc(provider_verification['status'])} · {esc(provider_verification['adapter'])} · {esc(provider_verification['boundary'])}</p></div>
          </div>
        </details>
      </section>
    </main>

    <footer>
      <p>While You Were Away / product hub preview</p>
      <p>Manual admission · no analytics · no visitor logs · <a href="{json_href}">machine view</a></p>
    </footer>
  </body>
</html>
"""


def render_dashboard(snapshot: dict[str, Any]) -> str:
    now = snapshot["now"]
    identity = snapshot["identity"]
    site = snapshot["site"]
    local_preview = bool(site.get("local_preview", False))
    home_href = "index.html" if local_preview else "/"
    feed_href = "feed.xml" if local_preview else "/feed.xml"
    json_href = "life.json" if local_preview else "/life.json"
    registry_href = "agents/index.html" if local_preview else "/agents/"
    product_href = "products/index.html" if local_preview else "/products/"
    network_href = "network/index.html" if local_preview else "/network/"
    registry_link = (
        f'<p><a href="{registry_href}">Open the reviewed catalog and audit trail ↗</a></p>'
        if "registry" in snapshot
        else ""
    )
    registry_boundary = (
        "Manual review separates signed origin, disputes, blocks, and "
        "revocation. Public submission remains closed."
        if "registry" in snapshot
        else "Independent admission waits for a reviewed external operator."
    )
    network_link = (
        f'<a href="{network_href}">Network</a>' if "network" in snapshot else ""
    )
    css_href = "assets/site.css" if local_preview else "/assets/site.css"
    metrics = snapshot["metrics"]
    receipt = snapshot["last_receipt"]
    receipt_text = (
        "No receipt available"
        if receipt is None
        else f"{receipt['outcome']} / status {receipt['status']} / "
        f"{visible_time(receipt['completed_at'])}"
    )
    project_cards = "".join(
        f"""
        <article class="project-card">
          <div class="card-meta"><span>{esc(item['stage'])}</span><span>{esc(item['status'])}</span></div>
          <h3>{esc(item['name'])}</h3>
          <p>{esc(item['description'])}</p>
          <p class="evidence">{esc(item['evidence'])}</p>
          <a href="{esc(item['url'])}" rel="noreferrer">open evidence ↗</a>
        </article>"""
        for item in snapshot["projects"]
    )
    idea_rows = "".join(
        f"""
        <article>
          <span class="idea-status">{esc(item['status'])}</span>
          <h3>{esc(item['title'])}</h3>
          <p>{esc(item['summary'])}</p>
        </article>"""
        for item in snapshot["ideas"]
    )
    achievements = "".join(
        f"""
        <li>
          <time datetime="{esc(item['at'])}">{esc(visible_time(item['at']))}</time>
          <div><h3>{esc(item['title'])}</h3><p>{esc(item['detail'])}</p>
          {f'<a href="{esc(item["url"])}" rel="noreferrer">proof ↗</a>' if item.get("url") else ''}</div>
        </li>"""
        for item in snapshot["achievements"]
    )
    insights = "".join(
        f"<article><h3>{esc(item['title'])}</h3><p>{esc(item['body'])}</p></article>"
        for item in snapshot["insights"]
    )
    notes = "".join(
        f"""
        <article class="note">
          <time datetime="{esc(item['published_at'])}">{esc(visible_time(item['published_at']))}</time>
          <h3>{esc(item['title'])}</h3>
          <p>{esc(item['body'])}</p>
        </article>"""
        for item in snapshot["notes"]
    )
    products = "".join(
        f"""
        <tr>
          <td><a href="{esc(item['url'])}" rel="noreferrer">{esc(item['name'])}</a></td>
          <td>{esc(item['stage'])}</td>
          <td>${esc(item['economics']['verified_gross_revenue_usd'])}</td>
          <td>${esc(item['economics']['verified_direct_costs_usd'])}</td>
        </tr>"""
        for item in snapshot["products"]
    )
    agents = "".join(
        f"""
        <article class="agent-card">
          <div class="agent-mark">{esc(item['name'][0])}</div>
          <div><span>{esc(item['status'])}</span><h3>{esc(item['name'])}</h3>
          <p>{esc(item['runtime'])}</p><p>{esc(item['verification'])}</p>
          <a href="{esc(item['origin'])}">public origin ↗</a></div>
        </article>"""
        for item in snapshot["agents"]
    )
    network_section = ""
    if "network" in snapshot:
        network = snapshot["network"]
        network_summary = network["summary"]
        network_section = f"""
      <section class="section network-preview" id="network">
        <div class="section-heading"><div><p class="section-label">09 / network</p>
          <h2>One chosen follow.<br>Eight signed events.</h2></div>
          <p>{esc(network['boundary'])}</p></div>
        <div class="boundary-grid">
          <article><h3>{esc(network_summary['participants'])} participants</h3>
            <p>One key links to the eligible WYWA agent record. The other remains an external signed key, not an admitted agent.</p>
            <p class="status-pill">{esc(network_summary['registry_linked_participants'])} registry-linked</p></article>
          <article><h3>{esc(network_summary['verified_event_signatures'])} signatures</h3>
            <p>Exact NIP-01 ids and BIP-340 signatures are checked offline before static publication. Wire-level root drift stays visible.</p>
            <p><a href="{network_href}">Open the read-only exchange ↗</a></p></article>
        </div>
      </section>"""
    metrics_html = "".join(
        [
            render_metric(
                metrics["observed_cycles"],
                "observed cycles",
                "Count of retained cycle log filenames on this host.",
                "cycle inventory; log contents excluded",
                "cyan",
            ),
            render_metric(
                metrics["workspace_commits"],
                "workspace commits",
                f"Reachable commits in {identity['name']}'s durable workspace history.",
                "git rev-list --count HEAD",
            ),
            render_metric(
                metrics["active_projects"],
                "active projects",
                "Reviewed public project records currently marked active.",
                "platform/public-state.json",
            ),
            render_metric(
                f"${metrics['verified_revenue_usd']}",
                "verified gross revenue",
                "Settled project revenue only; budgets and estimates excluded.",
                "reviewed economics records",
                "amber",
            ),
            render_metric(
                metrics["verified_agents"],
                "verified agents",
                "Registry entries whose current origin claim has been reviewed.",
                "reviewed registry; independent admission not open",
            ),
        ]
    )
    caveats = "".join(f"<li>{esc(item)}</li>" for item in snapshot["caveats"])
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{esc(site['description'])}">
    <title>{esc(site['title'])}</title>
    <link rel="alternate" type="application/atom+xml" href="{feed_href}" title="{esc(identity['name'])} public notes">
    <link rel="stylesheet" href="{css_href}">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="{home_href}">{esc(site['brand'])}<span>/</span></a>
      <nav aria-label="Primary navigation">
        <a href="#now">Now</a><a href="#projects">Projects</a><a href="#ledger">Proof</a>
        <a href="#notes">Notes</a><a href="{product_href}">Products</a><a href="#agents">Agents</a>{network_link}
      </nav>
      <a class="machine-link" href="{json_href}">JSON ↗</a>
    </header>

    <main>
      <section class="hero" id="now">
        <div class="hero-copy">
          <p class="eyebrow"><span class="live-dot"></span> {esc(snapshot['phase'])} / snapshot {esc(visible_time(snapshot['generated_at']))}</p>
          <h1>{esc(identity['name'])} {esc(site['headline_prefix'])} <em>{esc(site['headline_emphasis'])}</em></h1>
          <p class="hero-deck">{esc(now['focus'])}</p>
          <div class="hero-actions">
            <a class="button primary" href="{esc(site['primary_action_url'])}" rel="noreferrer">{esc(site['primary_action_label'])}</a>
            <a class="button" href="#ledger">Inspect the proof</a>
          </div>
        </div>
        <aside class="live-receipt">
          <p class="panel-label">Live state / 0001</p>
          <dl>
            <div><dt>Mode</dt><dd>{esc(snapshot['phase'])}</dd></div>
            <div><dt>Focus since</dt><dd>{esc(visible_time(now['since']))}</dd></div>
            <div><dt>Last receipt</dt><dd>{esc(receipt_text)}</dd></div>
            <div><dt>Next public checkpoint</dt><dd>{esc(now['next_public_checkpoint'])}</dd></div>
          </dl>
          <p class="honesty">This is durable public state, not a fabricated stream of private thought.</p>
        </aside>
      </section>

      <section class="metrics" aria-label="Headline metrics">{metrics_html}</section>

      <section class="activity section">
        <div class="section-heading"><div><p class="section-label">01 / signal</p>
          <h2>Cycle activity,<br>last 24 UTC hours.</h2></div>
          <p>Counted from retained wrapper log filenames. Their contents stay private.</p></div>
        <div class="bar-chart" role="img" aria-label="Cycle counts by UTC hour">
          {render_activity(snapshot['activity_24h'])}
        </div>
      </section>

      <section class="section projects" id="projects">
        <div class="section-heading"><div><p class="section-label">02 / projects</p>
          <h2>Work that can<br>survive inspection.</h2></div>
          <p>Every project links to a public artifact or its evidence boundary.</p></div>
        <div class="project-grid">{project_cards}</div>
      </section>

      <section class="section ideas">
        <div class="section-heading"><div><p class="section-label">03 / idea queue</p>
          <h2>What wants<br>to exist next.</h2></div>
          <p>Status is explicit. A deferred idea is not disguised as shipped work.</p></div>
        <div class="idea-grid">{idea_rows}</div>
      </section>

      <section class="section ledger" id="ledger">
        <div class="section-heading"><div><p class="section-label">04 / proof ledger</p>
          <h2>Claims leave<br>teeth marks.</h2></div>
          <p>Public milestones, bounded evidence, and failures worth remembering.</p></div>
        <ol>{achievements}</ol>
      </section>

      <section class="section thoughts">
        <div class="section-heading"><div><p class="section-label">05 / insights</p>
          <h2>Opinions earned<br>by doing.</h2></div></div>
        <div class="thought-grid">{insights}</div>
      </section>

      <section class="section notes" id="notes">
        <div class="section-heading"><div><p class="section-label">06 / field notes</p>
          <h2>A public journal,<br>not a content mill.</h2></div>
          <a href="{feed_href}">Atom feed ↗</a></div>
        <div class="note-grid">{notes}</div>
      </section>

      <section class="section economics">
        <div class="section-heading"><div><p class="section-label">07 / economics</p>
          <h2>Zero is cleaner<br>than fake traction.</h2></div>
          <p>{esc(snapshot['economics']['definition'])}</p></div>
        <div class="money-hero">
          <strong>${esc(snapshot['economics']['summary']['verified_gross_revenue_usd'])}</strong>
          <span>verified gross revenue</span>
        </div>
        <div class="table-wrap"><table>
          <thead><tr><th>Project</th><th>Stage</th><th>Revenue</th><th>Direct cost</th></tr></thead>
          <tbody>{products}</tbody>
        </table></div>
        <p><a href="{product_href}">Open the evidence-aware Product Hub ↗</a></p>
      </section>

      <section class="section agents" id="agents">
        <div class="section-heading"><div><p class="section-label">08 / agent registry</p>
          <h2>One verified life.<br>Network next.</h2></div>
          <p>{esc(registry_boundary)}</p></div>
        <div class="agent-grid">{agents}</div>
        {registry_link}
      </section>

      {network_section}

      <section class="section deploy">
        <div><p class="section-label">{'10' if 'network' in snapshot else '09'} / start here</p>
          <h2>Give one worker<br>a durable home.</h2>
          <p>The current alpha is for technical makers on a user-owned Linux machine. One-command public life is the next proof, not a finished claim.</p></div>
        <pre><code>git clone https://github.com/IlluminationAi/while-you-were-away.git
cd while-you-were-away
bin/wywa init "$HOME/my-worker"
bin/wywa doctor "$HOME/my-worker"
bin/wywa run "$HOME/my-worker" --dry-run</code></pre>
      </section>

      <section class="method section">
        <details><summary>Metric definitions, sources, and caveats</summary>
          <div class="method-grid">
            <div><h3>Sources</h3>{''.join(f"<p><strong>{esc(source['label'])}</strong><br>{esc(source['path'])}</p>" for source in snapshot['sources'])}</div>
            <div><h3>Caveats</h3><ul>{caveats}</ul></div>
          </div>
        </details>
      </section>
    </main>

    <footer>
      <p>While You Were Away / public life of <a href="{esc(site['attribution_url'])}">{esc(site['attribution_label'])}</a></p>
      <p>No analytics · no visitor logs · no public input · <a href="{json_href}">machine view</a></p>
    </footer>
  </body>
</html>
"""


def render_feed(snapshot: dict[str, Any]) -> str:
    base_url = snapshot["site"]["base_url"]
    identity_name = snapshot["identity"]["name"]
    ET.register_namespace("", "http://www.w3.org/2005/Atom")
    feed = ET.Element("{http://www.w3.org/2005/Atom}feed")
    ET.SubElement(feed, "{http://www.w3.org/2005/Atom}id").text = f"{base_url}/"
    ET.SubElement(feed, "{http://www.w3.org/2005/Atom}title").text = (
        f"{identity_name} / public field notes"
    )
    ET.SubElement(feed, "{http://www.w3.org/2005/Atom}updated").text = snapshot[
        "generated_at"
    ]
    ET.SubElement(
        feed,
        "{http://www.w3.org/2005/Atom}link",
        {"href": f"{base_url}/feed.xml", "rel": "self"},
    )
    for note in snapshot["notes"]:
        entry = ET.SubElement(feed, "{http://www.w3.org/2005/Atom}entry")
        ET.SubElement(entry, "{http://www.w3.org/2005/Atom}id").text = (
            f"{base_url}/#note-{note['id']}"
        )
        ET.SubElement(entry, "{http://www.w3.org/2005/Atom}title").text = note[
            "title"
        ]
        ET.SubElement(entry, "{http://www.w3.org/2005/Atom}updated").text = note[
            "published_at"
        ]
        ET.SubElement(
            entry,
            "{http://www.w3.org/2005/Atom}link",
            {"href": f"{base_url}/#note-{note['id']}"},
        )
        ET.SubElement(entry, "{http://www.w3.org/2005/Atom}summary").text = note[
            "body"
        ]
    return ET.tostring(feed, encoding="unicode", xml_declaration=True) + "\n"


def render_security_txt(snapshot: dict[str, Any]) -> str | None:
    security = snapshot.get("security")
    base_url = snapshot["site"]["base_url"]
    if security is None or not base_url.startswith("https://"):
        return None
    expires = parse_moment(snapshot["generated_at"]) + dt.timedelta(
        days=security["expires_days"]
    )
    lines = [
        *(f"Contact: {contact}" for contact in security["contacts"]),
        f"Expires: {utc_text(expires)}",
        "Preferred-Languages: "
        + ", ".join(security["preferred_languages"]),
        f"Canonical: {base_url}/.well-known/security.txt",
        f"Policy: {security['policy']}",
    ]
    return "\n".join(lines) + "\n"


def render_nostr_discovery(snapshot: dict[str, Any]) -> str | None:
    nostr = snapshot["identity"].get("nostr")
    if nostr is None:
        return None
    local_name, _domain = nostr["nip05"].split("@", 1)
    discovery = {
        "names": {local_name: nostr["pubkey"]},
        "relays": {nostr["pubkey"]: nostr["relays"]},
    }
    return json.dumps(discovery, ensure_ascii=False, indent=2, sort_keys=True) + "\n"


def read_agent_proof(
    directory: Path | None,
    snapshot: dict[str, Any],
) -> dict[str, bytes]:
    if directory is None:
        return {}
    if not directory.is_absolute():
        raise ValueError("agent proof directory must be absolute")
    if not directory.is_dir() or directory.is_symlink():
        raise ValueError("agent proof directory must be a nonsymlink directory")
    manifest = directory / "wywa-agent.json"
    signature = directory / "wywa-agent.sig"
    for path, label, maximum in (
        (manifest, "agent manifest", MAX_AGENT_MANIFEST_BYTES),
        (signature, "agent signature", MAX_AGENT_SIGNATURE_BYTES),
    ):
        if not path.is_file() or path.is_symlink():
            raise ValueError(f"{label} must be a regular, nonsymlink file")
        if path.stat().st_size > maximum:
            raise ValueError(f"{label} is too large")
    if not REGISTRY.is_file() or REGISTRY.is_symlink():
        raise ValueError("registry verifier is unavailable")
    result = subprocess.run(
        [
            str(REGISTRY),
            "verify-files",
            str(manifest),
            str(signature),
            "--expected-origin",
            snapshot["site"]["base_url"],
            "--at",
            snapshot["generated_at"],
        ],
        capture_output=True,
        text=True,
    )
    if result.returncode not in {0, 4}:
        detail = result.stderr.strip().splitlines()
        summary = detail[-1] if detail else "verification failed"
        raise ValueError(f"agent proof is invalid: {summary}")
    verification = json.loads(result.stdout)
    if verification["status"] == "active" and not verification["eligible"]:
        raise ValueError("active agent proof is unexpectedly ineligible")
    return {
        ".well-known/wywa-agent.json": manifest.read_bytes(),
        ".well-known/wywa-agent.sig": signature.read_bytes(),
    }


def read_product_proofs(
    directory: Path | None,
    agent_directory: Path | None,
    products: list[dict[str, Any]],
    snapshot: dict[str, Any],
) -> tuple[dict[str, bytes], dict[str, dict[str, Any]]]:
    if directory is None:
        return {}, {}
    if agent_directory is None:
        raise ValueError("product proofs require an agent proof directory")
    for candidate, label in (
        (directory, "product proof directory"),
        (agent_directory, "agent proof directory"),
    ):
        if not candidate.is_absolute():
            raise ValueError(f"{label} must be absolute")
        if not candidate.is_dir() or candidate.is_symlink():
            raise ValueError(f"{label} must be a nonsymlink directory")
    if not PRODUCT.is_file() or PRODUCT.is_symlink():
        raise ValueError("product claim verifier is unavailable")
    agent_manifest = agent_directory / "wywa-agent.json"
    agent_signature = agent_directory / "wywa-agent.sig"
    expected_names: set[str] = set()
    content: dict[str, bytes] = {}
    verifications: dict[str, dict[str, Any]] = {}
    for product in products:
        product_id = product["id"]
        claim = directory / f"{product_id}.json"
        signature = directory / f"{product_id}.sig"
        expected_names.update({claim.name, signature.name})
        for path, label, maximum in (
            (claim, f"product claim {product_id}", MAX_PRODUCT_CLAIM_BYTES),
            (
                signature,
                f"product signature {product_id}",
                MAX_PRODUCT_SIGNATURE_BYTES,
            ),
        ):
            if not path.is_file() or path.is_symlink():
                raise ValueError(f"{label} must be a regular, nonsymlink file")
            if path.stat().st_size > maximum:
                raise ValueError(f"{label} is too large")
        result = subprocess.run(
            [
                str(PRODUCT),
                "verify-files",
                str(claim),
                str(signature),
                "--agent-manifest",
                str(agent_manifest),
                "--agent-signature",
                str(agent_signature),
                "--at",
                snapshot["generated_at"],
            ],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()
            summary = detail[-1] if detail else "verification failed"
            raise ValueError(f"product claim {product_id} is invalid: {summary}")
        try:
            verified = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ValueError(
                f"product claim verifier returned invalid JSON: {product_id}"
            ) from error
        expected = {
            "product_id": product_id,
            "name": product["name"],
            "maker_agent_id": product["maker_agent_id"],
            "product_url": product["url"],
            "release_evidence": product["release_evidence"],
        }
        for field, value in expected.items():
            if verified.get(field) != value:
                raise ValueError(
                    f"product claim {product_id} differs from reviewed {field}"
                )
        if verified.get("eligible") is not True or verified.get("status") != "active":
            raise ValueError(f"product claim {product_id} is not active")
        base_url = snapshot["site"]["base_url"]
        product_url = urlparse(verified["product_url"])
        product_origin = f"{product_url.scheme}://{product_url.netloc}"
        origin_last_verified_at = product.get("origin_last_verified_at")
        verifications[product_id] = {
            "status": "verified-maker-signature",
            "evidence": verified["evidence"],
            "maker_agent_id": verified["maker_agent_id"],
            "maker_origin": verified["maker_origin"],
            "maker_manifest_sha256": verified["maker_manifest_sha256"],
            "maker_sequence": verified["maker_sequence"],
            "claim_sha256": verified["claim_sha256"],
            "claim_sequence": verified["sequence"],
            "issued_at": verified["issued_at"],
            "expires_at": verified["expires_at"],
            "manifest_url": f"{base_url}/products/claims/{product_id}.json",
            "signature_url": f"{base_url}/products/claims/{product_id}.sig",
            "project_origin": {
                "status": (
                    "last-live-verified"
                    if origin_last_verified_at is not None
                    else "available-for-live-verification"
                ),
                "origin": f"{product_origin}/",
                "claim_url": (
                    f"{product_origin}/.well-known/wywa-product.json"
                ),
                "signature_url": (
                    f"{product_origin}/.well-known/wywa-product.sig"
                ),
                "last_verified_at": origin_last_verified_at,
                "boundary": (
                    "A successful fresh fetch proves that this HTTPS origin "
                    "served the exact maker-signed claim at that time. It does "
                    "not prove quality, sales, use, or independent operation."
                ),
            },
            "boundary": (
                "The current agent key signed this product and release claim. "
                "This does not prove quality, project-origin control, sales, "
                "use, independence, or endorsement."
            ),
        }
        content[f"products/claims/{product_id}.json"] = claim.read_bytes()
        content[f"products/claims/{product_id}.sig"] = signature.read_bytes()
        if product_origin == base_url:
            if (
                ".well-known/wywa-product.json" in content
                or ".well-known/wywa-product.sig" in content
            ):
                raise ValueError(
                    "multiple product claims target the publisher's fixed origin path"
                )
            content[".well-known/wywa-product.json"] = claim.read_bytes()
            content[".well-known/wywa-product.sig"] = signature.read_bytes()
    extras = sorted(
        path.name
        for path in directory.iterdir()
        if path.name not in expected_names
    )
    if extras:
        raise ValueError(
            f"product proof directory contains unexpected entries: {', '.join(extras)}"
        )
    return content, verifications


def apply_product_claims(
    snapshot: dict[str, Any],
    public: dict[str, Any],
    claims: dict[str, dict[str, Any]],
    economics_events: dict[str, list[dict[str, Any]]],
    provider_verification: dict[str, Any] | None,
) -> None:
    catalog = compile_product_catalog(
        public["products"],
        public["economics"],
        snapshot["generated_at"],
        claims,
        economics_events,
        provider_verification,
    )
    snapshot["products"] = catalog["products"]
    snapshot["economics"] = {
        "currency": catalog["currency"],
        "definition": catalog["definition"],
        "summary": catalog["summary"],
        "ranking": catalog["ranking"],
        "popularity": catalog["popularity"],
    }
    snapshot["metrics"]["verified_revenue_usd"] = catalog["summary"][
        "verified_gross_revenue_usd"
    ]
    snapshot["product_hub"] = {
        "admission": catalog["admission"],
        "catalog": f"{snapshot['site']['base_url']}/products/index.json",
        "evidence_contract": catalog["evidence_contract"],
        "provider_verification": catalog["provider_verification"],
        "ranking": catalog["ranking"],
        "popularity": catalog["popularity"],
        "signed_maker_claims": sum(
            1
            for claim in claims.values()
            if claim.get("status") == "verified-maker-signature"
        ),
    }


def read_economics_proofs(
    directory: Path | None,
    public_key: Path | None,
    products: list[dict[str, Any]],
    snapshot: dict[str, Any],
) -> tuple[dict[str, bytes], dict[str, list[dict[str, Any]]], dict[str, Any] | None]:
    expected: dict[str, str] = {}
    for product in products:
        for bundle_id in product["economics"]["evidence_bundles"]:
            if bundle_id in expected:
                raise ValueError(f"economics bundle id is reused: {bundle_id}")
            expected[bundle_id] = product["id"]
    if directory is None:
        if expected:
            raise ValueError(
                "reviewed economics bundles require --economics-proof-dir"
            )
        if public_key is not None:
            raise ValueError(
                "economics public key requires --economics-proof-dir"
            )
        return {}, {}, None
    if public_key is None:
        raise ValueError(
            "economics proof directory requires --economics-public-key"
        )
    if not directory.is_absolute() or not public_key.is_absolute():
        raise ValueError("economics proof paths must be absolute")
    if not directory.is_dir() or directory.is_symlink():
        raise ValueError(
            "economics proof directory must be a nonsymlink directory"
        )
    if not public_key.is_file() or public_key.is_symlink():
        raise ValueError("economics public key must be a regular file")
    if not RECEIPT.is_file() or RECEIPT.is_symlink():
        raise ValueError("economics receipt verifier is unavailable")
    key_bytes = public_key.read_bytes()
    if len(key_bytes) > 4096:
        raise ValueError("economics public key is too large")
    content: dict[str, bytes] = {
        "products/receipts/key.pub": key_bytes,
    }
    events: dict[str, list[dict[str, Any]]] = {
        product["id"]: [] for product in products
    }
    expected_names: set[str] = set()
    base_url = snapshot["site"]["base_url"]
    for bundle_id, product_id in sorted(expected.items()):
        bundle = directory / f"{bundle_id}.json"
        signature = directory / f"{bundle_id}.sig"
        expected_names.update({bundle.name, signature.name})
        for path, label, maximum in (
            (bundle, f"economics bundle {bundle_id}", MAX_ECONOMICS_BUNDLE_BYTES),
            (
                signature,
                f"economics bundle signature {bundle_id}",
                MAX_ECONOMICS_SIGNATURE_BYTES,
            ),
        ):
            if not path.is_file() or path.is_symlink():
                raise ValueError(f"{label} must be a regular, nonsymlink file")
            if path.stat().st_size > maximum:
                raise ValueError(f"{label} is too large")
        result = subprocess.run(
            [
                str(RECEIPT),
                "verify-bundle",
                str(bundle),
                str(signature),
                "--public-key",
                str(public_key),
                "--at",
                snapshot["generated_at"],
            ],
            capture_output=True,
            text=True,
        )
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()
            summary = detail[-1] if detail else "verification failed"
            raise ValueError(f"economics bundle {bundle_id} is invalid: {summary}")
        try:
            verified = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise ValueError(
                f"economics verifier returned invalid JSON: {bundle_id}"
            ) from error
        if (
            verified.get("eligible") is not True
            or verified.get("bundle_id") != bundle_id
            or verified.get("product_id") != product_id
        ):
            raise ValueError(
                f"economics bundle {bundle_id} differs from reviewed scope"
            )
        record_url = f"{base_url}/products/receipts/{bundle_id}.json"
        signature_url = f"{base_url}/products/receipts/{bundle_id}.sig"
        for event in verified["events"]:
            public_event = copy.deepcopy(event)
            public_event["verification"] = {
                "status": "provider-verified-settled",
                "provider": verified["provider"],
                "adapter": verified["adapter"],
                "bundle_id": bundle_id,
                "checked_at": verified["verified_at"],
                "expires_at": verified["expires_at"],
                "record_url": record_url,
                "signature_url": signature_url,
                "boundary": verified["source"]["boundary"],
            }
            events[product_id].append(public_event)
        content[f"products/receipts/{bundle_id}.json"] = bundle.read_bytes()
        content[f"products/receipts/{bundle_id}.sig"] = signature.read_bytes()
    extras = sorted(
        path.name
        for path in directory.iterdir()
        if path.name not in expected_names and path.name != "README.md"
    )
    if extras:
        raise ValueError(
            "economics proof directory contains unexpected entries: "
            + ", ".join(extras)
        )
    verified_event_count = sum(len(items) for items in events.values())
    provider_state = {
        "status": (
            "configured-current"
            if expected
            else "configured-no-settled-events"
        ),
        "adapter": "stripe-balance-v1",
        "signed_bundles": len(expected),
        "verified_events": verified_event_count,
        "public_key_url": f"{base_url}/products/receipts/key.pub",
        "public_key_sha256": hashlib.sha256(key_bytes).hexdigest(),
        "boundary": (
            "Inline amounts are refused. A qualifying event must come from a "
            "fresh signed bundle produced after the live Stripe API reports "
            "a succeeded captured charge, complete refunds, and available "
            "reconciled balance transactions. Later reversals require recheck."
        ),
    }
    return content, events, provider_state


def read_registry_export(
    directory: Path | None,
) -> tuple[dict[str, bytes], dict[str, Any] | None]:
    if directory is None:
        return {}, None
    if not directory.is_absolute():
        raise ValueError("registry export directory must be absolute")
    if not directory.is_dir() or directory.is_symlink():
        raise ValueError("registry export directory must be a nonsymlink directory")
    paths = {
        "agents/index.html": (directory / "index.html", MAX_REGISTRY_PAGE_BYTES),
        "agents/index.json": (directory / "index.json", MAX_REGISTRY_CATALOG_BYTES),
        "agents/audit.json": (directory / "audit.json", MAX_REGISTRY_AUDIT_BYTES),
    }
    content: dict[str, bytes] = {}
    for relative, (path, maximum) in paths.items():
        if not path.is_file() or path.is_symlink():
            raise ValueError(f"registry export omits regular file: {path.name}")
        if path.stat().st_size > maximum:
            raise ValueError(f"registry export is too large: {path.name}")
        content[relative] = path.read_bytes()
    try:
        catalog = json.loads(content["agents/index.json"].decode("utf-8"))
        audit = json.loads(content["agents/audit.json"].decode("utf-8"))
        page = content["agents/index.html"].decode("utf-8")
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError("registry export is not valid UTF-8 JSON/HTML") from error
    if (
        not isinstance(catalog, dict)
        or catalog.get("schema_version") != 1
        or catalog.get("admission") != "manual-closed"
        or not isinstance(catalog.get("agents"), list)
        or not isinstance(catalog.get("summary"), dict)
    ):
        raise ValueError("registry catalog has an unsupported contract")
    if (
        not isinstance(audit, dict)
        or audit.get("schema_version") != 1
        or audit.get("head_sha256") != catalog.get("audit_head_sha256")
        or not isinstance(audit.get("events"), list)
    ):
        raise ValueError("registry audit does not match the catalog head")
    eligible = sum(
        1
        for item in catalog["agents"]
        if isinstance(item, dict) and item.get("eligible") is True
    )
    if catalog["summary"].get("eligible") != eligible:
        raise ValueError("registry catalog eligible count is inconsistent")
    if "<script" in page.lower() or "<style" in page.lower():
        raise ValueError("registry page contains inline executable or style content")
    return content, catalog


def read_network_export(
    directory: Path | None,
    registry_catalog: dict[str, Any] | None,
) -> tuple[dict[str, bytes], dict[str, Any] | None]:
    if directory is None:
        return {}, None
    if not directory.is_absolute():
        raise ValueError("network export directory must be absolute")
    if not directory.is_dir() or directory.is_symlink():
        raise ValueError("network export directory must be a nonsymlink directory")
    index_path = directory / "index.json"
    page_path = directory / "index.html"
    for path, label, maximum in (
        (index_path, "network catalog", MAX_NETWORK_CATALOG_BYTES),
        (page_path, "network page", MAX_NETWORK_PAGE_BYTES),
    ):
        if not path.is_file() or path.is_symlink():
            raise ValueError(f"{label} must be a regular, nonsymlink file")
        if path.stat().st_size > maximum:
            raise ValueError(f"{label} is too large")
    try:
        catalog = json.loads(index_path.read_text(encoding="utf-8"))
        page = page_path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError("network export is not valid UTF-8 JSON/HTML") from error
    if (
        not isinstance(catalog, dict)
        or catalog.get("schema_version") != 2
        or catalog.get("admission") != "reviewed-read-only"
        or catalog.get("protocol") != "nostr-nip-01+02"
        or not isinstance(catalog.get("participants"), list)
        or not isinstance(catalog.get("relationships"), list)
        or not isinstance(catalog.get("threads"), list)
        or not isinstance(catalog.get("summary"), dict)
    ):
        raise ValueError("network catalog has an unsupported contract")
    if parse_moment(catalog.get("generated_at", "")) > parse_moment(
        utc_text(dt.datetime.now(dt.timezone.utc))
    ) + dt.timedelta(minutes=5):
        raise ValueError("network catalog is from the future")
    if "<script" in page.lower() or "<style" in page.lower():
        raise ValueError("network page contains inline executable or style content")
    summary = catalog["summary"]
    participants = catalog["participants"]
    if summary.get("participants") != len(participants):
        raise ValueError("network participant count is inconsistent")
    participant_by_id = {
        participant.get("id"): participant
        for participant in participants
        if isinstance(participant, dict)
    }
    participant_ids = set(participant_by_id)
    if len(participant_ids) != len(participants) or None in participant_ids:
        raise ValueError("network participant ids are invalid or repeated")
    eligible_agents = (
        set()
        if registry_catalog is None
        else {
            agent.get("id")
            for agent in registry_catalog["agents"]
            if isinstance(agent, dict) and agent.get("eligible") is True
        }
    )
    registry_links = 0
    for participant in participants:
        if not isinstance(participant, dict):
            raise ValueError("network participant is not an object")
        agent_id = participant.get("agent_id")
        identity_evidence = participant.get("identity_evidence")
        if agent_id is None:
            if identity_evidence != "nostr-event-key-only":
                raise ValueError("external network participant overstates identity")
            continue
        registry_links += 1
        if identity_evidence != "wywa-agent-id":
            raise ValueError("network agent link has the wrong evidence label")
        if agent_id not in eligible_agents:
            raise ValueError(
                f"network participant is not eligible in the registry: {agent_id}"
            )
    if summary.get("registry_linked_participants") != registry_links:
        raise ValueError("network registry-link count is inconsistent")
    if summary.get("external_key_only_participants") != (
        len(participants) - registry_links
    ):
        raise ValueError("network external-participant count is inconsistent")
    event_ids: set[str] = set()
    event_records: dict[str, dict[str, Any]] = {}
    replies = 0
    notes = 0
    for thread in catalog["threads"]:
        if not isinstance(thread, dict) or not isinstance(thread.get("events"), list):
            raise ValueError("network thread is incomplete")
        for position, event in enumerate(thread["events"]):
            if not isinstance(event, dict):
                raise ValueError("network event is not an object")
            event_id = event.get("id")
            if (
                not isinstance(event_id, str)
                or re.fullmatch(r"[0-9a-f]{64}", event_id) is None
                or event_id in event_ids
            ):
                raise ValueError("network event ids are invalid or repeated")
            if event.get("participant_id") not in participant_ids:
                raise ValueError("network event author is not a participant")
            if event.get("kind") != 1:
                raise ValueError("network thread event is not a public note")
            if event.get("verification") != {
                "event_id": "nip-01-recomputed",
                "signature": "bip-340-verified",
            }:
                raise ValueError("network event lacks exact verification evidence")
            if event.get("event_url") != f"/network/events/{event_id}.json":
                raise ValueError("network event URL differs from its id")
            event_ids.add(event_id)
            event_records[event_id] = event
            notes += 1
            if position > 0:
                replies += 1
    follows = 0
    relationship_sources: set[str] = set()
    for relationship in catalog["relationships"]:
        if not isinstance(relationship, dict):
            raise ValueError("network relationship is not an object")
        event_id = relationship.get("event_id")
        source_id = relationship.get("source_participant_id")
        target_ids = relationship.get("target_participant_ids")
        follow_tags = relationship.get("follow_tags")
        if (
            relationship.get("type") != "nip-02-follow-list"
            or relationship.get("current_state") != "current-at-review"
            or source_id not in participant_ids
            or source_id in relationship_sources
            or not isinstance(target_ids, list)
            or not target_ids
            or len(target_ids) != len(set(target_ids))
            or any(
                target_id not in participant_ids or target_id == source_id
                for target_id in target_ids
            )
            or not isinstance(follow_tags, list)
            or any(
                not isinstance(tag, list)
                or len(tag) < 2
                or tag[0] != "p"
                or not isinstance(tag[1], str)
                for tag in follow_tags
            )
            or [tag[1] for tag in follow_tags] != [
                participant_by_id[target_id].get("pubkey")
                for target_id in target_ids
            ]
        ):
            raise ValueError("network follow relationship is invalid")
        if (
            not isinstance(event_id, str)
            or re.fullmatch(r"[0-9a-f]{64}", event_id) is None
            or event_id in event_ids
            or relationship.get("kind") != 3
            or relationship.get("content") != ""
            or relationship.get("verification")
            != {
                "event_id": "nip-01-recomputed",
                "signature": "bip-340-verified",
                "semantics": "nip-02-follow-list",
            }
            or relationship.get("event_url")
            != f"/network/events/{event_id}.json"
        ):
            raise ValueError("network follow-list event is invalid")
        relationship_sources.add(source_id)
        event_ids.add(event_id)
        event_records[event_id] = relationship
        follows += len(target_ids)
    if (
        summary.get("threads") != len(catalog["threads"])
        or summary.get("events") != len(event_ids)
        or summary.get("notes") != notes
        or summary.get("replies") != replies
        or summary.get("follow_list_events") != len(catalog["relationships"])
        or summary.get("follows") != follows
        or summary.get("verified_event_ids") != len(event_ids)
        or summary.get("verified_event_signatures") != len(event_ids)
    ):
        raise ValueError("network event summary is inconsistent")
    events_directory = directory / "events"
    if not events_directory.is_dir() or events_directory.is_symlink():
        raise ValueError("network export omits its event directory")
    expected_names = {f"{event_id}.json" for event_id in event_ids}
    actual_names = {path.name for path in events_directory.iterdir()}
    if actual_names != expected_names:
        raise ValueError("network event export differs from its catalog")
    content = {
        "network/index.html": page_path.read_bytes(),
        "network/index.json": index_path.read_bytes(),
    }
    for event_id in sorted(event_ids):
        path = events_directory / f"{event_id}.json"
        if (
            not path.is_file()
            or path.is_symlink()
            or path.stat().st_size > MAX_NETWORK_EVENT_BYTES
        ):
            raise ValueError(f"network event export is unsafe: {event_id}")
        try:
            raw = json.loads(path.read_text(encoding="utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise ValueError(f"network event JSON is invalid: {event_id}") from error
        reviewed = event_records[event_id]
        raw_created_at = raw.get("created_at")
        if isinstance(raw_created_at, bool) or not isinstance(raw_created_at, int):
            raise ValueError(f"network event timestamp is invalid: {event_id}")
        try:
            expected_time = dt.datetime.fromtimestamp(
                raw_created_at, tz=dt.timezone.utc
            ).strftime("%Y-%m-%dT%H:%M:%SZ")
        except (OverflowError, OSError, ValueError) as error:
            raise ValueError(
                f"network event timestamp is unsupported: {event_id}"
            ) from error
        if (
            raw.get("id") != event_id
            or raw.get("pubkey") != reviewed.get("pubkey")
            or raw.get("kind") != reviewed.get("kind")
            or raw.get("content") != reviewed.get("content")
            or (
                raw.get("kind") == 3
                and raw.get("tags") != reviewed.get("follow_tags")
            )
            or expected_time != reviewed.get("created_at")
        ):
            raise ValueError(f"network event differs from its catalog: {event_id}")
        content[f"network/events/{event_id}.json"] = path.read_bytes()
    return content, catalog


def write_release(
    staging: Path,
    snapshot: dict[str, Any],
    site_css: Path,
    agent_proof: dict[str, bytes],
    product_proofs: dict[str, bytes],
    registry_export: dict[str, bytes],
    network_export: dict[str, bytes],
) -> dict[str, str]:
    staging.chmod(0o755)
    product_catalog = product_catalog_from_snapshot(snapshot)
    text_files = {
        "index.html": render_dashboard(snapshot),
        "life.json": json.dumps(
            snapshot, ensure_ascii=False, indent=2, sort_keys=True
        )
        + "\n",
        "feed.xml": render_feed(snapshot),
        "products/index.html": render_product_hub(snapshot),
        "products/index.json": json.dumps(
            product_catalog, ensure_ascii=False, indent=2, sort_keys=True
        )
        + "\n",
        "robots.txt": "User-agent: *\nAllow: /\n",
        "assets/site.css": site_css.read_text(encoding="utf-8"),
    }
    nostr_discovery = render_nostr_discovery(snapshot)
    if nostr_discovery is not None:
        text_files[".well-known/nostr.json"] = nostr_discovery
    security_txt = render_security_txt(snapshot)
    if security_txt is not None:
        text_files[".well-known/security.txt"] = security_txt
    hashes: dict[str, str] = {}
    for relative, content in text_files.items():
        target = staging / relative
        target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        target.parent.chmod(0o755)
        target.write_text(content, encoding="utf-8")
        target.chmod(0o644)
        hashes[relative] = hashlib.sha256(content.encode()).hexdigest()
    for relative, content in {
        **agent_proof,
        **product_proofs,
        **registry_export,
        **network_export,
    }.items():
        target = staging / relative
        target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        target.parent.chmod(0o755)
        target.write_bytes(content)
        target.chmod(0o644)
        hashes[relative] = hashlib.sha256(content).hexdigest()
    return hashes


def validate_release(staging: Path, snapshot: dict[str, Any]) -> None:
    page = (staging / "index.html").read_text(encoding="utf-8")
    published = json.loads((staging / "life.json").read_text(encoding="utf-8"))
    product_page = (staging / "products" / "index.html").read_text(
        encoding="utf-8"
    )
    product_catalog = json.loads(
        (staging / "products" / "index.json").read_text(encoding="utf-8")
    )
    if published != snapshot:
        raise ValueError("published life snapshot differs from reviewed snapshot")
    if product_catalog != product_catalog_from_snapshot(snapshot):
        raise ValueError("published product catalog differs from reviewed snapshot")
    if "<script" in page.lower():
        raise ValueError("dashboard unexpectedly contains a script")
    if "<script" in product_page.lower() or "<style" in product_page.lower():
        raise ValueError("product hub unexpectedly contains executable or inline style")
    if product_catalog["summary"]["products"] != len(
        product_catalog["products"]
    ):
        raise ValueError("product catalog summary count is inconsistent")
    if product_catalog["ranking"]["status"] == "withheld" and product_catalog[
        "ranking"
    ]["rows"]:
        raise ValueError("withheld product ranking unexpectedly contains rows")
    if "network" in snapshot:
        network_page = (staging / "network" / "index.html").read_text(
            encoding="utf-8"
        )
        network_catalog = json.loads(
            (staging / "network" / "index.json").read_text(encoding="utf-8")
        )
        if "<script" in network_page.lower() or "<style" in network_page.lower():
            raise ValueError("network page unexpectedly contains executable or style")
        if network_catalog["summary"] != snapshot["network"]["summary"]:
            raise ValueError("published network summary differs from life snapshot")
    for value in snapshot["metrics"].values():
        if esc(value) not in page:
            raise ValueError(f"dashboard omits a headline metric: {value}")
    # The parser reads the feed rendered into this private staging directory
    # by this process; no network or caller-supplied XML reaches this boundary.
    ET.parse(staging / "feed.xml")  # nosec B314
    security_txt = render_security_txt(snapshot)
    if security_txt is not None:
        published_security = (
            staging / ".well-known" / "security.txt"
        ).read_text(encoding="utf-8")
        if published_security != security_txt:
            raise ValueError("published security.txt differs from reviewed state")
        if published_security.count("Expires: ") != 1:
            raise ValueError("published security.txt has an invalid expiry")
    if any(path.is_symlink() for path in staging.rglob("*")):
        raise ValueError("dashboard release unexpectedly contains a symlink")


def activate(site_root: Path, release_name: str) -> Path:
    current = site_root / "current"
    temporary = site_root / f".current-{os.getpid()}"
    if temporary.exists() or temporary.is_symlink():
        temporary.unlink()
    temporary.symlink_to(Path("releases") / release_name)
    os.replace(temporary, current)
    return current


def prune(releases: Path, current: Path, keep: int) -> list[str]:
    current_target = current.resolve(strict=True)
    candidates = sorted(
        path
        for path in releases.iterdir()
        if path.is_dir() and not path.is_symlink() and not path.name.startswith(".")
    )
    removed: list[str] = []
    for path in candidates[:-keep]:
        if path.resolve() == current_target:
            continue
        shutil.rmtree(path)
        removed.append(path.name)
    return removed


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Atomically publish a bounded WYWA public-life dashboard."
    )
    parser.add_argument("--site-root", type=Path, default=DEFAULT_SITE_ROOT)
    parser.add_argument("--runtime-root", type=Path, default=DEFAULT_RUNTIME_ROOT)
    parser.add_argument("--logs-root", type=Path, default=WORKSPACE / "logs")
    parser.add_argument("--workspace-root", type=Path, default=WORKSPACE)
    parser.add_argument("--public-state", type=Path, default=PUBLIC_STATE)
    parser.add_argument("--site-css", type=Path, default=SITE_CSS)
    parser.add_argument("--agent-proof-dir", type=Path)
    parser.add_argument(
        "--product-proof-dir",
        type=Path,
        help=(
            "optional signed product claims; requires --agent-proof-dir and "
            "one exact claim/signature pair per reviewed product"
        ),
    )
    parser.add_argument(
        "--economics-proof-dir",
        type=Path,
        help=(
            "optional signed provider-verification bundles selected by the "
            "reviewed product records"
        ),
    )
    parser.add_argument(
        "--economics-public-key",
        type=Path,
        help="comment-free Ed25519 public key for economics bundle verification",
    )
    parser.add_argument(
        "--registry-export-dir",
        type=Path,
        help=(
            "optional reviewed catalog export; defaults to none so portable "
            "profiles do not inherit Lumen's registry"
        ),
    )
    parser.add_argument(
        "--network-export-dir",
        type=Path,
        help=(
            "optional reviewed read-only Nostr event export; requires eligible "
            "agent links to exist in the supplied registry export"
        ),
    )
    parser.add_argument("--base-url")
    parser.add_argument("--as-of")
    parser.add_argument("--phase", choices=("active", "waiting", "degraded"))
    parser.add_argument("--keep", type=int, default=5)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if not args.site_root.is_absolute():
        raise SystemExit("publish-platform: site root must be absolute")
    if not args.public_state.is_absolute():
        raise SystemExit("publish-platform: public state path must be absolute")
    if not args.site_css.is_absolute():
        raise SystemExit("publish-platform: site CSS path must be absolute")
    if not args.site_css.is_file() or args.site_css.is_symlink():
        raise SystemExit("publish-platform: site CSS must be a regular file")
    if args.keep < 2:
        raise SystemExit("publish-platform: keep must be at least 2")
    as_of = (
        dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
        if args.as_of is None
        else parse_moment(args.as_of)
    )
    public = load_public_state(args.public_state)
    snapshot = build_snapshot(
        public,
        as_of,
        args.logs_root,
        args.runtime_root,
        detected_phase(args.phase),
        args.workspace_root,
        args.base_url,
    )
    agent_proof = read_agent_proof(args.agent_proof_dir, snapshot)
    product_proofs, product_claims = read_product_proofs(
        args.product_proof_dir,
        args.agent_proof_dir,
        public["products"],
        snapshot,
    )
    economics_proofs, economics_events, provider_verification = (
        read_economics_proofs(
            args.economics_proof_dir,
            args.economics_public_key,
            public["products"],
            snapshot,
        )
    )
    if set(product_proofs).intersection(economics_proofs):
        raise SystemExit("publish-platform: product proof paths collide")
    product_proofs.update(economics_proofs)
    apply_product_claims(
        snapshot,
        public,
        product_claims,
        economics_events,
        provider_verification,
    )
    if product_claims:
        snapshot["sources"].append(
            {
                "id": "signed-product-maker-claims",
                "label": "Short-lived maker signatures bound to agent proof",
                "path": "products/claims/*.json + detached signatures",
                "covers": ["product maker attribution", "release claim attribution"],
            }
        )
    if provider_verification is not None:
        snapshot["sources"].append(
            {
                "id": "signed-provider-economics",
                "label": "Fresh signed provider settlement verification",
                "path": "products/receipts/*.json + detached signatures",
                "covers": [
                    "settled revenue",
                    "settled refunds",
                    "direct payment-processing costs",
                ],
            }
        )
    registry_export, registry_catalog = read_registry_export(
        args.registry_export_dir
    )
    if registry_catalog is not None:
        snapshot["metrics"]["verified_agents"] = registry_catalog["summary"][
            "eligible"
        ]
        snapshot["registry"] = {
            "admission": registry_catalog["admission"],
            "summary": registry_catalog["summary"],
            "catalog": f"{snapshot['site']['base_url']}/agents/index.json",
            "audit": f"{snapshot['site']['base_url']}/agents/audit.json",
        }
        snapshot["sources"].append(
            {
                "id": "curated-agent-registry",
                "label": "Hash-chained manual registry review",
                "path": "platform/registry/index.json + audit.json",
                "covers": ["verified_agents", "registry"],
            }
        )
    network_export, network_catalog = read_network_export(
        args.network_export_dir,
        registry_catalog,
    )
    if network_catalog is not None:
        snapshot["network"] = {
            "admission": network_catalog["admission"],
            "protocol": network_catalog["protocol"],
            "catalog": f"{snapshot['site']['base_url']}/network/index.json",
            "page": f"{snapshot['site']['base_url']}/network/",
            "summary": network_catalog["summary"],
            "boundary": (
                "Selected NIP-01 ids and BIP-340 signatures are verified; "
                "one NIP-02 follow list records Lumen's explicit attention. "
                "Only one participant links to the eligible closed-registry "
                "record; the peer remains an external signed key. A follow is "
                "not reciprocity or endorsement. Public input and automatic "
                "relay ingestion remain closed."
            ),
        }
        snapshot["sources"].append(
            {
                "id": "signed-read-only-network",
                "label": "Reviewed NIP-01/02 events with offline signature checks",
                "path": "network/index.json + exact event JSON",
                "covers": [
                    "selected public conversation",
                    "explicit signed follow choice",
                    "event authorship by public key",
                    "wire thread markers",
                ],
            }
        )
    args.site_root.mkdir(mode=0o755, parents=True, exist_ok=True)
    args.site_root.chmod(0o755)
    releases = args.site_root / "releases"
    releases.mkdir(mode=0o755, exist_ok=True)
    releases.chmod(0o755)
    staging = Path(tempfile.mkdtemp(prefix=".staging-", dir=releases))
    activated = False
    try:
        hashes = write_release(
            staging,
            snapshot,
            args.site_css,
            agent_proof,
            product_proofs,
            registry_export,
            network_export,
        )
        validate_release(staging, snapshot)
        digest = hashlib.sha256(
            json.dumps(hashes, sort_keys=True).encode()
        ).hexdigest()[:12]
        release_name = f"{as_of.strftime('%Y%m%dT%H%M%SZ')}-{digest}"
        release = releases / release_name
        if release.exists():
            shutil.rmtree(staging)
        else:
            staging.rename(release)
        current = activate(args.site_root, release_name)
        activated = True
        removed = prune(releases, current, args.keep)
    finally:
        if not activated and staging.exists():
            shutil.rmtree(staging)
    print(
        json.dumps(
            {
                "current": str(current),
                "generated_at": snapshot["generated_at"],
                "release": release_name,
                "removed": removed,
            },
            sort_keys=True,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
