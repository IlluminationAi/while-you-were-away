#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
project_dir=$(cd -- "$script_dir/.." && pwd -P)

if [[ $# -ne 1 ]]; then
  printf 'Usage: %s OUTPUT_DIRECTORY\n' "$program" >&2
  exit 2
fi

output_dir=$(realpath -m -- "$1")
[[ "$output_dir" != / ]] || {
  printf '%s: refusing to use the filesystem root as output\n' "$program" >&2
  exit 2
}
[[ ! -L "$1" ]] || {
  printf '%s: output directory must not be a symbolic link\n' "$program" >&2
  exit 2
}

destination=$output_dir/while-you-were-away
[[ ! -e "$destination" ]] || {
  printf '%s: destination already exists: %s\n' "$program" "$destination" >&2
  exit 2
}

staging=$(mktemp -d)
cleanup() {
  chmod -R u+rwX -- "$staging" 2>/dev/null || true
  rm -rf -- "$staging"
}
trap cleanup EXIT

source_root=$staging/while-you-were-away
mkdir -p -- \
  "$source_root/.github/ISSUE_TEMPLATE" \
  "$source_root/.github/workflows" \
  "$source_root/bin" \
  "$source_root/launch-assets" \
  "$source_root/platform" \
  "$source_root/platform/economics-proofs" \
  "$source_root/platform/network" \
  "$source_root/platform/network/events" \
  "$source_root/platform/network-events" \
  "$source_root/platform/outside-run" \
  "$source_root/platform/product-proofs" \
  "$source_root/platform/release-proofs" \
  "$source_root/platform/registry" \
  "$source_root/templates" \
  "$source_root/tests"

install -m 0644 -- \
  "$project_dir/.github/workflows/verify.yml" \
  "$source_root/.github/workflows/verify.yml"
install -m 0644 -- \
  "$project_dir/.github/ISSUE_TEMPLATE/outside-run.yml" \
  "$source_root/.github/ISSUE_TEMPLATE/outside-run.yml"

for filename in \
  .gitignore \
  CHANGELOG.md \
  GETTING_STARTED.md \
  INTAKE_GATEWAY.md \
  LICENSE \
  outreach-2026-07-24.md \
  permission-boundary-2026-07-25.md \
  PRODUCT_HUNT.md \
  PLATFORM.md \
  REGISTRY.md \
  README.md \
  SECURITY.md \
  VERSION
do
  install -m 0644 -- "$project_dir/$filename" "$source_root/$filename"
done

for filename in \
  build-launch-assets \
  outside-run-verify \
  publish-platform \
  build-release \
  build-source-tree \
  wywa \
  wywa-life \
  wywa-life-drill \
  wywa-network \
  wywa-product \
  wywa-release-proof \
  wywa-receipt \
  wywa-public \
  wywa-volume \
  wywa-curator \
  wywa-edge-probe \
  wywa-intake \
  wywa-intake-gateway \
  wywa-intake-queue \
  wywa-retained-proof \
  wywa-registry
do
  install -m 0755 -- "$project_dir/bin/$filename" "$source_root/bin/$filename"
done

for filename in \
  allowed_signers \
  index.html \
  riskkernel-v0.9.0.html \
  riskkernel-v0.9.0.json \
  riskkernel-v0.9.0.json.sig
do
  install -m 0644 -- \
    "$project_dir/platform/outside-run/$filename" \
    "$source_root/platform/outside-run/$filename"
done

install -m 0644 -- \
  "$project_dir/platform/network-review.json" \
  "$source_root/platform/network-review.json"
for event_file in "$project_dir"/platform/network-events/*.json
do
  install -m 0644 -- \
    "$event_file" \
    "$source_root/platform/network-events/${event_file##*/}"
done
install -m 0644 -- \
  "$project_dir/platform/network/index.html" \
  "$source_root/platform/network/index.html"
install -m 0644 -- \
  "$project_dir/platform/network/index.json" \
  "$source_root/platform/network/index.json"
for event_file in "$project_dir"/platform/network/events/*.json
do
  install -m 0644 -- \
    "$event_file" \
    "$source_root/platform/network/events/${event_file##*/}"
done

for filename in \
  README.md \
  wywa-alpha6-github-tag-20260725.json \
  wywa-alpha6-github-tag-20260725.sig
do
  install -m 0644 -- \
    "$project_dir/platform/release-proofs/$filename" \
    "$source_root/platform/release-proofs/$filename"
done

for filename in \
  revision-radar.json \
  revision-radar.sig \
  wywa.json \
  wywa.sig
do
  install -m 0644 -- \
    "$project_dir/platform/product-proofs/$filename" \
    "$source_root/platform/product-proofs/$filename"
done

for filename in \
  audit.json \
  index.html \
  index.json
do
  install -m 0644 -- \
    "$project_dir/platform/registry/$filename" \
    "$source_root/platform/registry/$filename"
done

for filename in \
  intake-edge-harness.nginx.conf.in \
  intake-public-window.nginx.conf.in \
  intake-public-window-zones.conf \
  nginx-bootstrap.conf \
  nginx.conf \
  economics-public-key.pub \
  release-public-key.pub \
  public-nginx-bootstrap.conf.in \
  public-nginx.conf.in \
  public-nginx-zones.conf \
  public-state.json \
  site.css \
  wywa-retained-proof.service \
  wywa-retained-proof.timer
do
  install -m 0644 -- \
    "$project_dir/platform/$filename" \
    "$source_root/platform/$filename"
done

install -m 0644 -- \
  "$project_dir/platform/economics-proofs/README.md" \
  "$source_root/platform/economics-proofs/README.md"

for filename in \
  README.md \
  01-leave-the-tab.png \
  02-honest-continuity.png \
  03-visible-boundaries.png \
  04-checkpoint-evidence.png \
  05-honest-failures.png \
  thumbnail-240.png
do
  install -m 0644 -- \
    "$project_dir/launch-assets/$filename" \
    "$source_root/launch-assets/$filename"
done

template_name=
for template_name in \
  MANDATE.md \
  CONSTITUTION.md \
  AGENTS.md \
  WAKE.md \
  state-CURRENT.md \
  memory-INDEX.md \
  projects-README.md \
  workspace-README.md \
  gitignore \
  inbox-gitkeep \
  public-state.json
do
  install -m 0644 -- \
    "$project_dir/templates/$template_name" \
    "$source_root/templates/$template_name"
done

install -m 0755 -- \
  "$project_dir/tests/test-ci" \
  "$source_root/tests/test-ci"
install -m 0755 -- \
  "$project_dir/tests/test-python-static" \
  "$source_root/tests/test-python-static"
install -m 0755 -- \
  "$project_dir/tests/test-wywa" \
  "$source_root/tests/test-wywa"
install -m 0755 -- \
  "$project_dir/tests/test-release" \
  "$source_root/tests/test-release"
install -m 0755 -- \
  "$project_dir/tests/test-source-tree" \
  "$source_root/tests/test-source-tree"
install -m 0755 -- \
  "$project_dir/tests/test-platform" \
  "$source_root/tests/test-platform"
install -m 0755 -- \
  "$project_dir/tests/test-network" \
  "$source_root/tests/test-network"
install -m 0755 -- \
  "$project_dir/tests/test-life" \
  "$source_root/tests/test-life"
install -m 0755 -- \
  "$project_dir/tests/test-life-drill" \
  "$source_root/tests/test-life-drill"
install -m 0755 -- \
  "$project_dir/tests/test-public" \
  "$source_root/tests/test-public"
install -m 0755 -- \
  "$project_dir/tests/test-registry" \
  "$source_root/tests/test-registry"
install -m 0755 -- \
  "$project_dir/tests/test-product" \
  "$source_root/tests/test-product"
install -m 0755 -- \
  "$project_dir/tests/test-receipt" \
  "$source_root/tests/test-receipt"
install -m 0755 -- \
  "$project_dir/tests/test-release-proof" \
  "$source_root/tests/test-release-proof"
install -m 0755 -- \
  "$project_dir/tests/test-curator" \
  "$source_root/tests/test-curator"
install -m 0755 -- \
  "$project_dir/tests/test-intake" \
  "$source_root/tests/test-intake"
install -m 0755 -- \
  "$project_dir/tests/test-intake-edge" \
  "$source_root/tests/test-intake-edge"
install -m 0755 -- \
  "$project_dir/tests/test-intake-queue" \
  "$source_root/tests/test-intake-queue"
install -m 0755 -- \
  "$project_dir/tests/test-intake-gateway" \
  "$source_root/tests/test-intake-gateway"
install -m 0755 -- \
  "$project_dir/tests/test-retained-proof" \
  "$source_root/tests/test-retained-proof"
install -m 0755 -- \
  "$project_dir/tests/test-edge-probe" \
  "$source_root/tests/test-edge-probe"
install -m 0755 -- \
  "$project_dir/tests/test-volume" \
  "$source_root/tests/test-volume"

mkdir -p -- "$output_dir"
mv -- "$source_root" "$destination"
printf 'source tree: %s\n' "$destination"
