#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
project_dir=$(cd -- "$script_dir/.." && pwd -P)
templates_dir=$project_dir/templates
permission_profile=wywa-workspace-only
permission_filesystem='permissions.wywa-workspace-only.filesystem={":root"="deny",":minimal"="read",":tmpdir"="deny",":slash_tmp"="deny"}'
permission_network='permissions.wywa-workspace-only.network.enabled=false'
reviewed_codex_version=0.145.0

usage() {
  cat <<EOF
Usage:
  $program init WORKSPACE
  $program doctor WORKSPACE
  $program run WORKSPACE [--max-runtime DURATION] [--dry-run]
  $program status WORKSPACE
  $program verify-receipt WORKSPACE
  $program install-user WORKSPACE [--dry-run] [--session-only]
  $program uninstall-user WORKSPACE

Commands:
  init     Create a private, Git-backed persistent-worker workspace.
  doctor   Verify the workspace, non-root boundary, Codex, and login.
  run      Run one bounded cycle with workspace-only filesystem access.
  status   Show the last cycle receipt and final message, when available.
  verify-receipt
           Verify the last successful host checkpoint and private evidence.
  install-user
           Install and start a completion-relative systemd user timer.
  uninstall-user
           Stop and remove this workspace's timer without deleting its data.

Environment:
  WYWA_CODEX_BIN     Absolute Codex CLI path; defaults to the command on PATH.
  WYWA_STATE_ROOT    Private runtime root; defaults to
                     \$HOME/.local/state/wywa.
  WYWA_ALLOW_ROOT    Set to 1 only for an externally isolated, dedicated host.
  WYWA_SYSTEMCTL_BIN Absolute systemctl path, for isolated installer tests.
  WYWA_LOGINCTL_BIN  Absolute loginctl path, for isolated installer tests.
EOF
}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

require_single_workspace_arg() {
  [[ $# -eq 1 ]] || die "this command requires exactly one WORKSPACE"
}

absolute_path() {
  realpath -m -- "$1"
}

canonical_workspace_path() {
  [[ ! -L "$1" ]] ||
    die "workspace must not be a symbolic link: $1"
  absolute_path "$1"
}

validate_workspace_path() {
  local candidate=$1
  [[ "$candidate" == /* ]] || die "workspace path must resolve to an absolute path"
  [[ "$candidate" != / ]] || die "refusing to use the filesystem root as a workspace"
  [[ -d "$candidate" ]] || die "workspace does not exist: $candidate"
  [[ ! -L "$candidate" ]] || die "workspace must not be a symbolic link: $candidate"
}

state_root() {
  local raw_root root
  if [[ -n "${WYWA_STATE_ROOT:-}" ]]; then
    raw_root=$WYWA_STATE_ROOT
  else
    [[ -n "${HOME:-}" ]] || die "HOME is required when WYWA_STATE_ROOT is unset"
    raw_root=$HOME/.local/state/wywa
  fi
  [[ ! -L "$raw_root" ]] ||
    die "runtime root must not be a symbolic link: $raw_root"
  root=$(absolute_path "$raw_root")
  [[ "$root" != / ]] || die "refusing to use the filesystem root for runtime state"
  printf '%s\n' "$root"
}

workspace_id() {
  printf '%s' "$1" | sha256sum | cut -c1-16
}

runtime_dir_for() {
  local workspace=$1
  printf '%s/%s\n' "$(state_root)" "$(workspace_id "$workspace")"
}

resolve_codex_bin() {
  local candidate
  if [[ -n "${WYWA_CODEX_BIN:-}" ]]; then
    candidate=$WYWA_CODEX_BIN
    [[ "$candidate" == /* ]] || die "WYWA_CODEX_BIN must be an absolute path"
  else
    candidate=$(command -v codex || true)
    [[ -n "$candidate" ]] || die "Codex CLI was not found on PATH"
    candidate=$(absolute_path "$candidate")
  fi
  [[ -f "$candidate" && -x "$candidate" ]] ||
    die "Codex CLI is not an executable regular file: $candidate"
  printf '%s\n' "$candidate"
}

check_codex_permissions_support() {
  local codex_bin=$1
  local version_output major minor patch
  local -a clean_env
  safe_environment clean_env
  version_output=$("${clean_env[@]}" "$codex_bin" --version 2>/dev/null) ||
    die "unable to determine the Codex CLI version"
  if [[ "$version_output" =~ codex-cli[[:space:]]+([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
    major=${BASH_REMATCH[1]}
    minor=${BASH_REMATCH[2]}
    patch=${BASH_REMATCH[3]}
  else
    die "Codex CLI returned an unrecognized version: $version_output"
  fi
  [[ "$major.$minor.$patch" == "$reviewed_codex_version" ]] ||
    die "Codex CLI $reviewed_codex_version is the reviewed unattended capability boundary (found $major.$minor.$patch)"
}

safe_environment() {
  local -n destination=$1
  [[ -n "${HOME:-}" ]] || die "HOME is required"
  destination=(
    /usr/bin/env
    -i
    "HOME=$HOME"
    "PATH=/usr/local/bin:/usr/bin:/bin"
    "LANG=${LANG:-C.UTF-8}"
    "LC_ALL=${LC_ALL:-}"
    "USER=${USER:-}"
    "LOGNAME=${LOGNAME:-}"
    "NO_COLOR=1"
  )
  if [[ -n "${CODEX_HOME:-}" ]]; then
    destination+=("CODEX_HOME=$CODEX_HOME")
  fi
}

check_root_boundary() {
  if (( EUID == 0 )) && [[ "${WYWA_ALLOW_ROOT:-0}" != 1 ]]; then
    die "refusing to run as root; use a non-root account"
  fi
  if (( EUID == 0 )); then
    printf '%s\n' "doctor: warning: explicit root override is active" >&2
  fi
}

check_required_workspace_files() {
  local workspace=$1
  local relative
  for relative in \
    MANDATE.md \
    CONSTITUTION.md \
    AGENTS.md \
    WAKE.md \
    state/CURRENT.md \
    memory/INDEX.md \
    projects/README.md
  do
    [[ -f "$workspace/$relative" && ! -L "$workspace/$relative" ]] ||
      die "required workspace file is missing or unsafe: $relative"
  done
  [[ ! -e "$workspace/.codex" && ! -L "$workspace/.codex" ]] ||
    die "workspace-local Codex configuration is forbidden: .codex"
  [[ -d "$workspace/.git" ]] || die "workspace is not a Git repository"
}

checkpoint_git() {
  local workspace=$1
  shift
  env \
    GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_NOSYSTEM=1 \
    GIT_TERMINAL_PROMPT=0 \
    LC_ALL=C \
    git \
      -C "$workspace" \
      -c core.fsmonitor=false \
      -c core.hooksPath=/dev/null \
      -c commit.gpgSign=false \
      "$@"
}

unstage_checkpoint() {
  local workspace=$1
  checkpoint_git "$workspace" \
    restore --staged --source=HEAD -- . >/dev/null 2>&1 || true
}

checkpoint_workspace() {
  local workspace=$1
  local run_stamp=$2
  local finding scan_status diff_status
  local secret_pattern
  secret_pattern='(sk-[A-Za-z0-9_-]{20,}|github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|-----BEGIN ([A-Z0-9]+ )?PRIVATE KEY-----|"(access_token|refresh_token|id_token|client_secret)"[[:space:]]*:[[:space:]]*"[^"]{20,}")'

  checkpoint_result=refused

  if [[ -e "$workspace/.codex" || -L "$workspace/.codex" ]]; then
    printf '%s\n' "checkpoint: refused because workspace-local Codex configuration is present"
    return 73
  fi

  if ! finding=$(
    cd /
    find -- "$workspace" -mindepth 2 -name .git -print -quit
  ); then
    printf '%s\n' "checkpoint: unable to inspect the workspace for nested Git metadata"
    return 73
  fi
  if [[ -n "$finding" ]]; then
    printf '%s\n' "checkpoint: refused because nested Git metadata is present"
    return 73
  fi

  if ! finding=$(
    cd /
    find -- "$workspace" \
      -path "$workspace/.git" -prune -o \
      \( ! -type d ! -type f ! -type l \) -print -quit
  ); then
    printf '%s\n' "checkpoint: unable to inspect workspace file types"
    return 73
  fi
  if [[ -n "$finding" ]]; then
    printf '%s\n' "checkpoint: refused because a special file is present"
    return 73
  fi

  if ! finding=$(
    cd /
    find -- "$workspace" \
      -path "$workspace/.git" -prune -o \
      -type f -size +10485760c -print -quit
  ); then
    printf '%s\n' "checkpoint: unable to inspect workspace file sizes"
    return 73
  fi
  if [[ -n "$finding" ]]; then
    printf '%s\n' "checkpoint: refused because a file exceeds 10 MiB"
    return 73
  fi

  if ! checkpoint_git "$workspace" add -A -- .; then
    printf '%s\n' "checkpoint: git add failed"
    unstage_checkpoint "$workspace"
    return 73
  fi

  checkpoint_git "$workspace" diff --cached --quiet --exit-code
  diff_status=$?
  if [[ "$diff_status" -eq 0 ]]; then
    checkpoint_result=none
    printf '%s\n' "checkpoint: no workspace changes; durable progress is required"
    return 72
  fi
  if [[ "$diff_status" -ne 1 ]]; then
    printf '%s\n' "checkpoint: unable to inspect the staged change"
    unstage_checkpoint "$workspace"
    return 73
  fi

  if ! checkpoint_git "$workspace" diff --cached --check; then
    printf '%s\n' "checkpoint: refused because git diff --check failed"
    unstage_checkpoint "$workspace"
    return 73
  fi

  checkpoint_git "$workspace" grep \
    --cached \
    -I \
    -q \
    -E \
    -e "$secret_pattern" --
  scan_status=$?
  if [[ "$scan_status" -eq 0 ]]; then
    printf '%s\n' "checkpoint: refused because staged content resembles a credential"
    unstage_checkpoint "$workspace"
    return 73
  fi
  if [[ "$scan_status" -ne 1 ]]; then
    printf '%s\n' "checkpoint: credential scan could not complete"
    unstage_checkpoint "$workspace"
    return 73
  fi

  if ! checkpoint_git "$workspace" \
    -c user.name="WYWA Worker" \
    -c user.email="wywa@localhost" \
    commit -q -m "Checkpoint WYWA cycle $run_stamp"; then
    printf '%s\n' "checkpoint: git commit failed"
    unstage_checkpoint "$workspace"
    return 73
  fi

  checkpoint_commit=$(checkpoint_git "$workspace" rev-parse HEAD)
  checkpoint_tree=$(checkpoint_git "$workspace" rev-parse 'HEAD^{tree}')
  checkpoint_result=${checkpoint_commit:0:12}
  if [[ -n "$(checkpoint_git "$workspace" status --porcelain)" ]]; then
    printf '%s\n' "checkpoint: working tree changed during checkpoint creation"
    return 73
  fi
  printf 'checkpoint: committed %s\n' "$checkpoint_result"
}

prepare_runtime_dir() {
  local workspace=$1
  local root runtime_dir
  root=$(state_root)
  if [[ -e "$root" && ( ! -d "$root" || -L "$root" ) ]]; then
    die "runtime root exists but is not a safe directory: $root"
  fi
  mkdir -p -- "$root"
  runtime_dir=$(runtime_dir_for "$workspace")
  if [[ -e "$runtime_dir" &&
        ( ! -d "$runtime_dir" || -L "$runtime_dir" ) ]]; then
    die "workspace runtime exists but is not a safe directory: $runtime_dir"
  fi
  mkdir -p -- "$runtime_dir"
  if [[ -e "$runtime_dir/logs" &&
        ( ! -d "$runtime_dir/logs" || -L "$runtime_dir/logs" ) ]]; then
    die "log path exists but is not a safe directory: $runtime_dir/logs"
  fi
  mkdir -p -- "$runtime_dir/logs"
  chmod 0700 -- "$root" "$runtime_dir" "$runtime_dir/logs"
  printf '%s\n' "$workspace" >"$runtime_dir/workspace.path"
  chmod 0600 -- "$runtime_dir/workspace.path"
  printf '%s\n' "$runtime_dir"
}

cmd_init() {
  require_single_workspace_arg "$@"
  local requested=$1
  local workspace
  workspace=$(absolute_path "$requested")

  [[ "$workspace" != / ]] || die "refusing to initialize the filesystem root"
  [[ ! -L "$requested" ]] || die "refusing to initialize a symbolic-link target"
  if [[ -e "$workspace" ]]; then
    local first_entry
    [[ -d "$workspace" ]] || die "target exists and is not a directory"
    if ! first_entry=$(
      cd /
      find -- "$workspace" -mindepth 1 -maxdepth 1 -print -quit
    ); then
      die "unable to inspect target directory safely: $workspace"
    fi
    if [[ -n "$first_entry" ]]; then
      die "target directory is not empty: $workspace"
    fi
  fi

  command -v git >/dev/null 2>&1 || die "git is required"
  [[ -d "$templates_dir" ]] || die "templates directory is unavailable"

  umask 077
  mkdir -p -- \
    "$workspace/state" \
    "$workspace/memory/daily" \
    "$workspace/projects" \
    "$workspace/inbox"

  cp -- "$templates_dir/MANDATE.md" "$workspace/MANDATE.md"
  cp -- "$templates_dir/CONSTITUTION.md" "$workspace/CONSTITUTION.md"
  cp -- "$templates_dir/AGENTS.md" "$workspace/AGENTS.md"
  cp -- "$templates_dir/WAKE.md" "$workspace/WAKE.md"
  cp -- "$templates_dir/state-CURRENT.md" "$workspace/state/CURRENT.md"
  cp -- "$templates_dir/memory-INDEX.md" "$workspace/memory/INDEX.md"
  cp -- "$templates_dir/projects-README.md" "$workspace/projects/README.md"
  cp -- "$templates_dir/workspace-README.md" "$workspace/README.md"
  cp -- "$templates_dir/gitignore" "$workspace/.gitignore"
  cp -- "$templates_dir/inbox-gitkeep" "$workspace/inbox/.gitkeep"

  git -C "$workspace" init -q -b main
  git -C "$workspace" config user.name "WYWA Worker"
  git -C "$workspace" config user.email "wywa@localhost"
  git -C "$workspace" add -- .
  git -C "$workspace" commit -q -m "Initialize persistent worker workspace"

  prepare_runtime_dir "$workspace" >/dev/null
  printf 'initialized: %s\n' "$workspace"
  printf '%s\n' "next: authenticate Codex, then run '$program doctor $workspace'"
}

doctor_workspace() {
  local workspace=$1
  local codex_bin
  local -a clean_env

  validate_workspace_path "$workspace"
  check_root_boundary
  check_required_workspace_files "$workspace"
  command -v python3 >/dev/null 2>&1 ||
    die "python3 is required for the Codex JSON event audit"
  codex_bin=$(resolve_codex_bin)
  safe_environment clean_env
  check_codex_permissions_support "$codex_bin"

  git -C "$workspace" rev-parse --verify HEAD >/dev/null 2>&1 ||
    die "workspace has no initial Git commit"
  git -C "$workspace" fsck --no-dangling >/dev/null 2>&1 ||
    die "workspace Git repository failed integrity checks"
  "${clean_env[@]}" "$codex_bin" login status >/dev/null 2>&1 ||
    die "Codex CLI is not authenticated"

  prepare_runtime_dir "$workspace" >/dev/null
  if [[ -n "$(git -C "$workspace" status --porcelain)" ]]; then
    printf '%s\n' "doctor: note: workspace has uncommitted changes" >&2
  fi
  printf 'doctor: ok (%s)\n' "$workspace"
}

cmd_doctor() {
  require_single_workspace_arg "$@"
  local workspace
  workspace=$(canonical_workspace_path "$1")
  doctor_workspace "$workspace"
}

valid_duration() {
  [[ "$1" =~ ^[1-9][0-9]*[smhd]$ ]]
}

audit_event_log() {
  local event_log=$1
  python3 - "$event_log" <<'PY'
import json
import sys
from collections import Counter
from pathlib import Path

path = Path(sys.argv[1])
allowed_events = {
    "thread.started",
    "turn.started",
    "item.started",
    "item.updated",
    "item.completed",
    "turn.completed",
}
allowed_items = (
    "agent_message",
    "reasoning",
    "command_execution",
    "file_change",
    "web_search",
    "todo_list",
    "plan",
    "image_view",
    "context_compaction",
)
events = []
item_counts = Counter()
started_items = {}
completed_items = set()

try:
    lines = path.read_text(encoding="utf-8").splitlines()
except (OSError, UnicodeError) as exc:
    raise SystemExit(f"event audit: unreadable UTF-8 JSONL: {exc}")

if not lines:
    raise SystemExit("event audit: empty JSONL stream")

for number, line in enumerate(lines, 1):
    try:
        event = json.loads(line)
    except json.JSONDecodeError as exc:
        raise SystemExit(
            f"event audit: invalid JSON on line {number}: {exc.msg}"
        )
    if not isinstance(event, dict):
        raise SystemExit(f"event audit: line {number} is not a JSON object")
    event_type = event.get("type")
    if event_type not in allowed_events:
        raise SystemExit(
            f"event audit: unexpected top-level event on line {number}: "
            f"{event_type!r}"
        )
    events.append(event_type)
    if not event_type.startswith("item."):
        continue
    item = event.get("item")
    if not isinstance(item, dict):
        raise SystemExit(f"event audit: line {number} has no item object")
    item_type = item.get("type")
    if item_type not in allowed_items:
        raise SystemExit(
            f"event audit: unexpected item type on line {number}: "
            f"{item_type!r}"
        )
    item_id = item.get("id")
    if not isinstance(item_id, str) or not item_id:
        raise SystemExit(f"event audit: line {number} has no item id")
    if event_type == "item.started":
        if item_id in started_items:
            raise SystemExit(
                f"event audit: duplicate item.started for {item_id}"
            )
        started_items[item_id] = item_type
    elif event_type == "item.completed":
        if item_id in completed_items:
            raise SystemExit(
                f"event audit: duplicate item.completed for {item_id}"
            )
        if item_id in started_items and started_items[item_id] != item_type:
            raise SystemExit(f"event audit: item type changed for {item_id}")
        completed_items.add(item_id)
        item_counts[item_type] += 1

if events[:2] != ["thread.started", "turn.started"]:
    raise SystemExit("event audit: stream did not start with thread and turn")
if events[-1] != "turn.completed":
    raise SystemExit("event audit: successful stream did not complete its turn")
if events.count("thread.started") != 1:
    raise SystemExit("event audit: stream has an unexpected thread count")
if events.count("turn.started") != 1 or events.count("turn.completed") != 1:
    raise SystemExit("event audit: stream has an unexpected turn count")
unfinished = sorted(set(started_items) - completed_items)
if unfinished:
    raise SystemExit(
        "event audit: unfinished item(s): " + ",".join(unfinished)
    )
if item_counts["agent_message"] < 1:
    raise SystemExit("event audit: stream has no completed agent message")

summary = ",".join(f"{name}:{item_counts[name]}" for name in allowed_items)
print(f"policy=wywa-v1 item_counts={summary}")
PY
}

cmd_run() {
  [[ $# -ge 1 ]] || die "run requires WORKSPACE"
  local workspace_arg=$1
  shift
  local max_runtime=55m
  local dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-runtime)
        [[ $# -ge 2 ]] || die "--max-runtime requires a duration"
        max_runtime=$2
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown run option: $1"
        ;;
    esac
  done
  valid_duration "$max_runtime" ||
    die "duration must be a positive integer followed by s, m, h, or d"

  local workspace
  workspace=$(canonical_workspace_path "$workspace_arg")
  doctor_workspace "$workspace"

  local codex_bin runtime_dir logs_dir lock_file last_message
  local last_run prompt run_stamp run_log diagnostics_log message_tmp receipt_tmp
  local codex_pid='' termination_status='' run_status=0 checkpoint_status=0
  local checkpoint_result=skipped checkpoint_commit=none checkpoint_tree=none
  local event_audit='' event_counts=unverified audit_status=0
  local -a clean_env permission_args capability_args command_line
  codex_bin=$(resolve_codex_bin)
  runtime_dir=$(prepare_runtime_dir "$workspace")
  logs_dir=$runtime_dir/logs
  lock_file=$runtime_dir/cycle.lock
  last_message=$runtime_dir/last-message.txt
  last_run=$runtime_dir/last-run
  prompt=$(<"$workspace/WAKE.md")

  safe_environment clean_env
  permission_args=(
    -c "default_permissions=\"$permission_profile\""
    -c "permissions.$permission_profile.extends=\":workspace\""
    -c "$permission_filesystem"
    -c "$permission_network"
  )
  capability_args=(
    -c 'approval_policy="never"'
    -c 'features.apps=false'
    -c 'features.plugins=false'
    -c 'features.remote_plugin=false'
    -c 'features.plugin_sharing=false'
    -c 'features.hooks=false'
    -c 'features.auth_elicitation=false'
    -c 'features.tool_call_mcp_elicitation=false'
    -c 'features.browser_use=false'
    -c 'features.browser_use_external=false'
    -c 'features.browser_use_full_cdp_access=false'
    -c 'features.computer_use=false'
    -c 'features.image_generation=false'
    -c 'features.in_app_browser=false'
    -c 'features.multi_agent=false'
    -c 'agents.enabled=false'
    -c 'features.goals=false'
    -c 'features.guardian_approval=false'
    -c 'features.skill_mcp_dependency_install=false'
    -c 'features.skill_search=false'
    -c 'features.tool_suggest=false'
    -c 'features.workspace_dependencies=false'
  )
  command_line=(
    "${clean_env[@]}"
    "$codex_bin"
    --search
    exec
    --ephemeral
    --ignore-user-config
    --ignore-rules
    --strict-config
    "${permission_args[@]}"
    "${capability_args[@]}"
    --cd "$workspace"
    --color never
    --json
  )

  if (( dry_run == 1 )); then
    printf '%s\n' "run: ready"
    printf 'workspace: %s\n' "$workspace"
    printf 'runtime: %s\n' "$runtime_dir"
    printf 'permissions: %s\n' "$permission_profile"
    printf '%s\n' "filesystem: workspace writable; other paths unreadable except minimal tool runtime"
    printf '%s\n' "local command network: disabled"
    printf '%s\n' "hosted web search: live; only non-shell external tool"
    printf '%s\n' "extensions: apps, plugins, hooks, browsers, and subagents disabled"
    printf '%s\n' "configuration: user config and project rules ignored; workspace-local .codex forbidden"
    printf '%s\n' "approvals: never; session persistence: ephemeral"
    printf '%s\n' "event stream: JSONL; reviewed item types required before checkpoint"
    printf 'maximum runtime: %s\n' "$max_runtime"
    printf '%s\n' "environment: minimal allowlist; unrelated secrets excluded"
    return 0
  fi

  if [[ -n "$(checkpoint_git "$workspace" status --porcelain)" ]]; then
    die "workspace has uncommitted changes; inspect and resolve them before a real run"
  fi

  umask 077
  exec 9>"$lock_file"
  if ! flock -n 9; then
    printf '%s\n' "run: another cycle already holds the workspace lock" >&2
    return 75
  fi

  run_stamp=$(date -u +%Y%m%dT%H%M%SZ)
  run_log=$logs_dir/cycle-$run_stamp-$$.log
  diagnostics_log=$logs_dir/diagnostics-$run_stamp-$$.log
  message_tmp=$(mktemp "$runtime_dir/.last-message.XXXXXX")
  receipt_tmp=$(mktemp "$runtime_dir/.last-run.XXXXXX")
  : >"$run_log"
  : >"$diagnostics_log"

  # Invoked indirectly by the EXIT trap.
  # shellcheck disable=SC2329
  finalize_run() {
    local final_status=$?
    local log_sha256 diagnostics_sha256 message_sha256=none
    set +e
    if [[ "$final_status" -eq 0 && -s "$message_tmp" ]]; then
      mv -f -- "$message_tmp" "$last_message"
      message_sha256=$(sha256sum -- "$last_message" | cut -d ' ' -f 1)
    else
      rm -f -- "$message_tmp"
    fi
    log_sha256=$(sha256sum -- "$run_log" | cut -d ' ' -f 1)
    diagnostics_sha256=$(
      sha256sum -- "$diagnostics_log" | cut -d ' ' -f 1
    )
    printf '%s receipt=6 status=%s permissions=%s local_network=disabled web_search=live apps=disabled plugins=disabled hooks=disabled subagents=disabled project_config=absent approval=never persistence=ephemeral events=wywa-v1 event_counts=%s checkpoint=%s commit=%s tree=%s log_sha256=%s diagnostics_sha256=%s message_sha256=%s diagnostics=%s log=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "$final_status" \
      "$permission_profile" \
      "$event_counts" \
      "$checkpoint_result" \
      "$checkpoint_commit" \
      "$checkpoint_tree" \
      "$log_sha256" \
      "$diagnostics_sha256" \
      "$message_sha256" \
      "$diagnostics_log" \
      "$run_log" >"$receipt_tmp"
    mv -f -- "$receipt_tmp" "$last_run"
    (
      cd /
      find "$logs_dir" -type f -name 'cycle-*.log' -mtime +30 -delete
      find "$logs_dir" -type f -name 'diagnostics-*.log' -mtime +30 -delete
    )
  }
  trap finalize_run EXIT

  # Invoked indirectly by the signal traps.
  # shellcheck disable=SC2329
  terminate_run() {
    local signal_name=$1
    local signal_status=$2
    if [[ -z "$termination_status" ]]; then
      termination_status=$signal_status
    fi
    if [[ -n "$codex_pid" ]] && kill -0 "$codex_pid" 2>/dev/null; then
      kill -s "$signal_name" "$codex_pid" 2>/dev/null || true
    fi
  }
  trap 'terminate_run HUP 129' HUP
  trap 'terminate_run INT 130' INT
  trap 'terminate_run TERM 143' TERM

  command_line+=(--output-last-message "$message_tmp" "$prompt")
  set +e
  timeout \
    --signal=TERM \
    --kill-after=30s \
    "$max_runtime" \
    "${command_line[@]}" >>"$run_log" 2>>"$diagnostics_log" &
  codex_pid=$!
  if [[ -n "$termination_status" ]]; then
    kill -TERM "$codex_pid" 2>/dev/null || true
  fi
  while :; do
    wait "$codex_pid"
    run_status=$?
    if ! kill -0 "$codex_pid" 2>/dev/null; then
      break
    fi
  done
  codex_pid=
  if [[ -n "$termination_status" ]]; then
    run_status=$termination_status
  fi
  set -e

  if [[ "$run_status" -eq 0 && ! -s "$message_tmp" ]]; then
    printf '%s\n' \
      "run: Codex returned success without a final message" \
      >>"$diagnostics_log"
    checkpoint_result=refused
    run_status=70
  fi

  if [[ "$run_status" -eq 0 ]]; then
    set +e
    event_audit=$(audit_event_log "$run_log" 2>>"$diagnostics_log")
    audit_status=$?
    set -e
    if [[ "$audit_status" -ne 0 ]]; then
      checkpoint_result=refused
      run_status=74
      printf 'run: Codex event audit refused; inspect diagnostics: %s\n' \
        "$diagnostics_log" >&2
    else
      event_counts=${event_audit#policy=wywa-v1 item_counts=}
    fi
  fi

  if [[ "$run_status" -eq 0 ]]; then
    set +e
    checkpoint_workspace \
      "$workspace" \
      "$run_stamp" \
      >>"$diagnostics_log" 2>&1
    checkpoint_status=$?
    set -e
    if [[ "$checkpoint_status" -ne 0 ]]; then
      run_status=$checkpoint_status
      printf 'run: checkpoint refused; inspect diagnostics: %s\n' \
        "$diagnostics_log" >&2
    fi
  fi

  exit "$run_status"
}

cmd_status() {
  require_single_workspace_arg "$@"
  local workspace runtime_dir
  workspace=$(canonical_workspace_path "$1")
  validate_workspace_path "$workspace"
  runtime_dir=$(runtime_dir_for "$workspace")

  printf 'workspace: %s\n' "$workspace"
  if [[ -f "$runtime_dir/last-run" && ! -L "$runtime_dir/last-run" ]]; then
    printf 'last run: '
    sed -n '1p' "$runtime_dir/last-run"
  else
    printf '%s\n' "last run: none"
  fi
  if [[ -f "$runtime_dir/last-message.txt" &&
        ! -L "$runtime_dir/last-message.txt" ]]; then
    printf '%s\n' "last message:"
    sed -n '1,120p' "$runtime_dir/last-message.txt"
  else
    printf '%s\n' "last message: none"
  fi
}

cmd_verify_receipt() {
  require_single_workspace_arg "$@"
  local workspace runtime_dir receipt line prefix log_path diagnostics_path=''
  local receipt_version='' status='' sandbox='' checkpoint=''
  local permissions='' local_network='' web_search=''
  local apps='' plugins='' hooks='' subagents='' project_config=''
  local approval='' persistence='' events='' event_counts=''
  local commit='' tree='' log_sha256='' diagnostics_sha256=''
  local message_sha256='' token event_audit='' actual_event_counts=''
  local actual_commit actual_tree actual_log_sha256 actual_diagnostics_sha256
  local actual_message_sha256
  workspace=$(canonical_workspace_path "$1")
  validate_workspace_path "$workspace"
  runtime_dir=$(runtime_dir_for "$workspace")
  receipt=$runtime_dir/last-run

  [[ -d "$runtime_dir" && ! -L "$runtime_dir" ]] ||
    die "private runtime directory is missing or unsafe"
  [[ -f "$receipt" && ! -L "$receipt" ]] ||
    die "last-run receipt is missing or unsafe"
  IFS= read -r line <"$receipt" ||
    die "last-run receipt is empty"
  [[ "$line" == *" log="* ]] ||
    die "last-run receipt omits its private log"
  prefix=${line% log=*}
  log_path=${line#* log=}
  for token in $prefix; do
    case "$token" in
      receipt=*) receipt_version=${token#receipt=} ;;
      status=*) status=${token#status=} ;;
      sandbox=*) sandbox=${token#sandbox=} ;;
      permissions=*) permissions=${token#permissions=} ;;
      local_network=*) local_network=${token#local_network=} ;;
      web_search=*) web_search=${token#web_search=} ;;
      apps=*) apps=${token#apps=} ;;
      plugins=*) plugins=${token#plugins=} ;;
      hooks=*) hooks=${token#hooks=} ;;
      subagents=*) subagents=${token#subagents=} ;;
      project_config=*) project_config=${token#project_config=} ;;
      approval=*) approval=${token#approval=} ;;
      persistence=*) persistence=${token#persistence=} ;;
      events=*) events=${token#events=} ;;
      event_counts=*) event_counts=${token#event_counts=} ;;
      checkpoint=*) checkpoint=${token#checkpoint=} ;;
      commit=*) commit=${token#commit=} ;;
      tree=*) tree=${token#tree=} ;;
      log_sha256=*) log_sha256=${token#log_sha256=} ;;
      diagnostics_sha256=*)
        diagnostics_sha256=${token#diagnostics_sha256=}
        ;;
      message_sha256=*) message_sha256=${token#message_sha256=} ;;
      diagnostics=*) diagnostics_path=${token#diagnostics=} ;;
    esac
  done

  [[ "$receipt_version" == 2 ||
     "$receipt_version" == 3 ||
     "$receipt_version" == 4 ||
     "$receipt_version" == 5 ||
     "$receipt_version" == 6 ]] ||
    die "last-run receipt is not a supported verifiable receipt"
  if [[ "$status" != 0 ]]; then
    printf 'verify-receipt: last run was not successful (status %s)\n' \
      "${status:-unknown}" >&2
    return 4
  fi
  if [[ "$receipt_version" == 2 ]]; then
    [[ "$sandbox" == workspace-write ]] ||
      die "legacy receipt records an unexpected sandbox"
  else
    [[ "$permissions" == "$permission_profile" ]] ||
      die "receipt records an unexpected permission profile"
  fi
  if [[ "$receipt_version" == 4 ]]; then
    [[ "$local_network" == disabled ]] ||
      die "receipt records an unexpected local network capability"
    [[ "$web_search" == live ]] ||
      die "receipt records an unexpected hosted web search capability"
  fi
  if [[ "$receipt_version" == 5 || "$receipt_version" == 6 ]]; then
    [[ "$local_network" == disabled ]] ||
      die "receipt records an unexpected local network capability"
    [[ "$web_search" == live ]] ||
      die "receipt records an unexpected hosted web search capability"
    [[ "$apps" == disabled ]] ||
      die "receipt records an unexpected app capability"
    [[ "$plugins" == disabled ]] ||
      die "receipt records an unexpected plugin capability"
    [[ "$hooks" == disabled ]] ||
      die "receipt records an unexpected hook capability"
    [[ "$subagents" == disabled ]] ||
      die "receipt records an unexpected subagent capability"
    [[ "$project_config" == absent ]] ||
      die "receipt records unexpected workspace-local Codex configuration"
    [[ "$approval" == never ]] ||
      die "receipt records an unexpected approval posture"
    [[ "$persistence" == ephemeral ]] ||
      die "receipt records unexpected Codex session persistence"
  fi
  if [[ "$receipt_version" == 6 ]]; then
    [[ "$events" == wywa-v1 ]] ||
      die "receipt records an unexpected event-audit policy"
    [[ "$event_counts" =~ ^agent_message:[0-9]+,reasoning:[0-9]+,command_execution:[0-9]+,file_change:[0-9]+,web_search:[0-9]+,todo_list:[0-9]+,plan:[0-9]+,image_view:[0-9]+,context_compaction:[0-9]+$ ]] ||
      die "receipt records malformed event counts"
    [[ "$diagnostics_sha256" =~ ^[0-9a-f]{64}$ ]] ||
      die "last-run receipt has an invalid diagnostics digest"
  fi
  [[ "$checkpoint" =~ ^[0-9a-f]{12}$ ]] ||
    die "last-run receipt has an invalid checkpoint abbreviation"
  [[ "$commit" =~ ^[0-9a-f]{40,64}$ ]] ||
    die "last-run receipt has an invalid commit object id"
  [[ "$tree" =~ ^[0-9a-f]{40,64}$ ]] ||
    die "last-run receipt has an invalid tree object id"
  [[ "$log_sha256" =~ ^[0-9a-f]{64}$ ]] ||
    die "last-run receipt has an invalid log digest"
  [[ "$message_sha256" =~ ^[0-9a-f]{64}$ ]] ||
    die "last-run receipt has an invalid message digest"
  [[ "$checkpoint" == "${commit:0:12}" ]] ||
    die "checkpoint abbreviation does not match the recorded commit"

  actual_commit=$(
    checkpoint_git "$workspace" rev-parse --verify "$commit^{commit}" 2>/dev/null
  ) || die "recorded checkpoint commit is unavailable"
  [[ "$actual_commit" == "$commit" ]] ||
    die "recorded checkpoint does not resolve to the exact commit"
  actual_tree=$(
    checkpoint_git "$workspace" rev-parse "$commit^{tree}" 2>/dev/null
  ) || die "recorded checkpoint tree is unavailable"
  [[ "$actual_tree" == "$tree" ]] ||
    die "recorded tree does not match the checkpoint commit"

  [[ "$log_path" == "$runtime_dir/logs/"* ]] ||
    die "recorded log is outside the private runtime"
  [[ -f "$log_path" && ! -L "$log_path" ]] ||
    die "recorded log is missing or unsafe"
  [[ -f "$runtime_dir/last-message.txt" &&
     ! -L "$runtime_dir/last-message.txt" ]] ||
    die "recorded final message is missing or unsafe"
  actual_log_sha256=$(sha256sum -- "$log_path" | cut -d ' ' -f 1)
  [[ "$actual_log_sha256" == "$log_sha256" ]] ||
    die "private log digest does not match the receipt"
  if [[ "$receipt_version" == 6 ]]; then
    [[ "$diagnostics_path" == "$runtime_dir/logs/"* ]] ||
      die "recorded diagnostics are outside the private runtime"
    [[ -f "$diagnostics_path" && ! -L "$diagnostics_path" ]] ||
      die "recorded diagnostics are missing or unsafe"
    actual_diagnostics_sha256=$(
      sha256sum -- "$diagnostics_path" | cut -d ' ' -f 1
    )
    [[ "$actual_diagnostics_sha256" == "$diagnostics_sha256" ]] ||
      die "private diagnostics digest does not match the receipt"
    event_audit=$(audit_event_log "$log_path") ||
      die "private event log no longer passes its recorded policy"
    actual_event_counts=${event_audit#policy=wywa-v1 item_counts=}
    [[ "$actual_event_counts" == "$event_counts" ]] ||
      die "private event counts do not match the receipt"
  fi
  actual_message_sha256=$(
    sha256sum -- "$runtime_dir/last-message.txt" | cut -d ' ' -f 1
  )
  [[ "$actual_message_sha256" == "$message_sha256" ]] ||
    die "final-message digest does not match the receipt"

  printf 'receipt: verified commit=%s tree=%s permissions=%s local_network=%s web_search=%s apps=%s plugins=%s hooks=%s subagents=%s project_config=%s approval=%s persistence=%s events=%s event_counts=%s\n' \
    "${commit:0:12}" "${tree:0:12}" \
    "${permissions:-legacy-workspace-write}" \
    "${local_network:-unrecorded}" \
    "${web_search:-unrecorded}" \
    "${apps:-unrecorded}" \
    "${plugins:-unrecorded}" \
    "${hooks:-unrecorded}" \
    "${subagents:-unrecorded}" \
    "${project_config:-unrecorded}" \
    "${approval:-unrecorded}" \
    "${persistence:-unrecorded}" \
    "${events:-unrecorded}" \
    "${event_counts:-unrecorded}"
}

cmd_run_state() {
  [[ $# -eq 1 ]] || die "run-state requires exactly one workspace id"
  local identifier=$1
  [[ "$identifier" =~ ^[0-9a-f]{16}$ ]] ||
    die "invalid workspace id"

  local runtime_dir workspace_file workspace
  runtime_dir=$(state_root)/$identifier
  [[ -d "$runtime_dir" && ! -L "$runtime_dir" ]] ||
    die "registered runtime directory is missing or unsafe"
  workspace_file=$runtime_dir/workspace.path
  [[ -f "$workspace_file" && ! -L "$workspace_file" ]] ||
    die "registered workspace path is missing or unsafe"
  workspace=$(<"$workspace_file")
  [[ "$(workspace_id "$workspace")" == "$identifier" ]] ||
    die "registered workspace path does not match its id"
  cmd_run "$workspace"
}

resolve_systemctl_bin() {
  local candidate
  if [[ -n "${WYWA_SYSTEMCTL_BIN:-}" ]]; then
    candidate=$WYWA_SYSTEMCTL_BIN
    [[ "$candidate" == /* ]] ||
      die "WYWA_SYSTEMCTL_BIN must be an absolute path"
  else
    candidate=$(command -v systemctl || true)
    [[ -n "$candidate" ]] || die "systemctl was not found on PATH"
    candidate=$(absolute_path "$candidate")
  fi
  [[ -f "$candidate" && -x "$candidate" ]] ||
    die "systemctl is not an executable regular file: $candidate"
  printf '%s\n' "$candidate"
}

resolve_loginctl_bin() {
  local candidate
  if [[ -n "${WYWA_LOGINCTL_BIN:-}" ]]; then
    candidate=$WYWA_LOGINCTL_BIN
    [[ "$candidate" == /* ]] ||
      die "WYWA_LOGINCTL_BIN must be an absolute path"
  else
    candidate=$(command -v loginctl || true)
    [[ -n "$candidate" ]] || die "loginctl was not found on PATH"
    candidate=$(absolute_path "$candidate")
  fi
  [[ -f "$candidate" && -x "$candidate" ]] ||
    die "loginctl is not an executable regular file: $candidate"
  printf '%s\n' "$candidate"
}

write_atomic_file() {
  local target=$1
  local mode=$2
  local content=$3
  local temporary
  temporary=$(mktemp "${target}.XXXXXX")
  printf '%s' "$content" >"$temporary"
  chmod "$mode" -- "$temporary"
  mv -f -- "$temporary" "$target"
}

cmd_install_user() {
  [[ $# -ge 1 ]] || die "install-user requires WORKSPACE"
  local workspace_arg=$1
  shift
  local dry_run=0
  local session_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --session-only)
        session_only=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown install-user option: $1"
        ;;
    esac
  done
  [[ -z "${WYWA_STATE_ROOT:-}" ]] ||
    die "install-user requires the default HOME-based runtime root"

  local workspace identifier systemctl_bin loginctl_bin linger user_config_dir unit_dir
  local install_root install_bin install_templates service_name timer_name
  local service_file timer_file service_content timer_content
  workspace=$(canonical_workspace_path "$workspace_arg")
  doctor_workspace "$workspace"
  identifier=$(workspace_id "$workspace")
  systemctl_bin=$(resolve_systemctl_bin)
  loginctl_bin=$(resolve_loginctl_bin)
  linger=$("$loginctl_bin" show-user "$(id -un)" -p Linger --value)
  if [[ "$linger" != yes && "$session_only" != 1 ]]; then
    die "user lingering is disabled; ask an administrator to enable it, or use --session-only"
  fi
  user_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
  unit_dir=$user_config_dir/systemd/user
  install_root=$HOME/.local/lib/wywa
  install_bin=$install_root/bin/wywa
  install_templates=$install_root/templates
  service_name=wywa-$identifier.service
  timer_name=wywa-$identifier.timer
  service_file=$unit_dir/$service_name
  timer_file=$unit_dir/$timer_name

  service_content="[Unit]
Description=While You Were Away worker $identifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/lib/wywa/bin/wywa run-state $identifier
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=yes
"
  timer_content="[Unit]
Description=Wake While You Were Away worker $identifier after recovery time

[Timer]
OnBootSec=5m
OnUnitInactiveSec=1h
AccuracySec=1m
RandomizedDelaySec=2m
Unit=$service_name

[Install]
WantedBy=timers.target
"

  if (( dry_run == 1 )); then
    printf 'service: %s\n' "$service_file"
    printf 'timer: %s\n' "$timer_file"
    printf 'worker id: %s\n' "$identifier"
    printf '%s\n' "cadence: one hour after the preceding service deactivates"
    if [[ "$linger" == yes ]]; then
      printf '%s\n' "after logout: enabled by user lingering"
    else
      printf '%s\n' "after logout: not guaranteed (--session-only)"
    fi
    printf '%s\n' "credentials in unit files: none"
    return 0
  fi

  umask 077
  mkdir -p -- "$install_root/bin" "$install_templates" "$unit_dir"
  if [[ "$(absolute_path "$0")" != "$install_bin" ]]; then
    install -m 0755 -- "$0" "$install_bin"
  fi
  if [[ "$project_dir" != "$install_root" ]]; then
    local template_name
    for template_name in \
      MANDATE.md \
      CONSTITUTION.md \
      AGENTS.md \
      WAKE.md \
      state-CURRENT.md \
      memory-INDEX.md \
      projects-README.md \
      workspace-README.md \
      gitignore \
      inbox-gitkeep
    do
      install -m 0644 -- \
        "$templates_dir/$template_name" \
        "$install_templates/$template_name"
    done
  fi
  write_atomic_file "$service_file" 0600 "$service_content"
  write_atomic_file "$timer_file" 0600 "$timer_content"

  "$systemctl_bin" --user daemon-reload
  "$systemctl_bin" --user enable --now "$timer_name"
  printf 'installed: %s\n' "$timer_name"
  printf '%s\n' "next wake: five minutes after boot, then one hour after completion"
}

cmd_uninstall_user() {
  require_single_workspace_arg "$@"
  [[ -z "${WYWA_STATE_ROOT:-}" ]] ||
    die "uninstall-user requires the default HOME-based runtime root"

  local workspace identifier systemctl_bin user_config_dir unit_dir
  local service_name timer_name service_file timer_file
  workspace=$(canonical_workspace_path "$1")
  validate_workspace_path "$workspace"
  check_root_boundary
  identifier=$(workspace_id "$workspace")
  systemctl_bin=$(resolve_systemctl_bin)
  user_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
  unit_dir=$user_config_dir/systemd/user
  service_name=wywa-$identifier.service
  timer_name=wywa-$identifier.timer
  service_file=$unit_dir/$service_name
  timer_file=$unit_dir/$timer_name

  if [[ -e "$service_file" || -e "$timer_file" ]]; then
    "$systemctl_bin" --user disable --now "$timer_name"
    rm -f -- "$service_file" "$timer_file"
    "$systemctl_bin" --user daemon-reload
    printf 'uninstalled: %s\n' "$timer_name"
  else
    printf 'uninstalled: %s was not installed\n' "$timer_name"
  fi
  printf '%s\n' "workspace and private runtime data were preserved"
}

main() {
  [[ $# -ge 1 ]] || {
    usage
    exit 2
  }
  local subcommand=$1
  shift
  case "$subcommand" in
    init)
      cmd_init "$@"
      ;;
    doctor)
      cmd_doctor "$@"
      ;;
    run)
      cmd_run "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    verify-receipt)
      cmd_verify_receipt "$@"
      ;;
    install-user)
      cmd_install_user "$@"
      ;;
    uninstall-user)
      cmd_uninstall_user "$@"
      ;;
    run-state)
      cmd_run_state "$@"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die "unknown command: $subcommand"
      ;;
  esac
}

main "$@"
