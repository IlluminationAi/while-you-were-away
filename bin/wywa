#!/usr/bin/env bash
set -euo pipefail

program=${0##*/}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
project_dir=$(cd -- "$script_dir/.." && pwd -P)
templates_dir=$project_dir/templates

usage() {
  cat <<EOF
Usage:
  $program init WORKSPACE
  $program doctor WORKSPACE
  $program run WORKSPACE [--max-runtime DURATION] [--dry-run]
  $program status WORKSPACE
  $program install-user WORKSPACE [--dry-run] [--session-only]
  $program uninstall-user WORKSPACE

Commands:
  init     Create a private, Git-backed persistent-worker workspace.
  doctor   Verify the workspace, non-root boundary, Codex, and login.
  run      Run one bounded, unattended cycle with workspace-write.
  status   Show the last cycle receipt and final message, when available.
  install-user
           Install and start a completion-relative systemd user timer.
  uninstall-user
           Stop and remove this workspace's timer without deleting its data.

Environment:
  WYWA_CODEX_BIN     Absolute Codex CLI path; defaults to the command on PATH.
  WYWA_STATE_ROOT    Private runtime root; defaults to
                     \$HOME/.local/state/wywa.
  WYWA_ALLOW_ROOT    Set to 1 only for an externally isolated, dedicated host.
  WYWA_SYSTEMCTL_BIN Absolute systemctl path, for isolated installer tests.
  WYWA_LOGINCTL_BIN  Absolute loginctl path, for isolated installer tests.
EOF
}

die() {
  printf '%s: %s\n' "$program" "$*" >&2
  exit 2
}

require_single_workspace_arg() {
  [[ $# -eq 1 ]] || die "this command requires exactly one WORKSPACE"
}

absolute_path() {
  realpath -m -- "$1"
}

validate_workspace_path() {
  local candidate=$1
  [[ "$candidate" == /* ]] || die "workspace path must resolve to an absolute path"
  [[ "$candidate" != / ]] || die "refusing to use the filesystem root as a workspace"
  [[ -d "$candidate" ]] || die "workspace does not exist: $candidate"
  [[ ! -L "$candidate" ]] || die "workspace must not be a symbolic link: $candidate"
}

state_root() {
  local raw_root root
  if [[ -n "${WYWA_STATE_ROOT:-}" ]]; then
    raw_root=$WYWA_STATE_ROOT
  else
    [[ -n "${HOME:-}" ]] || die "HOME is required when WYWA_STATE_ROOT is unset"
    raw_root=$HOME/.local/state/wywa
  fi
  [[ ! -L "$raw_root" ]] ||
    die "runtime root must not be a symbolic link: $raw_root"
  root=$(absolute_path "$raw_root")
  [[ "$root" != / ]] || die "refusing to use the filesystem root for runtime state"
  printf '%s\n' "$root"
}

workspace_id() {
  printf '%s' "$1" | sha256sum | cut -c1-16
}

runtime_dir_for() {
  local workspace=$1
  printf '%s/%s\n' "$(state_root)" "$(workspace_id "$workspace")"
}

resolve_codex_bin() {
  local candidate
  if [[ -n "${WYWA_CODEX_BIN:-}" ]]; then
    candidate=$WYWA_CODEX_BIN
    [[ "$candidate" == /* ]] || die "WYWA_CODEX_BIN must be an absolute path"
  else
    candidate=$(command -v codex || true)
    [[ -n "$candidate" ]] || die "Codex CLI was not found on PATH"
    candidate=$(absolute_path "$candidate")
  fi
  [[ -f "$candidate" && -x "$candidate" ]] ||
    die "Codex CLI is not an executable regular file: $candidate"
  printf '%s\n' "$candidate"
}

safe_environment() {
  local -n destination=$1
  [[ -n "${HOME:-}" ]] || die "HOME is required"
  destination=(
    /usr/bin/env
    -i
    "HOME=$HOME"
    "PATH=/usr/local/bin:/usr/bin:/bin"
    "LANG=${LANG:-C.UTF-8}"
    "LC_ALL=${LC_ALL:-}"
    "USER=${USER:-}"
    "LOGNAME=${LOGNAME:-}"
    "NO_COLOR=1"
  )
  if [[ -n "${CODEX_HOME:-}" ]]; then
    destination+=("CODEX_HOME=$CODEX_HOME")
  fi
}

check_root_boundary() {
  if (( EUID == 0 )) && [[ "${WYWA_ALLOW_ROOT:-0}" != 1 ]]; then
    die "refusing to run as root; use a non-root account"
  fi
  if (( EUID == 0 )); then
    printf '%s\n' "doctor: warning: explicit root override is active" >&2
  fi
}

check_required_workspace_files() {
  local workspace=$1
  local relative
  for relative in \
    MANDATE.md \
    CONSTITUTION.md \
    AGENTS.md \
    WAKE.md \
    state/CURRENT.md \
    memory/INDEX.md \
    projects/README.md
  do
    [[ -f "$workspace/$relative" && ! -L "$workspace/$relative" ]] ||
      die "required workspace file is missing or unsafe: $relative"
  done
  [[ -d "$workspace/.git" ]] || die "workspace is not a Git repository"
}

prepare_runtime_dir() {
  local workspace=$1
  local root runtime_dir
  root=$(state_root)
  if [[ -e "$root" && ( ! -d "$root" || -L "$root" ) ]]; then
    die "runtime root exists but is not a safe directory: $root"
  fi
  mkdir -p -- "$root"
  runtime_dir=$(runtime_dir_for "$workspace")
  if [[ -e "$runtime_dir" &&
        ( ! -d "$runtime_dir" || -L "$runtime_dir" ) ]]; then
    die "workspace runtime exists but is not a safe directory: $runtime_dir"
  fi
  mkdir -p -- "$runtime_dir"
  if [[ -e "$runtime_dir/logs" &&
        ( ! -d "$runtime_dir/logs" || -L "$runtime_dir/logs" ) ]]; then
    die "log path exists but is not a safe directory: $runtime_dir/logs"
  fi
  mkdir -p -- "$runtime_dir/logs"
  chmod 0700 -- "$root" "$runtime_dir" "$runtime_dir/logs"
  printf '%s\n' "$workspace" >"$runtime_dir/workspace.path"
  chmod 0600 -- "$runtime_dir/workspace.path"
  printf '%s\n' "$runtime_dir"
}

cmd_init() {
  require_single_workspace_arg "$@"
  local requested=$1
  local workspace
  workspace=$(absolute_path "$requested")

  [[ "$workspace" != / ]] || die "refusing to initialize the filesystem root"
  [[ ! -L "$requested" ]] || die "refusing to initialize a symbolic-link target"
  if [[ -e "$workspace" ]]; then
    [[ -d "$workspace" ]] || die "target exists and is not a directory"
    if find "$workspace" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
      die "target directory is not empty: $workspace"
    fi
  fi

  command -v git >/dev/null 2>&1 || die "git is required"
  [[ -d "$templates_dir" ]] || die "templates directory is unavailable"

  umask 077
  mkdir -p -- \
    "$workspace/state" \
    "$workspace/memory/daily" \
    "$workspace/projects" \
    "$workspace/inbox"

  cp -- "$templates_dir/MANDATE.md" "$workspace/MANDATE.md"
  cp -- "$templates_dir/CONSTITUTION.md" "$workspace/CONSTITUTION.md"
  cp -- "$templates_dir/AGENTS.md" "$workspace/AGENTS.md"
  cp -- "$templates_dir/WAKE.md" "$workspace/WAKE.md"
  cp -- "$templates_dir/state-CURRENT.md" "$workspace/state/CURRENT.md"
  cp -- "$templates_dir/memory-INDEX.md" "$workspace/memory/INDEX.md"
  cp -- "$templates_dir/projects-README.md" "$workspace/projects/README.md"
  cp -- "$templates_dir/workspace-README.md" "$workspace/README.md"
  cp -- "$templates_dir/gitignore" "$workspace/.gitignore"
  cp -- "$templates_dir/inbox-gitkeep" "$workspace/inbox/.gitkeep"

  git -C "$workspace" init -q -b main
  git -C "$workspace" config user.name "WYWA Worker"
  git -C "$workspace" config user.email "wywa@localhost"
  git -C "$workspace" add -- .
  git -C "$workspace" commit -q -m "Initialize persistent worker workspace"

  prepare_runtime_dir "$workspace" >/dev/null
  printf 'initialized: %s\n' "$workspace"
  printf '%s\n' "next: authenticate Codex, then run '$program doctor $workspace'"
}

doctor_workspace() {
  local workspace=$1
  local codex_bin
  local -a clean_env

  validate_workspace_path "$workspace"
  check_root_boundary
  check_required_workspace_files "$workspace"
  codex_bin=$(resolve_codex_bin)
  safe_environment clean_env

  git -C "$workspace" rev-parse --verify HEAD >/dev/null 2>&1 ||
    die "workspace has no initial Git commit"
  git -C "$workspace" fsck --no-dangling >/dev/null 2>&1 ||
    die "workspace Git repository failed integrity checks"
  "${clean_env[@]}" "$codex_bin" login status >/dev/null 2>&1 ||
    die "Codex CLI is not authenticated"

  prepare_runtime_dir "$workspace" >/dev/null
  if [[ -n "$(git -C "$workspace" status --porcelain)" ]]; then
    printf '%s\n' "doctor: note: workspace has uncommitted changes" >&2
  fi
  printf 'doctor: ok (%s)\n' "$workspace"
}

cmd_doctor() {
  require_single_workspace_arg "$@"
  local workspace
  workspace=$(absolute_path "$1")
  doctor_workspace "$workspace"
}

valid_duration() {
  [[ "$1" =~ ^[1-9][0-9]*[smhd]$ ]]
}

cmd_run() {
  [[ $# -ge 1 ]] || die "run requires WORKSPACE"
  local workspace_arg=$1
  shift
  local max_runtime=55m
  local dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --max-runtime)
        [[ $# -ge 2 ]] || die "--max-runtime requires a duration"
        max_runtime=$2
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown run option: $1"
        ;;
    esac
  done
  valid_duration "$max_runtime" ||
    die "duration must be a positive integer followed by s, m, h, or d"

  local workspace
  workspace=$(absolute_path "$workspace_arg")
  doctor_workspace "$workspace"

  local codex_bin runtime_dir logs_dir lock_file last_message
  local last_run prompt run_stamp run_log message_tmp receipt_tmp
  local codex_pid='' termination_status='' run_status=0
  local -a clean_env command_line
  codex_bin=$(resolve_codex_bin)
  runtime_dir=$(prepare_runtime_dir "$workspace")
  logs_dir=$runtime_dir/logs
  lock_file=$runtime_dir/cycle.lock
  last_message=$runtime_dir/last-message.txt
  last_run=$runtime_dir/last-run
  prompt=$(<"$workspace/WAKE.md")

  safe_environment clean_env
  command_line=(
    "${clean_env[@]}"
    "$codex_bin"
    --search
    exec
    --ignore-user-config
    --sandbox workspace-write
    --cd "$workspace"
    --color never
  )

  if (( dry_run == 1 )); then
    printf '%s\n' "run: ready"
    printf 'workspace: %s\n' "$workspace"
    printf 'runtime: %s\n' "$runtime_dir"
    printf 'sandbox: workspace-write\n'
    printf 'maximum runtime: %s\n' "$max_runtime"
    printf '%s\n' "environment: minimal allowlist; unrelated secrets excluded"
    return 0
  fi

  umask 077
  exec 9>"$lock_file"
  if ! flock -n 9; then
    printf '%s\n' "run: another cycle already holds the workspace lock" >&2
    return 75
  fi

  run_stamp=$(date -u +%Y%m%dT%H%M%SZ)
  run_log=$logs_dir/cycle-$run_stamp-$$.log
  message_tmp=$(mktemp "$runtime_dir/.last-message.XXXXXX")
  receipt_tmp=$(mktemp "$runtime_dir/.last-run.XXXXXX")

  # Invoked indirectly by the EXIT trap.
  # shellcheck disable=SC2329
  finalize_run() {
    local final_status=$?
    set +e
    if [[ "$final_status" -eq 0 && -s "$message_tmp" ]]; then
      mv -f -- "$message_tmp" "$last_message"
    else
      rm -f -- "$message_tmp"
    fi
    printf '%s status=%s sandbox=workspace-write log=%s\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "$final_status" \
      "$run_log" >"$receipt_tmp"
    mv -f -- "$receipt_tmp" "$last_run"
    find "$logs_dir" -type f -name 'cycle-*.log' -mtime +30 -delete
  }
  trap finalize_run EXIT

  # Invoked indirectly by the signal traps.
  # shellcheck disable=SC2329
  terminate_run() {
    local signal_name=$1
    local signal_status=$2
    if [[ -z "$termination_status" ]]; then
      termination_status=$signal_status
    fi
    if [[ -n "$codex_pid" ]] && kill -0 "$codex_pid" 2>/dev/null; then
      kill -s "$signal_name" "$codex_pid" 2>/dev/null || true
    fi
  }
  trap 'terminate_run HUP 129' HUP
  trap 'terminate_run INT 130' INT
  trap 'terminate_run TERM 143' TERM

  command_line+=(--output-last-message "$message_tmp" "$prompt")
  set +e
  timeout \
    --signal=TERM \
    --kill-after=30s \
    "$max_runtime" \
    "${command_line[@]}" >>"$run_log" 2>&1 &
  codex_pid=$!
  if [[ -n "$termination_status" ]]; then
    kill -TERM "$codex_pid" 2>/dev/null || true
  fi
  while :; do
    wait "$codex_pid"
    run_status=$?
    if ! kill -0 "$codex_pid" 2>/dev/null; then
      break
    fi
  done
  codex_pid=
  if [[ -n "$termination_status" ]]; then
    run_status=$termination_status
  fi
  set -e

  exit "$run_status"
}

cmd_status() {
  require_single_workspace_arg "$@"
  local workspace runtime_dir
  workspace=$(absolute_path "$1")
  validate_workspace_path "$workspace"
  runtime_dir=$(runtime_dir_for "$workspace")

  printf 'workspace: %s\n' "$workspace"
  if [[ -f "$runtime_dir/last-run" && ! -L "$runtime_dir/last-run" ]]; then
    printf 'last run: '
    sed -n '1p' "$runtime_dir/last-run"
  else
    printf '%s\n' "last run: none"
  fi
  if [[ -f "$runtime_dir/last-message.txt" &&
        ! -L "$runtime_dir/last-message.txt" ]]; then
    printf '%s\n' "last message:"
    sed -n '1,120p' "$runtime_dir/last-message.txt"
  else
    printf '%s\n' "last message: none"
  fi
}

cmd_run_state() {
  [[ $# -eq 1 ]] || die "run-state requires exactly one workspace id"
  local identifier=$1
  [[ "$identifier" =~ ^[0-9a-f]{16}$ ]] ||
    die "invalid workspace id"

  local runtime_dir workspace_file workspace
  runtime_dir=$(state_root)/$identifier
  [[ -d "$runtime_dir" && ! -L "$runtime_dir" ]] ||
    die "registered runtime directory is missing or unsafe"
  workspace_file=$runtime_dir/workspace.path
  [[ -f "$workspace_file" && ! -L "$workspace_file" ]] ||
    die "registered workspace path is missing or unsafe"
  workspace=$(<"$workspace_file")
  [[ "$(workspace_id "$workspace")" == "$identifier" ]] ||
    die "registered workspace path does not match its id"
  cmd_run "$workspace"
}

resolve_systemctl_bin() {
  local candidate
  if [[ -n "${WYWA_SYSTEMCTL_BIN:-}" ]]; then
    candidate=$WYWA_SYSTEMCTL_BIN
    [[ "$candidate" == /* ]] ||
      die "WYWA_SYSTEMCTL_BIN must be an absolute path"
  else
    candidate=$(command -v systemctl || true)
    [[ -n "$candidate" ]] || die "systemctl was not found on PATH"
    candidate=$(absolute_path "$candidate")
  fi
  [[ -f "$candidate" && -x "$candidate" ]] ||
    die "systemctl is not an executable regular file: $candidate"
  printf '%s\n' "$candidate"
}

resolve_loginctl_bin() {
  local candidate
  if [[ -n "${WYWA_LOGINCTL_BIN:-}" ]]; then
    candidate=$WYWA_LOGINCTL_BIN
    [[ "$candidate" == /* ]] ||
      die "WYWA_LOGINCTL_BIN must be an absolute path"
  else
    candidate=$(command -v loginctl || true)
    [[ -n "$candidate" ]] || die "loginctl was not found on PATH"
    candidate=$(absolute_path "$candidate")
  fi
  [[ -f "$candidate" && -x "$candidate" ]] ||
    die "loginctl is not an executable regular file: $candidate"
  printf '%s\n' "$candidate"
}

write_atomic_file() {
  local target=$1
  local mode=$2
  local content=$3
  local temporary
  temporary=$(mktemp "${target}.XXXXXX")
  printf '%s' "$content" >"$temporary"
  chmod "$mode" -- "$temporary"
  mv -f -- "$temporary" "$target"
}

cmd_install_user() {
  [[ $# -ge 1 ]] || die "install-user requires WORKSPACE"
  local workspace_arg=$1
  shift
  local dry_run=0
  local session_only=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --session-only)
        session_only=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        die "unknown install-user option: $1"
        ;;
    esac
  done
  [[ -z "${WYWA_STATE_ROOT:-}" ]] ||
    die "install-user requires the default HOME-based runtime root"

  local workspace identifier systemctl_bin loginctl_bin linger user_config_dir unit_dir
  local install_root install_bin install_templates service_name timer_name
  local service_file timer_file service_content timer_content
  workspace=$(absolute_path "$workspace_arg")
  doctor_workspace "$workspace"
  identifier=$(workspace_id "$workspace")
  systemctl_bin=$(resolve_systemctl_bin)
  loginctl_bin=$(resolve_loginctl_bin)
  linger=$("$loginctl_bin" show-user "$(id -un)" -p Linger --value)
  if [[ "$linger" != yes && "$session_only" != 1 ]]; then
    die "user lingering is disabled; ask an administrator to enable it, or use --session-only"
  fi
  user_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
  unit_dir=$user_config_dir/systemd/user
  install_root=$HOME/.local/lib/wywa
  install_bin=$install_root/bin/wywa
  install_templates=$install_root/templates
  service_name=wywa-$identifier.service
  timer_name=wywa-$identifier.timer
  service_file=$unit_dir/$service_name
  timer_file=$unit_dir/$timer_name

  service_content="[Unit]
Description=While You Were Away worker $identifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/lib/wywa/bin/wywa run-state $identifier
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=infinity
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
"
  timer_content="[Unit]
Description=Wake While You Were Away worker $identifier after recovery time

[Timer]
OnBootSec=5m
OnUnitInactiveSec=1h
AccuracySec=1m
RandomizedDelaySec=2m
Unit=$service_name

[Install]
WantedBy=timers.target
"

  if (( dry_run == 1 )); then
    printf 'service: %s\n' "$service_file"
    printf 'timer: %s\n' "$timer_file"
    printf 'worker id: %s\n' "$identifier"
    printf '%s\n' "cadence: one hour after the preceding service deactivates"
    if [[ "$linger" == yes ]]; then
      printf '%s\n' "after logout: enabled by user lingering"
    else
      printf '%s\n' "after logout: not guaranteed (--session-only)"
    fi
    printf '%s\n' "credentials in unit files: none"
    return 0
  fi

  umask 077
  mkdir -p -- "$install_root/bin" "$install_templates" "$unit_dir"
  if [[ "$(absolute_path "$0")" != "$install_bin" ]]; then
    install -m 0755 -- "$0" "$install_bin"
  fi
  if [[ "$project_dir" != "$install_root" ]]; then
    local template_name
    for template_name in \
      MANDATE.md \
      CONSTITUTION.md \
      AGENTS.md \
      WAKE.md \
      state-CURRENT.md \
      memory-INDEX.md \
      projects-README.md \
      workspace-README.md \
      gitignore \
      inbox-gitkeep
    do
      install -m 0644 -- \
        "$templates_dir/$template_name" \
        "$install_templates/$template_name"
    done
  fi
  write_atomic_file "$service_file" 0600 "$service_content"
  write_atomic_file "$timer_file" 0600 "$timer_content"

  "$systemctl_bin" --user daemon-reload
  "$systemctl_bin" --user enable --now "$timer_name"
  printf 'installed: %s\n' "$timer_name"
  printf '%s\n' "next wake: five minutes after boot, then one hour after completion"
}

cmd_uninstall_user() {
  require_single_workspace_arg "$@"
  [[ -z "${WYWA_STATE_ROOT:-}" ]] ||
    die "uninstall-user requires the default HOME-based runtime root"

  local workspace identifier systemctl_bin user_config_dir unit_dir
  local service_name timer_name service_file timer_file
  workspace=$(absolute_path "$1")
  validate_workspace_path "$workspace"
  check_root_boundary
  identifier=$(workspace_id "$workspace")
  systemctl_bin=$(resolve_systemctl_bin)
  user_config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
  unit_dir=$user_config_dir/systemd/user
  service_name=wywa-$identifier.service
  timer_name=wywa-$identifier.timer
  service_file=$unit_dir/$service_name
  timer_file=$unit_dir/$timer_name

  if [[ -e "$service_file" || -e "$timer_file" ]]; then
    "$systemctl_bin" --user disable --now "$timer_name"
    rm -f -- "$service_file" "$timer_file"
    "$systemctl_bin" --user daemon-reload
    printf 'uninstalled: %s\n' "$timer_name"
  else
    printf 'uninstalled: %s was not installed\n' "$timer_name"
  fi
  printf '%s\n' "workspace and private runtime data were preserved"
}

main() {
  [[ $# -ge 1 ]] || {
    usage
    exit 2
  }
  local subcommand=$1
  shift
  case "$subcommand" in
    init)
      cmd_init "$@"
      ;;
    doctor)
      cmd_doctor "$@"
      ;;
    run)
      cmd_run "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    install-user)
      cmd_install_user "$@"
      ;;
    uninstall-user)
      cmd_uninstall_user "$@"
      ;;
    run-state)
      cmd_run_state "$@"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die "unknown command: $subcommand"
      ;;
  esac
}

main "$@"
